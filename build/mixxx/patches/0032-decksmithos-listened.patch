new file mode 100644
index 00000000..176ea427
--- /dev/null
+++ b/src/mixer/listentracker.cpp
@@ -0,0 +1,94 @@
+#include "mixer/listentracker.h"
+
+#include <QElapsedTimer>
+#include <algorithm>
+
+#include "control/controlobject.h"
+#include "control/controlproxy.h"
+#include "mixer/basetrackplayer.h"
+#include "mixer/playermanager.h"
+#include "moc_listentracker.cpp"
+#include "track/track.h"
+
+namespace {
+constexpr int kPollMillis = 250;
+/// Progress faster than this (times real time) is a jump, not listening
+constexpr double kMaxSpeed = 2.0;
+} // namespace
+
+struct ListenTracker::Deck {
+    QString group;
+    std::unique_ptr<ControlObject> pListened;
+    std::unique_ptr<ControlProxy> pPlay;
+    std::unique_ptr<ControlProxy> pPosition;
+    std::unique_ptr<ControlProxy> pDuration;
+    double lastPosition = -1;
+    QElapsedTimer clock;
+};
+
+ListenTracker::ListenTracker(QObject* pParent, PlayerManager* pPlayerManager)
+        : QObject(pParent),
+          m_pPlayerManager(pPlayerManager),
+          m_pNumDecks(std::make_unique<ControlProxy>(
+                  QStringLiteral("[App]"), QStringLiteral("num_decks"), this)) {
+    m_pNumDecks->connectValueChanged(this, &ListenTracker::slotNumberOfDecksChanged);
+    slotNumberOfDecksChanged(m_pNumDecks->get());
+    m_timer.setInterval(kPollMillis);
+    connect(&m_timer, &QTimer::timeout, this, &ListenTracker::slotPoll);
+    m_timer.start();
+}
+
+ListenTracker::~ListenTracker() = default;
+
+// static
+double ListenTracker::listened(const QString& group) {
+    const ConfigKey key(group, QStringLiteral("listened"));
+    return ControlObject::exists(key) ? ControlObject::get(key) : 0.0;
+}
+
+void ListenTracker::slotNumberOfDecksChanged(double decks) {
+    for (int i = static_cast<int>(m_decks.size()); i < static_cast<int>(decks); ++i) {
+        auto pDeck = std::make_unique<Deck>();
+        pDeck->group = PlayerManager::groupForDeck(i);
+        pDeck->pListened = std::make_unique<ControlObject>(
+                ConfigKey(pDeck->group, QStringLiteral("listened")));
+        pDeck->pListened->setReadOnly();
+        pDeck->pPlay = std::make_unique<ControlProxy>(pDeck->group, QStringLiteral("play"), this);
+        pDeck->pPosition = std::make_unique<ControlProxy>(
+                pDeck->group, QStringLiteral("playposition"), this);
+        pDeck->pDuration = std::make_unique<ControlProxy>(
+                pDeck->group, QStringLiteral("duration"), this);
+        BaseTrackPlayer* pPlayer = m_pPlayerManager->getDeckBase(i);
+        if (pPlayer) {
+            Deck* pRaw = pDeck.get();
+            connect(pPlayer,
+                    &BaseTrackPlayer::newTrackLoaded,
+                    this,
+                    [pRaw](TrackPointer) {
+                        pRaw->pListened->forceSet(0.0);
+                        pRaw->lastPosition = -1;
+                    });
+        }
+        m_decks.push_back(std::move(pDeck));
+    }
+}
+
+void ListenTracker::slotPoll() {
+    for (const auto& pDeck : m_decks) {
+        const double position = pDeck->pPosition->get();
+        const double duration = pDeck->pDuration->get();
+        const qint64 elapsedMillis = pDeck->clock.isValid() ? pDeck->clock.restart() : 0;
+        if (!pDeck->clock.isValid()) {
+            pDeck->clock.start();
+        }
+        if (pDeck->pPlay->toBool() && duration > 0 && pDeck->lastPosition >= 0 &&
+                elapsedMillis > 0) {
+            const double progressSeconds = (position - pDeck->lastPosition) * duration;
+            if (progressSeconds > 0 && progressSeconds < kMaxSpeed * elapsedMillis / 1000.0) {
+                pDeck->pListened->forceSet(
+                        std::min(1.0, pDeck->pListened->get() + progressSeconds / duration));
+            }
+        }
+        pDeck->lastPosition = position;
+    }
+}
