+namespace {
+const ConfigKey kHistoryMinListenedKey(
+        QStringLiteral("[Library]"), QStringLiteral("HistoryMinListenedPercent"));
+constexpr int kHistoryMinListenedDefault = 10;
+} // namespace
+
+// DecksmithOS: a track counts as played (history, play count) only once
+// [Library] HistoryMinListenedPercent of it has been listened to
+// ([ChannelN],listened, ListenTracker); 0: at once, as before
 void SetlogFeature::slotPlayingTrackChanged(TrackPointer currentPlayingTrack) {
     if (!currentPlayingTrack) {
         return;
     }
+    const int minPercent = m_pConfig->getValue(kHistoryMinListenedKey, kHistoryMinListenedDefault);
+    if (minPercent <= 0) {
+        markPlayed(currentPlayingTrack);
+        return;
+    }
+    for (const auto& pPending : std::as_const(m_pendingPlayed)) {
+        if (pPending.lock() == currentPlayingTrack) {
+            return;
+        }
+    }
+    m_pendingPlayed.append(currentPlayingTrack);
+    if (!m_pendingTimer.isActive()) {
+        m_pendingTimer.start(1000);
+    }
+    slotCheckPendingPlayed();
+}
+
+void SetlogFeature::slotCheckPendingPlayed() {
+    const double minShare =
+            m_pConfig->getValue(kHistoryMinListenedKey, kHistoryMinListenedDefault) / 100.0;
+    const int decks = static_cast<int>(
+            ControlObject::get(ConfigKey(QStringLiteral("[App]"), QStringLiteral("num_decks"))));
+    QList<TrackPointer> played;
+    for (auto it = m_pendingPlayed.begin(); it != m_pendingPlayed.end();) {
+        const TrackPointer pTrack = it->lock();
+        QString group;
+        for (int i = 0; pTrack && i < decks; ++i) {
+            const QString deck = PlayerManager::groupForDeck(i);
+            if (PlayerInfo::instance().getTrackInfo(deck) == pTrack) {
+                group = deck;
+                break;
+            }
+        }
+        if (group.isEmpty()) {
+            // unloaded before enough of it was heard: not played
+            it = m_pendingPlayed.erase(it);
+            continue;
+        }
+        if (ListenTracker::listened(group) >= minShare) {
+            played.append(pTrack);
+            it = m_pendingPlayed.erase(it);
+            continue;
+        }
+        ++it;
+    }
+    if (m_pendingPlayed.isEmpty()) {
+        m_pendingTimer.stop();
+    }
+    for (const TrackPointer& pTrack : std::as_const(played)) {
+        markPlayed(pTrack);
+    }
+}
