+void AutoDJProcessor::maybeRequeue(DeckAttributes* pDeck, const TrackPointer& pOldTrack) {
+    if (!pOldTrack || !pOldTrack->getId().isValid() ||
+            m_queueTracks.value(pDeck->group) != pOldTrack->getId()) {
+        return; // not from the queue (or Auto DJ itself loads the next one)
+    }
+    m_queueTracks.remove(pDeck->group);
+    const int percent = m_pConfig->getValue(
+            ConfigKey(kPreferenceGroup, QStringLiteral("RequeuePercent")), 5);
+    const double listened = ControlObject::get(ConfigKey(pDeck->group, QStringLiteral("listened")));
+    if (percent <= 0 || listened * 100 >= percent) {
+        return;
+    }
+    // Back to the top of the queue; below a track that waits in a deck
+    m_pAutoDJTableModel->select();
+    int row = 0;
+    if (m_pAutoDJTableModel->rowCount() > 0) {
+        const TrackId first = m_pAutoDJTableModel->getTrackId(m_pAutoDJTableModel->index(0, 0));
+        if (first == pOldTrack->getId()) {
+            return; // still queued
+        }
+        for (const auto& pOther : m_decks) {
+            if (pOther.get() != pDeck && pOther->getLoadedTrack() &&
+                    pOther->getLoadedTrack()->getId() == first) {
+                row = 1;
+                break;
+            }
+        }
+    }
+    const QModelIndex before = row < m_pAutoDJTableModel->rowCount()
+            ? m_pAutoDJTableModel->index(row, 0)
+            : QModelIndex();
+    m_pAutoDJTableModel->addTracksWithTrackIds(before, {pOldTrack->getId()}, nullptr);
+    m_pAutoDJTableModel->select();
+    qInfo() << "Auto DJ:" << pOldTrack->getLocation() << "was replaced after"
+            << qRound(listened * 100) << "%: back to the queue";
+}
