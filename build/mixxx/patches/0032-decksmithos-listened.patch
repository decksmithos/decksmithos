+#pragma once
+
+#include <QObject>
+#include <QTimer>
+#include <memory>
+#include <vector>
+
+class ControlObject;
+class ControlProxy;
+class PlayerManager;
+
+/// DecksmithOS: how much of the track loaded in each deck has been listened
+/// to, as [ChannelN],listened (read only, 0..1 of the track's duration):
+/// the play position's progress while the deck plays, at normal speed
+/// (jumps and seeks are not counted). Reset when a track is loaded. Used for
+/// the history (a track counts as played from a share of it) and by Auto DJ
+/// (a track replaced before a share of it was heard goes back to the queue).
+class ListenTracker : public QObject {
+    Q_OBJECT
+  public:
+    ListenTracker(QObject* pParent, PlayerManager* pPlayerManager);
+    ~ListenTracker() override;
+
+    /// [ChannelN],listened of a deck group, 0 if none
+    static double listened(const QString& group);
+
+  private slots:
+    void slotPoll();
+    void slotNumberOfDecksChanged(double decks);
+
+  private:
+    struct Deck;
+    PlayerManager* const m_pPlayerManager;
+    std::vector<std::unique_ptr<Deck>> m_decks;
+    std::unique_ptr<ControlProxy> m_pNumDecks;
+    QTimer m_timer;
+};
