+namespace {
+using mixxx::autodj::harmonicKeyDistance;
+using mixxx::autodj::HarmonicTrack;
+namespace key = mixxx::track::io::key;
+} // namespace
+
+TEST(AutoDJHarmonicOrderTest, KeyDistance) {
+    // 8B = C major, 8A = A minor, 9B = G major, 7B = F major, 9A = E minor
+    EXPECT_EQ(0, harmonicKeyDistance(key::C_MAJOR, key::C_MAJOR));
+    EXPECT_EQ(1, harmonicKeyDistance(key::C_MAJOR, key::A_MINOR));
+    EXPECT_EQ(1, harmonicKeyDistance(key::C_MAJOR, key::G_MAJOR));
+    // across the wrap of the wheel: 8B (C major) and 7B (F major) are 1d and 12d
+    EXPECT_EQ(1, harmonicKeyDistance(key::C_MAJOR, key::F_MAJOR));
+    EXPECT_EQ(2, harmonicKeyDistance(key::C_MAJOR, key::E_MINOR));
+    EXPECT_EQ(1, harmonicKeyDistance(key::E_MAJOR, key::B_MAJOR));
+    EXPECT_EQ(6, harmonicKeyDistance(key::C_MAJOR, key::F_SHARP_MAJOR));
+    EXPECT_EQ(2, harmonicKeyDistance(key::C_MAJOR, key::INVALID));
+}
+
+TEST(AutoDJHarmonicOrderTest, BpmChangeUsesHalfAndDoubleTempo) {
+    EXPECT_NEAR(0.0, *mixxx::autodj::harmonicBpmChangePercent(70.0, 140.0), 1e-9);
+    EXPECT_NEAR(2.0, *mixxx::autodj::harmonicBpmChangePercent(125.0, 127.5), 1e-9);
+    EXPECT_NEAR(-50.0 / 3.0, *mixxx::autodj::harmonicBpmChangePercent(120.0, 100.0), 1e-9);
+    EXPECT_FALSE(mixxx::autodj::harmonicBpmChangePercent(0.0, 120.0));
+}
+
+TEST(AutoDJHarmonicOrderTest, OrdersByKeyAndTempo) {
+    const QList<HarmonicTrack> tracks = {
+            {128.0, key::F_SHARP_MAJOR}, // 0: far key
+            {124.0, key::A_MINOR},       // 1
+            {120.0, key::C_MAJOR},       // 2: slowest, first
+            {126.0, key::E_MINOR},       // 3
+            {124.0, key::G_MAJOR},       // 4
+    };
+    // 8B 120 -> 8A 124 (relative minor) -> 9A 126 (neighbour) -> 9B 124
+    // (relative major) -> the far key last.
+    EXPECT_EQ(QList<int>({2, 1, 3, 4, 0}), mixxx::autodj::harmonicOrder(tracks));
+    // Continue from a playing G major track at 124 BPM.
+    EXPECT_EQ(QList<int>({4, 3, 1, 2, 0}),
+            mixxx::autodj::harmonicOrder(tracks, HarmonicTrack{124.0, key::G_MAJOR}));
+    EXPECT_TRUE(mixxx::autodj::harmonicOrder({}).isEmpty());
+}
+
+TEST_F(AutoDJProcessorTest, SortHarmonic) {
+    PlaylistTableModel* pAutoDJTableModel = pProcessor->getTableModel();
+    const QList<std::pair<QString, std::pair<double, key::ChromaticKey>>> files = {
+            {"id3-test-data/cover-test-jpg.mp3", {128.0, key::F_SHARP_MAJOR}},
+            {"id3-test-data/cover-test-png.mp3", {124.0, key::A_MINOR}},
+            {"id3-test-data/cover-test-vbr.mp3", {120.0, key::C_MAJOR}},
+    };
+    QList<TrackPointer> tracks;
+    for (const auto& [location, bpmKey] : files) {
+        TrackPointer pTrack = getOrAddTrackByLocation(getTestDir().filePath(location));
+        ASSERT_TRUE(pTrack);
+        pTrack->trySetBpm(bpmKey.first);
+        pTrack->setKey(bpmKey.second, mixxx::track::io::key::USER);
+        tracks.append(pTrack);
+        pAutoDJTableModel->appendTrack(pTrack->getId());
+    }
+
+    // Auto DJ is disabled and no deck plays: the whole queue, slowest first.
+    EXPECT_EQ(AutoDJProcessor::ADJ_OK, pProcessor->sortPlaylistHarmonic({}));
+    pAutoDJTableModel->select();
+    ASSERT_EQ(3, pAutoDJTableModel->rowCount());
+    EXPECT_EQ(tracks[2]->getId(), pAutoDJTableModel->getTrackId(pAutoDJTableModel->index(0, 0)));
+    EXPECT_EQ(tracks[1]->getId(), pAutoDJTableModel->getTrackId(pAutoDJTableModel->index(1, 0)));
+    EXPECT_EQ(tracks[0]->getId(), pAutoDJTableModel->getTrackId(pAutoDJTableModel->index(2, 0)));
+}
