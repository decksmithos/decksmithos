+AutoDJProcessor::AutoDJError AutoDJProcessor::sortPlaylistHarmonic(
+        const QModelIndexList& selectedIndices) {
+    const auto harmonicTrack = [](const TrackPointer& pTrack) {
+        mixxx::autodj::HarmonicTrack track;
+        if (pTrack) {
+            track.bpm = pTrack->getBpm();
+            track.key = pTrack->getKey();
+        }
+        return track;
+    };
+
+    // Rows to order: the selection if more than one row is selected (like
+    // Shuffle), otherwise the whole queue.
+    QModelIndexList rows;
+    if (selectedIndices.size() > 1) {
+        for (const auto& index : selectedIndices) {
+            rows.append(index.siblingAtColumn(0));
+        }
+        std::sort(rows.begin(), rows.end(), [](const QModelIndex& a, const QModelIndex& b) {
+            return a.row() < b.row();
+        });
+    } else {
+        for (int row = 0; row < m_pAutoDJTableModel->rowCount(); ++row) {
+            rows.append(m_pAutoDJTableModel->index(row, 0));
+        }
+    }
+
+    // A running Auto DJ has the first queued track cued already: keep it in
+    // place and continue from it. Otherwise continue from the track playing,
+    // if any.
+    std::optional<mixxx::autodj::HarmonicTrack> previous;
+    if (m_eState != ADJ_DISABLED) {
+        const QModelIndex first = m_pAutoDJTableModel->index(0, 0);
+        rows.erase(std::remove_if(rows.begin(),
+                           rows.end(),
+                           [&first](const QModelIndex& index) {
+                               return index.row() == first.row();
+                           }),
+                rows.end());
+        previous = harmonicTrack(m_pAutoDJTableModel->getTrack(first));
+    } else {
+        for (const auto& pDeck : m_decks) {
+            if (pDeck->isPlaying()) {
+                previous = harmonicTrack(pDeck->getLoadedTrack());
+                break;
+            }
+        }
+    }
+    if (rows.size() < 2) {
+        return ADJ_OK;
+    }
+
+    QList<mixxx::autodj::HarmonicTrack> tracks;
+    tracks.reserve(rows.size());
+    for (const auto& index : std::as_const(rows)) {
+        tracks.append(harmonicTrack(m_pAutoDJTableModel->getTrack(index)));
+    }
+    m_pAutoDJTableModel->reorderTracks(rows, mixxx::autodj::harmonicOrder(tracks, previous));
+    return ADJ_OK;
+}
