+void PlaylistDAO::reorderTracks(const int playlistId, const QList<int>& oldPositions) {
+    QList<int> newPositions = oldPositions;
+    std::sort(newPositions.begin(), newPositions.end());
+    VERIFY_OR_DEBUG_ASSERT(std::adjacent_find(newPositions.cbegin(), newPositions.cend()) ==
+            newPositions.cend()) {
+        return;
+    }
+    ScopedTransaction transaction(m_database);
+    QSqlQuery query(m_database);
+    // Positions are >= 1: park every moved track at minus its new position,
+    // then flip the signs, so that no two rows share a position meanwhile.
+    query.prepare(QStringLiteral(
+            "UPDATE PlaylistTracks SET position=:new_position "
+            "WHERE position=:old_position AND playlist_id=:id"));
+    query.bindValue(":id", playlistId);
+    for (int i = 0; i < oldPositions.size(); ++i) {
+        query.bindValue(":new_position", -newPositions.at(i));
+        query.bindValue(":old_position", oldPositions.at(i));
+        if (!query.exec()) {
+            LOG_FAILED_QUERY(query);
+            return;
+        }
+    }
+    query.prepare(QStringLiteral(
+            "UPDATE PlaylistTracks SET position=-position "
+            "WHERE position<0 AND playlist_id=:id"));
+    query.bindValue(":id", playlistId);
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    transaction.commit();
+    emit tracksMoved(QSet<int>{playlistId});
+}
