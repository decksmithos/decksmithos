+void PlaylistTableModel::reorderTracks(const QModelIndexList& rows, const QList<int>& order) {
+    VERIFY_OR_DEBUG_ASSERT(rows.size() == order.size()) {
+        return;
+    }
+    const int positionColumn = fieldIndex(ColumnCache::COLUMN_PLAYLISTTRACKSTABLE_POSITION);
+    QList<int> oldPositions;
+    oldPositions.reserve(order.size());
+    for (int i : order) {
+        oldPositions.append(rows.at(i).siblingAtColumn(positionColumn).data().toInt());
+    }
+    m_pTrackCollectionManager->internalCollection()->getPlaylistDAO().reorderTracks(
+            m_iPlaylistId, oldPositions);
+}
