diff --git a/src/library/autodj/harmonicorder.h b/src/library/autodj/harmonicorder.h
new file mode 100644
index 0000000..eaf9e94
--- /dev/null
+++ b/src/library/autodj/harmonicorder.h
@@ -0,0 +1,123 @@
+#pragma once
+
+#include <QList>
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+#include "proto/keys.pb.h"
+#include "track/keyutils.h"
+
+namespace mixxx {
+namespace autodj {
+
+/// Key and tempo of one Auto DJ queue entry, as the analyzer stored them.
+struct HarmonicTrack {
+    /// 0 if not analyzed
+    double bpm = 0.0;
+    track::io::key::ChromaticKey key = track::io::key::INVALID;
+};
+
+/// Distance of two keys on the Camelot / Open Key wheel: 0 same key,
+/// 1 a neighbour (+-1 step, or the relative major/minor), 2 a diagonal or
+/// two steps, and so on. 2 when either key is unknown.
+inline int harmonicKeyDistance(track::io::key::ChromaticKey a,
+        track::io::key::ChromaticKey b) {
+    if (a == track::io::key::INVALID || b == track::io::key::INVALID) {
+        return 2;
+    }
+    const int na = KeyUtils::keyToOpenKeyNumber(a);
+    const int nb = KeyUtils::keyToOpenKeyNumber(b);
+    const int steps = std::abs(na - nb);
+    return std::min(steps, 12 - steps) +
+            (KeyUtils::keyIsMajor(a) != KeyUtils::keyIsMajor(b) ? 1 : 0);
+}
+
+/// Tempo change in percent from `from` to `to`, after taking the closest of
+/// half, same and double tempo (a 70 BPM track mixes into a 140 BPM one).
+/// Positive when the tempo goes up. std::nullopt if a tempo is unknown.
+inline std::optional<double> harmonicBpmChangePercent(double from, double to) {
+    if (!(from > 0.0) || !(to > 0.0)) {
+        return std::nullopt;
+    }
+    double best = to / from;
+    for (double factor : {0.5, 2.0}) {
+        const double ratio = to * factor / from;
+        if (std::abs(std::log(ratio)) < std::abs(std::log(best))) {
+            best = ratio;
+        }
+    }
+    return (best - 1.0) * 100.0;
+}
+
+/// Cost of playing `to` after `from`: key distance first, then the tempo
+/// change. A tempo change beyond the usual +-8 % pitch range costs extra, and
+/// going down in tempo costs a little more than going up, so that the set
+/// builds up instead of jumping back and forth.
+inline double harmonicTransitionCost(const HarmonicTrack& from, const HarmonicTrack& to) {
+    double cost = 2.0 * harmonicKeyDistance(from.key, to.key);
+    const auto change = harmonicBpmChangePercent(from.bpm, to.bpm);
+    if (!change) {
+        return cost + 4.0;
+    }
+    const double magnitude = std::abs(*change);
+    cost += 0.5 * magnitude;
+    if (*change < 0.0) {
+        cost += 0.25 * magnitude;
+    }
+    if (magnitude > 8.0) {
+        cost += 5.0;
+    }
+    return cost;
+}
+
+/// The order in which to play `tracks` (indices into it). Starts after
+/// `previous` (the track playing or cued before them) or, without it, with the
+/// slowest track, then always takes the cheapest next track
+/// (harmonicTransitionCost); ties keep the queue order. Tracks keep their own
+/// key: nothing is pitch shifted.
+inline QList<int> harmonicOrder(const QList<HarmonicTrack>& tracks,
+        const std::optional<HarmonicTrack>& previous = std::nullopt) {
+    QList<int> order;
+    if (tracks.isEmpty()) {
+        return order;
+    }
+    QList<int> remaining;
+    for (int i = 0; i < tracks.size(); ++i) {
+        remaining.append(i);
+    }
+    HarmonicTrack last;
+    if (previous) {
+        last = *previous;
+    } else {
+        // Warm up: the slowest analyzed track first.
+        int first = 0;
+        for (int i = 1; i < tracks.size(); ++i) {
+            if (tracks[i].bpm > 0.0 &&
+                    (!(tracks[first].bpm > 0.0) || tracks[i].bpm < tracks[first].bpm)) {
+                first = i;
+            }
+        }
+        order.append(first);
+        remaining.removeAt(first);
+        last = tracks[first];
+    }
+    while (!remaining.isEmpty()) {
+        int bestIndex = 0;
+        double bestCost = harmonicTransitionCost(last, tracks[remaining[0]]);
+        for (int i = 1; i < remaining.size(); ++i) {
+            const double cost = harmonicTransitionCost(last, tracks[remaining[i]]);
+            if (cost < bestCost) {
+                bestCost = cost;
+                bestIndex = i;
+            }
+        }
+        const int next = remaining.takeAt(bestIndex);
+        order.append(next);
+        last = tracks[next];
+    }
+    return order;
+}
+
+} // namespace autodj
+} // namespace mixxx
