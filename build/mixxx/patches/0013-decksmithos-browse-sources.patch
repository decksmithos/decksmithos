+void BrowseFeature::slotUpdateSources() {
+    QStringList visiblePaths;
+    std::vector<std::unique_ptr<TreeItem>> items;
+    for (const Source& source : std::as_const(m_sources)) {
+        if (isSourceAvailable(source.path)) {
+            visiblePaths.append(source.path);
+            items.push_back(std::make_unique<TreeItem>(source.label, QVariant(source.path)));
+        }
+    }
+    if (visiblePaths == m_visibleSourcePaths) {
+        return;
+    }
+    qInfo() << "Browse sources:" << visiblePaths;
+    // Drives may have changed behind the same paths: forget their cached
+    // subfolders.
+    QStringList changedPaths = m_visibleSourcePaths;
+    changedPaths.append(visiblePaths);
+    m_pSidebarModel->removeChildDirsFromCache(changedPaths);
+
+    // A drive that is gone: stop showing its files
+    for (const QString& path : std::as_const(m_visibleSourcePaths)) {
+        if (!visiblePaths.contains(path) &&
+                QString(m_browseModel.currentDirectory() + QChar('/')).startsWith(path)) {
+            emit saveModelState();
+            m_browseModel.setPath({});
+        }
+    }
+
+    m_visibleSourcePaths = visiblePaths;
+    m_lastRightClickedIndex = QModelIndex();
+    TreeItem* pRootItem = m_pSidebarModel->getRootItem();
+    if (pRootItem && pRootItem->childRows() > 0) {
+        m_pSidebarModel->removeRows(0, pRootItem->childRows());
+    }
+    if (!items.empty()) {
+        m_pSidebarModel->insertTreeItemRows(std::move(items), 0);
+    }
+}
