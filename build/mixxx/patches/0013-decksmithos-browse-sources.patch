+    if (!m_sources.isEmpty()) {
+        QStringList labels;
+        for (const Source& source : std::as_const(m_sources)) {
+            labels.append(source.label.toHtmlEscaped());
+        }
+        QString html;
+        html.append(QStringLiteral("<h2>%1</h2>").arg(tr("Sources")));
