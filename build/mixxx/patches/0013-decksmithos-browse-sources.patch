+/// DecksmithOS: "LABEL=/path:LABEL2=/path2" from DECKSMITHOS_BROWSE_SOURCES
+QList<std::pair<QString, QString>> browseSourcesFromEnvironment() {
+    QList<std::pair<QString, QString>> sources;
+    const QString value = qEnvironmentVariable("DECKSMITHOS_BROWSE_SOURCES");
+    const QStringList entries = value.split(QChar(':'), Qt::SkipEmptyParts);
+    for (const QString& entry : entries) {
+        const int equals = entry.indexOf(QChar('='));
+        if (equals <= 0 || equals == entry.size() - 1) {
+            continue;
+        }
+        QString path = entry.mid(equals + 1);
+        if (!path.endsWith(QChar('/'))) {
+            path.append(QChar('/'));
+        }
+        sources.append({entry.left(equals), path});
+    }
+    return sources;
+}
+
+/// A source is shown while it is a directory on a file system other than the
+/// root one: an empty mount point (no drive) is on "/".
+bool isSourceAvailable(const QString& path) {
+    if (!QFileInfo(path).isDir()) {
+        return false;
+    }
+    const QStorageInfo storage(path);
+    return storage.isValid() && storage.isReady() && storage.rootPath() != QDir::rootPath();
+}
