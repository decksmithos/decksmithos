+QStringList WTrackTableView::getSelectedTrackLocations() const {
+    QStringList locations;
+    TrackModel* pTrackModel = getTrackModel();
+    if (!pTrackModel) {
+        return locations;
+    }
+    QModelIndexList indices = getSelectedRows();
+    std::sort(indices.begin(), indices.end(), [](const QModelIndex& a, const QModelIndex& b) {
+        return a.row() < b.row();
+    });
+    for (const QModelIndex& index : std::as_const(indices)) {
+        const QString location = pTrackModel->getTrackLocation(index);
+        if (!location.isEmpty() && !locations.contains(location)) {
+            locations.append(location);
+        }
+    }
+    return locations;
+}
