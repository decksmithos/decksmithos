+void LibraryControl::slotCopySelected(double v) {
+    if (!m_pLibraryWidget || v <= 0 || !CopyTracksDialog::isEnabled()) {
+        return;
+    }
+    WTrackTableView* pTrackTableView = m_pLibraryWidget->getCurrentTrackTableView();
+    if (!pTrackTableView) {
+        return;
+    }
+    const QStringList locations = pTrackTableView->getSelectedTrackLocations();
+    if (locations.isEmpty()) {
+        return;
+    }
+    auto* pDialog = new CopyTracksDialog(
+            m_pLibraryWidget->window(), m_pLibrary->trackCollectionManager(), locations);
+    pDialog->setAttribute(Qt::WA_DeleteOnClose);
+    pDialog->open();
