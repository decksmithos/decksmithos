+class QProgressBar;
+class QPushButton;
+class QThread;
+class QTreeView;
+class TrackCollectionManager;
+
+/// DecksmithOS: copies the files of tracks to a folder chosen in a folder
+/// tree, for a touch screen without a file manager (DECKSMITHOS_COPY_ROOTS).
+///
+///  - DECKSMITHOS_COPY_ROOTS="CONSOLE=/storage/library:USB=/usb:USB2=/usb2":
+///    the roots of the tree, by label; a root that is a removable drive
+///    (DECKSMITHOS_DRIVES) is offered only while a drive is mounted there.
+///  - DECKSMITHOS_USB_WRITE_COMMAND: run with the drive's mount point and
+///    "on" before the copy to a drive and with "off" after it (DecksmithOS:
+///    sudo -n decksmithos-system usb-write; the drives are mounted read-only
+///    otherwise).
+///
+/// Files are copied as they are (never changed), into the chosen folder or
+/// a new folder in it; a file of the same name there is skipped. Each copy
+/// is written under a temporary name and renamed when complete. The copy
+/// runs in a thread at the lowest CPU and idle I/O priority, so that the
+/// decks reading from the same drives are served first. Copied files in the
+/// library's directories are added to the library.
+class CopyTracksDialog : public QDialog {
+    Q_OBJECT
+  public:
+    static bool isEnabled();
+
+    CopyTracksDialog(QWidget* pParent,
+            TrackCollectionManager* pTrackCollectionManager,
+            const QStringList& sourceFiles);
+    ~CopyTracksDialog() override;
+
+  protected:
+    void reject() override;
+
+  private:
+    struct Root {
+        QString label;
+        QString path;
+        bool removable;
+        QPushButton* pButton;
+    };
+
+    void selectRoot(int index);
+    void updateDestination();
+    QString destinationFolder(QString* pError) const;
+    void startCopy();
+    void copyFinished(const QStringList& copied,
+            int skipped,
+            int failed,
+            const QString& error);
+    void addToLibrary();
+
+    TrackCollectionManager* const m_pTrackCollectionManager;
+    const QStringList m_sourceFiles;
+    qint64 m_sourceBytes;
+    QList<Root> m_roots;
+    int m_rootIndex;
+
+    QFileSystemModel* m_pModel;
+    QTreeView* m_pTree;
+    QLabel* m_pDestination;
+    QLineEdit* m_pNewFolder;
+    QProgressBar* m_pProgress;
+    QLabel* m_pStatus;
+    QPushButton* m_pCancel;
+    QPushButton* m_pCopy;
+
+    QThread* m_pThread;
+    std::atomic<bool> m_cancel;
+    bool m_done;
+    QStringList m_toAdd;
+};
