+// The length of a beat in seconds at the current tempo around "second" of
+// the loaded track, 0 if unknown (no beat grid)
+double AutoDJProcessor::beatSecondsAt(DeckAttributes* pDeck, double second) {
+    const TrackPointer pTrack = pDeck->getLoadedTrack();
+    if (!pTrack) {
+        return 0;
+    }
+    const mixxx::BeatsPointer pBeats = pTrack->getBeats();
+    const mixxx::audio::SampleRate sampleRate = pDeck->sampleRate();
+    const double rateRatio = pDeck->rateRatio();
+    if (!pBeats || !sampleRate.isValid() || rateRatio <= 0) {
+        return 0;
+    }
+    const mixxx::Bpm bpm = pBeats->getBpmAroundPosition(
+            mixxx::audio::FramePos(second * rateRatio * sampleRate.value()),
+            kTempoBeats);
+    if (!bpm.isValid() || bpm.value() <= 0) {
+        return 0;
+    }
+    return 60.0 / (bpm.value() * rateRatio);
+}
+
+void AutoDJProcessor::controlNextTransitionBeats(double value) {
+    Q_UNUSED(value);
+    // Same as a changed transition time: new fade thresholds, unless a fade
+    // is under way
+    if (m_eState != ADJ_IDLE) {
+        return;
+    }
+    DeckAttributes* pLeftDeck = getLeftDeck();
+    DeckAttributes* pRightDeck = getRightDeck();
+    if (!pLeftDeck || !pRightDeck) {
+        return;
+    }
+    if (pLeftDeck->isPlaying() && !pRightDeck->isPlaying()) {
+        calculateTransition(pLeftDeck, pRightDeck, false);
+    } else if (pRightDeck->isPlaying() && !pLeftDeck->isPlaying()) {
+        calculateTransition(pRightDeck, pLeftDeck, false);
+    }
+}
+
+void AutoDJProcessor::updateSecondsToTransition(DeckAttributes* pDeck, double playPosition) {
+    if (!pDeck->isFromDeck) {
+        return;
+    }
+    double seconds = -1;
+    if (m_eState == ADJ_IDLE && pDeck->isPlaying() && pDeck->fadeBeginPos < 1.0) {
+        seconds = math_max(0.0, (pDeck->fadeBeginPos - playPosition) * getEndSecond(pDeck));
+    } else if (m_eState == ADJ_LEFT_FADING || m_eState == ADJ_RIGHT_FADING) {
+        seconds = 0;
+    }
+    if (m_secondsToTransition.get() != seconds) {
+        m_secondsToTransition.forceSet(seconds);
+    }
+}
+
+// The places where a phrase-aligned transition may start: the phrase starts
+// of the track structure (rekordbox or detected; patches 0007 and 0020), long
+// phrases divided every 8 bars; without phrases, every 8 bars from the first
+// downbeat (or the first beat). In seconds at the current tempo, sorted.
+std::vector<double> AutoDJProcessor::phraseGridSeconds(DeckAttributes* pDeck) {
+    std::vector<double> grid;
+    const TrackPointer pTrack = pDeck->getLoadedTrack();
+    if (!pTrack) {
+        return grid;
+    }
+    const mixxx::BeatsPointer pBeats = pTrack->getBeats();
+    const mixxx::audio::FramePos trackEnd = pDeck->trackEndPosition();
+    if (!pBeats || !trackEnd.isValid()) {
+        return grid;
+    }
+    const auto addFrom = [&](mixxx::audio::FramePos position, mixxx::audio::FramePos end) {
+        while (position.isValid() && position < end && position < trackEnd) {
+            grid.push_back(framePositionToSeconds(position, pDeck));
+            const mixxx::audio::FramePos next =
+                    pBeats->findNBeatsFromPosition(position, kPhraseGridBeats);
+            if (!next.isValid() || next <= position) {
+                break;
+            }
+            position = next;
+        }
+    };
+    const mixxx::TrackStructurePointer pStructure = pTrack->getStructure();
+    if (pStructure && !pStructure->phrases().isEmpty()) {
+        for (const auto& phrase : pStructure->phrases()) {
+            addFrom(phrase.start, phrase.end.isValid() ? phrase.end : trackEnd);
+        }
+    } else {
+        mixxx::audio::FramePos downbeat = pStructure
+                ? pStructure->firstDownbeat()
+                : mixxx::audio::FramePos();
+        if (!downbeat.isValid()) {
+            downbeat = pBeats->firstBeat();
+        }
+        addFrom(downbeat, trackEnd);
+    }
+    std::sort(grid.begin(), grid.end());
+    grid.erase(std::unique(grid.begin(), grid.end()), grid.end());
+    return grid;
+}
+
+// DecksmithOS: [AutoDJ],next_transition_beats >= 0 sets the length of the
+// next transition in beats of the outgoing track (0: a cut); it is reset to
+// -1 (the transition mode and time decide) when that transition starts.
+// With [AutoDJ],phrase_align on, the transition starts on a phrase start of
+// the outgoing track (the latest that lets it end by the mode's end point,
+// otherwise the next one), and a newly cued incoming track starts at its
+// phrase start nearest to the mode's start point, so that both phrases
+// begin together. Tracks without a beat grid are left as the mode set them.
+void AutoDJProcessor::planTransition(DeckAttributes* pFromDeck,
+        DeckAttributes* pToDeck,
+        double fromDeckSecond,
+        bool seekToStartPoint) {
+    const double beats = m_nextTransitionBeats.get();
+    const bool align = m_phraseAlign.toBool();
+    if (beats < 0 && !align) {
+        return;
+    }
+    const double fromDeckEnd = getEndSecond(pFromDeck);
+    const double fadeEnd = pFromDeck->fadeEndPos;
+    const double beatSeconds = beatSecondsAt(pFromDeck, fadeEnd);
+    if (beatSeconds <= 0) {
+        return;
+    }
+    const double length = beats >= 0
+            ? beats * beatSeconds
+            : math_max(0.0, pFromDeck->fadeEndPos - pFromDeck->fadeBeginPos);
+    double begin = fadeEnd - length;
+    if (align) {
+        // At least a beat from now, so that the start is not missed
+        const double earliest = fromDeckSecond + beatSeconds;
+        const std::vector<double> grid = phraseGridSeconds(pFromDeck);
+        std::optional<double> chosen;
+        for (double start : grid) {
+            if (start >= earliest && start <= begin + beatSeconds / 2) {
+                chosen = start;
+            }
+        }
+        if (!chosen) {
+            for (double start : grid) {
+                if (start >= earliest && start + length <= fromDeckEnd) {
+                    chosen = start;
+                    break;
+                }
+            }
+        }
+        if (chosen) {
+            begin = *chosen;
+        }
+    }
+    begin = math_max(begin, fromDeckSecond);
+    pFromDeck->fadeBeginPos = begin;
+    pFromDeck->fadeEndPos = math_min(begin + length, fromDeckEnd);
+
+    if (align && seekToStartPoint && pToDeck->startPos >= 0) {
+        const double limit = pToDeck->fadeBeginPos - kMinimumTrackDurationSec;
+        std::optional<double> nearest;
+        for (double start : phraseGridSeconds(pToDeck)) {
+            if (start < 0 || start >= limit) {
+                continue;
+            }
+            if (!nearest ||
+                    fabs(start - pToDeck->startPos) <
+                            fabs(*nearest - pToDeck->startPos)) {
+                nearest = start;
+            }
+        }
+        if (nearest) {
+            pToDeck->startPos = *nearest;
+        }
+    }
+    if constexpr (sDebug) {
+        qDebug() << this << "planTransition" << beats << align
+                 << pFromDeck->fadeBeginPos << pFromDeck->fadeEndPos
+                 << pToDeck->startPos;
+    }
+}
