+// DecksmithOS: [AutoDJ],next_transition_beats and [AutoDJ],phrase_align
+// (phrase grid: no phrases, so every 32 beats = 8 s at 240 BPM from the first
+// beat at 0)
+TEST_F(AutoDJProcessorTest, PhraseAlignedTransitions) {
+    pProcessor->setTransitionMode(AutoDJProcessor::TransitionMode::FixedFullTrack);
+    pProcessor->setTransitionTime(10);
+
+    TrackId testId = addTrackToCollection(kTrackLocationTest);
+    ASSERT_TRUE(testId.isValid());
+
+    mixer.crossfader.set(-1.0);
+    TrackPointer pTrack = newTestTrack();
+    ASSERT_TRUE(pTrack->trySetBeats(mixxx::Beats::fromConstTempo(
+            pTrack->getSampleRate(), mixxx::audio::kStartFramePos, mixxx::Bpm(240))));
+    const double duration = pTrack->getDuration();
+    ASSERT_GT(duration, 26.0);
+    ASSERT_LT(duration, 32.0);
+    deck1.slotLoadTrack(pTrack, true);
+    deck1.fakeTrackLoadedEvent(pTrack);
+
+    PlaylistTableModel* pAutoDJTableModel = pProcessor->getTableModel();
+    pAutoDJTableModel->appendTrack(testId);
+
+    EXPECT_CALL(*pProcessor, emitAutoDJStateChanged(AutoDJProcessor::ADJ_IDLE));
+    EXPECT_CALL(*pProcessor, emitLoadTrackToPlayer(_, QString("[Channel2]"), false));
+    EXPECT_EQ(AutoDJProcessor::ADJ_OK, pProcessor->toggleAutoDJ(true));
+    deck2.slotLoadTrack(pTrack, false);
+    deck2.fakeTrackLoadedEvent(pTrack);
+
+    ControlProxy nextBeats(QStringLiteral("[AutoDJ]"), QStringLiteral("next_transition_beats"));
+    ControlProxy secondsTo(QStringLiteral("[AutoDJ]"), QStringLiteral("seconds_to_transition"));
+    EXPECT_DOUBLE_EQ(-1.0, nextBeats.get());
+
+    // 10 s before the end would be about duration - 10 (16..22 s); the
+    // phrase start at 16 s is the latest before it
+    deck1.playposition.set(15.5 / duration);
+    EXPECT_EQ(AutoDJProcessor::ADJ_IDLE, pProcessor->getState());
+    EXPECT_NEAR(0.5, secondsTo.get(), 0.01);
+
+    // A cut: on the last phrase start, 24 s
+    nextBeats.set(0);
+    deck1.playposition.set(23.9 / duration);
+    EXPECT_EQ(AutoDJProcessor::ADJ_IDLE, pProcessor->getState());
+    EXPECT_NEAR(0.1, secondsTo.get(), 0.01);
+    EXPECT_DOUBLE_EQ(-1.0, mixer.crossfader.get());
+
+    EXPECT_CALL(*pProcessor, emitAutoDJStateChanged(AutoDJProcessor::ADJ_LEFT_FADING));
+    deck1.playposition.set(24.05 / duration);
+    EXPECT_EQ(AutoDJProcessor::ADJ_LEFT_FADING, pProcessor->getState());
+    EXPECT_DOUBLE_EQ(1.0, mixer.crossfader.get());
+    EXPECT_DOUBLE_EQ(1.0, deck2.play.get());
+    // used up by this transition
+    EXPECT_DOUBLE_EQ(-1.0, nextBeats.get());
+    EXPECT_DOUBLE_EQ(0.0, secondsTo.get());
+}
