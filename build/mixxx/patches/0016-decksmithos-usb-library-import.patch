+TEST(UsbImportTest, DriveList) {
+    const QList<Drive> drives = parseDriveList(QStringLiteral("/usb:/usb2/::/usb:/media/x"));
+    ASSERT_EQ(3, drives.size());
+    EXPECT_EQ(QStringLiteral("/usb"), drives[0].mountPoint);
+    EXPECT_EQ(QStringLiteral("USB"), drives[0].label);
+    EXPECT_EQ(QStringLiteral("/usb2"), drives[1].mountPoint);
+    EXPECT_EQ(QStringLiteral("USB2"), drives[1].label);
+    EXPECT_EQ(QStringLiteral("/media/x"), drives[2].mountPoint);
+    EXPECT_EQ(QStringLiteral("USB3"), drives[2].label);
+    EXPECT_TRUE(parseDriveList(QString()).isEmpty());
+}
+
+TEST(UsbImportTest, PlaylistName) {
