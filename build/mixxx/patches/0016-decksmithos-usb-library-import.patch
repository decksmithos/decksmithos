+#include "library/usbimport/usblibraryimporter.h"
+
+#include <QDir>
+#include <QElapsedTimer>
+#include <QFile>
+#include <QFileInfo>
+#include <QMutex>
+#include <QSignalBlocker>
+#include <QSqlQuery>
+#include <QThread>
+#include <QWaitCondition>
+#include <QtDebug>
+#include <atomic>
+#include <deque>
+
+#include "library/dao/analysisdao.h"
+#include "library/dao/playlistdao.h"
+#include "library/queryutil.h"
+#include "library/serato/seratocrate.h"
+#include "library/trackcollection.h"
+#include "library/trackcollectionmanager.h"
+#include "moc_usblibraryimporter.cpp"
+#include "track/keyfactory.h"
+#include "track/track.h"
+#include "track/trackref.h"
+
+namespace mixxx {
+namespace usbimport {
+
+const QString kPlaylistTable = QStringLiteral("decksmithos_usb_playlists");
+
+namespace {
+
+constexpr int kPollIntervalMillis = 2000;
+constexpr int kQueueIntervalMillis = 50;
+/// GUI thread time per queue tick for applying analysis results
+constexpr int kQueueBudgetMillis = 15;
+/// Maximum number of analysis results waiting for the GUI thread
+constexpr size_t kMaxQueuedResults = 32;
+/// Sort order offset between drives, so the lists of the first drive come
+/// first
+constexpr int kSortOrderPerDrive = 1000000;
+/// Give up waiting for a requested library scan that does not start
+constexpr qint64 kScanStartTimeoutMillis = 15000;
+
+const QString kSeratoDirectory = QStringLiteral("_Serato_");
+const QString kSeratoCrateDirectory = QStringLiteral("Subcrates");
+const QString kSeratoNewOrderFile = QStringLiteral("neworder.pref");
+const QString kSeratoCrateSuffix = QStringLiteral(".crate");
+
+void readRekordbox(const Drive& drive, DriveIndex* pIndex) {
+    const rekordbox::Export rbExport = rekordbox::readExport(drive.mountPoint);
+    if (!rbExport.valid) {
+        return;
+    }
+    QHash<quint32, QString> locationsById;
+    for (const auto& track : rbExport.tracks) {
+        pIndex->rekordboxTracks.insert(locationKey(track.location), track);
+        pIndex->rekordboxTrackList.append(track);
+        locationsById.insert(track.id, track.location);
+    }
+
+    QList<PlaylistTreeNode> nodes;
+    for (const auto& exportNode : rbExport.playlistNodes) {
+        nodes.append(PlaylistTreeNode{exportNode.id,
+                exportNode.parentId,
+                exportNode.sortOrder,
+                exportNode.isFolder,
+                exportNode.name});
+    }
+    const QList<FlatPlaylist> flatPlaylists = flattenPlaylistTree(nodes);
+    for (const auto& flatPlaylist : flatPlaylists) {
+        DrivePlaylist playlist;
+        playlist.name = playlistName(drive.label, flatPlaylist.path);
+        // QMap: ordered by the entry index
+        const QMap<quint32, quint32> entries =
+                rbExport.playlistEntries.value(flatPlaylist.id);
+        for (const quint32 trackId : entries) {
+            const QString location = locationsById.value(trackId);
+            if (!location.isEmpty()) {
+                playlist.locations.append(location);
+            }
+        }
+        pIndex->playlists.append(playlist);
+    }
+    qInfo() << "USB import:" << drive.mountPoint << "has a rekordbox export with"
+            << rbExport.tracks.size() << "tracks and" << flatPlaylists.size()
+            << "playlists";
+}
+
+void readSerato(const Drive& drive, DriveIndex* pIndex) {
+    const QDir seratoDir(QDir(drive.mountPoint).filePath(kSeratoDirectory));
+    QDir crateDir(seratoDir.filePath(kSeratoCrateDirectory));
+    if (!seratoDir.exists() || !crateDir.exists()) {
+        return;
+    }
+
+    // Crate name (file name without suffix) -> file name
+    QHash<QString, QString> crateFiles;
+    const QStringList entries = crateDir.entryList(
+            QStringList{QStringLiteral("*") + kSeratoCrateSuffix}, QDir::Files);
+    for (const QString& fileName : entries) {
+        if (!fileName.endsWith(kSeratoCrateSuffix, Qt::CaseInsensitive)) {
+            continue;
+        }
+        crateFiles.insert(fileName.left(fileName.size() - kSeratoCrateSuffix.size()),
+                fileName);
+    }
+
+    QStringList newOrder;
+    QFile newOrderFile(seratoDir.filePath(kSeratoNewOrderFile));
+    if (newOrderFile.open(QIODevice::ReadOnly)) {
+        newOrder = parseSeratoNewOrder(newOrderFile.readAll());
+    }
+
+    const QStringList crateNames = orderSeratoCrates(crateFiles.keys(), newOrder);
+    for (const QString& crateName : crateNames) {
+        QFile crateFile(crateDir.filePath(crateFiles.value(crateName)));
+        if (!crateFile.open(QIODevice::ReadOnly)) {
+            qWarning() << "USB import: cannot open Serato crate" << crateFile.fileName();
+            continue;
+        }
+        bool ok = true;
+        const QStringList paths = serato::readCrateTrackPaths(&crateFile, &ok);
+        if (!ok) {
+            qWarning() << "USB import: Serato crate" << crateFile.fileName()
+                       << "is damaged, importing" << paths.size() << "tracks";
+        }
+        DrivePlaylist playlist;
+        playlist.name = playlistName(drive.label, seratoCratePath(crateName));
+        for (const QString& path : paths) {
+            playlist.locations.append(driveLocation(drive.mountPoint, path));
+        }
+        pIndex->playlists.append(playlist);
+    }
+    qInfo() << "USB import:" << drive.mountPoint << "has" << crateNames.size()
+            << "Serato crates," << newOrder.size() << "listed in neworder.pref";
+}
+
+QString sqlLikeEscaped(QString text) {
+    text.replace(QChar('\\'), QStringLiteral("\\\\"));
+    text.replace(QChar('%'), QStringLiteral("\\%"));
+    text.replace(QChar('_'), QStringLiteral("\\_"));
+    return text;
+}
+
+} // anonymous namespace
+
+std::shared_ptr<const DriveIndex> readDriveIndex(const Drive& drive) {
+    auto pIndex = std::make_shared<DriveIndex>();
+    readRekordbox(drive, pIndex.get());
+    readSerato(drive, pIndex.get());
+    return pIndex;
+}
+
+/// Phase 2: reads the ANLZ files of the tracks of a drive in a worker thread.
+/// The results are queued for the GUI thread; the worker waits while the
+/// queue is full.
+struct UsbLibraryImporter::AnalysisJob {
+    struct Result {
+        QString key;
+        rekordbox::ExportTrack track;
+        rekordbox::Analysis analysis;
+    };
+
+    std::atomic<bool> canceled{false};
+    std::atomic<bool> finished{false};
+    QMutex mutex;
+    QWaitCondition notFull;
+    std::deque<Result> results;
+
+    void run(const QList<rekordbox::ExportTrack>& tracks) {
+        QThread::currentThread()->setPriority(QThread::LowPriority);
+        for (const auto& track : tracks) {
+            if (canceled) {
+                break;
+            }
+            if (!QFileInfo::exists(track.location)) {
+                continue;
+            }
+            Result result;
+            result.key = locationKey(track.location);
+            result.track = track;
+            result.analysis = rekordbox::readAnalysis(track.anlzPath,
+                    rekordbox::timingOffsetMillis(track.location),
+                    true);
+            QMutexLocker lock(&mutex);
+            while (results.size() >= kMaxQueuedResults && !canceled) {
+                notFull.wait(&mutex, 200);
+            }
+            results.push_back(std::move(result));
+        }
+        finished = true;
+    }
+
+    bool takeResult(Result* pResult) {
+        QMutexLocker lock(&mutex);
+        if (results.empty()) {
+            return false;
+        }
+        *pResult = std::move(results.front());
+        results.pop_front();
+        notFull.wakeAll();
+        return true;
+    }
+
+    bool isDone() {
+        QMutexLocker lock(&mutex);
+        return finished && results.empty();
+    }
+};
+
+struct UsbLibraryImporter::DriveState {
+    enum class Scan {
+        WaitForStart,
+        WaitForFinish,
+        Done,
+    };
+
+    explicit DriveState(Drive drive)
+            : drive(std::move(drive)) {
+    }
+
+    void reset() {
+        scan = Scan::Done;
+        scanRequested.invalidate();
+        pIndex.reset();
+        loadedBeforeIndex.clear();
+        applied.clear();
+        importStarted = false;
+        trackIds.clear();
+        nextPlaylist = -1;
+        appliedCount = 0;
+    }
+
+    const Drive drive;
+    bool present = false;
+    /// Incremented whenever the drive appears or disappears, results of
+    /// older background jobs are discarded.
+    quint64 generation = 0;
+    Scan scan = Scan::Done;
+    QElapsedTimer scanRequested;
+    std::shared_ptr<const DriveIndex> pIndex;
+    /// Tracks loaded into a player before the index was read (key -> location)
+    QHash<QString, QString> loadedBeforeIndex;
+    /// Location keys of the tracks whose rekordbox data has been applied in
+    /// this session
+    QSet<QString> applied;
+    bool importStarted = false;
+    /// Library track ids of the drive by location key
+    QHash<QString, TrackId> trackIds;
+    /// Next playlist to create, -1 if none
+    int nextPlaylist = -1;
+    int appliedCount = 0;
+    std::shared_ptr<AnalysisJob> pJob;
+};
+
+UsbLibraryImporter* UsbLibraryImporter::s_pInstance = nullptr;
+
+bool UsbLibraryImporter::isEnabled() {
+    return !qEnvironmentVariableIsEmpty(kEnvVar);
+}
+
+bool UsbLibraryImporter::ensureSchema(const QSqlDatabase& database) {
+    QSqlQuery query(database);
+    if (!query.exec(QStringLiteral(
+                "CREATE TABLE IF NOT EXISTS %1 ("
+                "playlist_id INTEGER PRIMARY KEY, "
+                "mount_point TEXT NOT NULL, "
+                "sort_order INTEGER NOT NULL)")
+                            .arg(kPlaylistTable))) {
+        LOG_FAILED_QUERY(query);
+        return false;
+    }
+    return true;
+}
+
+void UsbLibraryImporter::beforeTrackLoad(const TrackPointer& pTrack) {
+    if (s_pInstance && pTrack) {
+        s_pInstance->applyBeforeLoad(pTrack);
+    }
+}
+
+UsbLibraryImporter::UsbLibraryImporter(
+        QObject* parent, TrackCollectionManager* pTrackCollectionManager)
+        : QObject(parent),
+          m_pTrackCollectionManager(pTrackCollectionManager),
+          m_watcher(parseDriveList(qEnvironmentVariable(kEnvVar)), isMountedFilesystem),
+          m_libraryScanRunning(false) {
+    for (const auto& drive : m_watcher.drives()) {
+        m_states.append(std::make_shared<DriveState>(drive));
+    }
+    // Phase 1 and phase 2 jobs of both drives
+    m_threadPool.setMaxThreadCount(2);
+
+    m_pollTimer.setInterval(kPollIntervalMillis);
+    connect(&m_pollTimer, &QTimer::timeout, this, &UsbLibraryImporter::slotPoll);
+    m_queueTimer.setInterval(kQueueIntervalMillis);
+    connect(&m_queueTimer, &QTimer::timeout, this, &UsbLibraryImporter::slotProcessQueue);
+
+    connect(m_pTrackCollectionManager,
+            &TrackCollectionManager::libraryScanStarted,
+            this,
+            &UsbLibraryImporter::slotLibraryScanStarted);
+    connect(m_pTrackCollectionManager,
+            &TrackCollectionManager::libraryScanFinished,
+            this,
+            &UsbLibraryImporter::slotLibraryScanFinished);
+
+    DEBUG_ASSERT(!s_pInstance);
+    s_pInstance = this;
+}
+
+UsbLibraryImporter::~UsbLibraryImporter() {
+    s_pInstance = nullptr;
+    m_pollTimer.stop();
+    m_queueTimer.stop();
+    for (const auto& pState : std::as_const(m_states)) {
+        cancelJob(pState.get());
+    }
+    m_threadPool.waitForDone();
+}
+
+QSqlDatabase UsbLibraryImporter::database() const {
+    return m_pTrackCollectionManager->internalCollection()->database();
+}
+
+void UsbLibraryImporter::start() {
+    QStringList mountPoints;
+    for (const auto& drive : m_watcher.drives()) {
+        mountPoints.append(drive.mountPoint);
+    }
+    qInfo() << "USB import enabled for" << mountPoints;
+
+    ensureSchema(database());
+    // Forget playlists that were deleted by the user
+    QSqlQuery query(database());
+    if (!query.exec(QStringLiteral(
+                "DELETE FROM %1 WHERE playlist_id NOT IN (SELECT id FROM Playlists)")
+                            .arg(kPlaylistTable))) {
+        LOG_FAILED_QUERY(query);
+    }
+    // Playlists of the last session (or a crash) are never kept: the drives
+    // that are present are imported again.
+    QSet<int> removed;
+    if (query.exec(QStringLiteral("SELECT DISTINCT mount_point FROM %1").arg(kPlaylistTable))) {
+        QStringList oldMountPoints;
+        while (query.next()) {
+            oldMountPoints.append(query.value(0).toString());
+        }
+        for (const QString& mountPoint : std::as_const(oldMountPoints)) {
+            removed += deletePlaylists(mountPoint);
+        }
+    } else {
+        LOG_FAILED_QUERY(query);
+    }
+    if (!removed.isEmpty()) {
+        qInfo() << "USB import: deleted" << removed.size() << "playlists of the last session";
+        emit playlistsChanged(removed);
+    }
+
+    slotPoll();
+    m_pollTimer.start();
+}
+
+void UsbLibraryImporter::slotPoll() {
+    const QList<DriveWatcher::Change> changes = m_watcher.poll();
+    for (const auto& change : changes) {
+        if (change.present) {
+            driveAppeared(change.driveIndex);
+        } else {
+            driveRemoved(change.driveIndex);
+        }
+    }
+
+    for (int i = 0; i < m_states.size(); ++i) {
+        DriveState* pState = m_states[i].get();
+        if (pState->present && pState->scan == DriveState::Scan::WaitForStart &&
+                !m_libraryScanRunning &&
+                pState->scanRequested.isValid() &&
+                pState->scanRequested.elapsed() > kScanStartTimeoutMillis) {
+            qWarning() << "USB import: the library scan for" << pState->drive.mountPoint
+                       << "did not start, importing without it";
+            pState->scan = DriveState::Scan::Done;
+            maybeStartImport(i);
+        }
+    }
+}
+
+void UsbLibraryImporter::driveAppeared(int driveIndex) {
+    DriveState* pState = m_states[driveIndex].get();
+    qInfo() << "USB import: drive" << pState->drive.label << "appeared at"
+            << pState->drive.mountPoint;
+    cancelJob(pState);
+    pState->reset();
+    pState->present = true;
+    pState->generation++;
+
+    const QSet<int> removed = deletePlaylists(pState->drive.mountPoint);
+    if (!removed.isEmpty()) {
+        emit playlistsChanged(removed);
+    }
+
+    // The files of the drive must be in the library before playlists can be
+    // created and analysis data can be applied.
+    pState->scan = DriveState::Scan::WaitForStart;
+    requestLibraryScan();
+
+    const Drive drive = pState->drive;
+    const quint64 generation = pState->generation;
+    m_threadPool.start([this, drive, driveIndex, generation]() {
+        QThread::currentThread()->setPriority(QThread::LowPriority);
+        QElapsedTimer timer;
+        timer.start();
+        std::shared_ptr<const DriveIndex> pIndex = readDriveIndex(drive);
+        qInfo() << "USB import: read" << drive.mountPoint << "in"
+                << timer.elapsed() << "ms";
+        QMetaObject::invokeMethod(
+                this,
+                [this, driveIndex, generation, pIndex]() {
+                    driveIndexRead(driveIndex, generation, pIndex);
+                },
+                Qt::QueuedConnection);
+    });
+}
+
+void UsbLibraryImporter::driveRemoved(int driveIndex) {
+    DriveState* pState = m_states[driveIndex].get();
+    qInfo() << "USB import: drive" << pState->drive.label << "removed from"
+            << pState->drive.mountPoint;
+    cancelJob(pState);
+    pState->reset();
+    pState->present = false;
+    pState->generation++;
+
+    const QSet<int> removed = deletePlaylists(pState->drive.mountPoint);
+    if (!removed.isEmpty()) {
+        emit playlistsChanged(removed);
+    }
+    updateQueueTimer();
+}
+
+void UsbLibraryImporter::driveIndexRead(int driveIndex,
+        quint64 generation,
+        std::shared_ptr<const DriveIndex> pIndex) {
+    DriveState* pState = m_states[driveIndex].get();
+    if (!pState->present || pState->generation != generation) {
+        return; // the drive was removed in the meantime
+    }
+    pState->pIndex = std::move(pIndex);
+
+    // Tracks that were loaded before the index was available
+    const QHash<QString, QString> loaded = pState->loadedBeforeIndex;
+    pState->loadedBeforeIndex.clear();
+    for (auto it = loaded.constBegin(); it != loaded.constEnd(); ++it) {
+        if (pState->applied.contains(it.key())) {
+            continue;
+        }
+        const TrackPointer pTrack = m_pTrackCollectionManager->getTrackByRef(
+                TrackRef::fromFilePath(it.value()));
+        if (pTrack) {
+            applyNow(pState, pTrack, it.key());
+        }
+    }
+
+    maybeStartImport(driveIndex);
+}
+
+void UsbLibraryImporter::requestLibraryScan() {
+    if (m_libraryScanRunning) {
+        // Requested again when the running scan has finished
+        return;
+    }
+    for (const auto& pState : std::as_const(m_states)) {
+        if (pState->present && pState->scan == DriveState::Scan::WaitForStart) {
+            pState->scanRequested.start();
+        }
+    }
+    qInfo() << "USB import: requesting a library scan";
+    m_pTrackCollectionManager->startLibraryScan();
+}
+
+void UsbLibraryImporter::slotLibraryScanStarted() {
+    m_libraryScanRunning = true;
+    for (const auto& pState : std::as_const(m_states)) {
+        if (pState->present && pState->scan == DriveState::Scan::WaitForStart) {
+            pState->scan = DriveState::Scan::WaitForFinish;
+        }
+    }
+}
+
+void UsbLibraryImporter::slotLibraryScanFinished() {
+    m_libraryScanRunning = false;
+    bool rescan = false;
+    for (int i = 0; i < m_states.size(); ++i) {
+        DriveState* pState = m_states[i].get();
+        if (!pState->present) {
+            continue;
+        }
+        if (pState->scan == DriveState::Scan::WaitForFinish) {
+            pState->scan = DriveState::Scan::Done;
+            maybeStartImport(i);
+        } else if (pState->scan == DriveState::Scan::WaitForStart) {
+            // Appeared while a scan was running, which may have missed it
+            rescan = true;
+        }
+    }
+    if (rescan) {
+        requestLibraryScan();
+    }
+}
+
+void UsbLibraryImporter::maybeStartImport(int driveIndex) {
+    DriveState* pState = m_states[driveIndex].get();
+    if (!pState->present || !pState->pIndex ||
+            pState->scan != DriveState::Scan::Done || pState->importStarted) {
+        return;
+    }
+    pState->importStarted = true;
+
+    // Library tracks of the drive
+    QSqlQuery query(database());
+    query.prepare(QStringLiteral(
+            "SELECT library.id, track_locations.location FROM library "
+            "INNER JOIN track_locations ON library.location = track_locations.id "
+            "WHERE track_locations.location LIKE :prefix ESCAPE '\\'"));
+    const QString prefix =
+            sqlLikeEscaped(pState->drive.mountPoint + QChar('/')) + QChar('%');
+    query.bindValue(QStringLiteral(":prefix"), prefix);
+    if (query.exec()) {
+        while (query.next()) {
+            const QString location = query.value(1).toString();
+            if (isOnDrive(location, pState->drive.mountPoint)) {
+                pState->trackIds.insert(locationKey(location), TrackId(query.value(0)));
+            }
+        }
+    } else {
+        LOG_FAILED_QUERY(query);
+    }
+
+    const DriveIndex& index = *pState->pIndex;
+    if (!index.playlists.isEmpty()) {
+        pState->nextPlaylist = 0;
+    }
+
+    QList<rekordbox::ExportTrack> tracks;
+    for (const auto& track : index.rekordboxTrackList) {
+        const QString key = locationKey(track.location);
+        if (pState->trackIds.contains(key) && !pState->applied.contains(key)) {
+            tracks.append(track);
+        }
+    }
+    qInfo() << "USB import:" << pState->drive.mountPoint << "has"
+            << pState->trackIds.size() << "library tracks; importing"
+            << index.playlists.size() << "playlists and the rekordbox data of"
+            << tracks.size() << "tracks";
+
+    if (!tracks.isEmpty()) {
+        auto pJob = std::make_shared<AnalysisJob>();
+        pState->pJob = pJob;
+        m_threadPool.start([pJob, tracks]() {
+            pJob->run(tracks);
+        });
+    }
+    updateQueueTimer();
+}
+
+void UsbLibraryImporter::slotProcessQueue() {
+    QElapsedTimer timer;
+    timer.start();
+    for (int i = 0; i < m_states.size(); ++i) {
+        DriveState* pState = m_states[i].get();
+        if (!pState->present || !pState->importStarted) {
+            continue;
+        }
+        // One playlist per tick, it takes a few database transactions
+        if (pState->nextPlaylist >= 0) {
+            createPlaylist(i, pState->nextPlaylist);
+            pState->nextPlaylist++;
+            if (pState->nextPlaylist >= pState->pIndex->playlists.size()) {
+                pState->nextPlaylist = -1;
+                qInfo() << "USB import: created" << pState->pIndex->playlists.size()
+                        << "playlists of" << pState->drive.mountPoint;
+                emit playlistsChanged(QSet<int>());
+            }
+        }
+        const int remaining = kQueueBudgetMillis - static_cast<int>(timer.elapsed());
+        if (remaining > 0) {
+            applyAnalysisResults(i, remaining);
+        }
+    }
+    updateQueueTimer();
+}
+
+void UsbLibraryImporter::createPlaylist(int driveIndex, int listIndex) {
+    DriveState* pState = m_states[driveIndex].get();
+    const DrivePlaylist& playlist = pState->pIndex->playlists[listIndex];
+
+    QList<TrackId> trackIds;
+    for (const QString& location : playlist.locations) {
+        const TrackId trackId = pState->trackIds.value(locationKey(location));
+        if (trackId.isValid()) {
+            trackIds.append(trackId);
+        }
+    }
+
+    PlaylistDAO& playlistDao = m_pTrackCollectionManager->internalCollection()->getPlaylistDAO();
+    // The sidebar is rebuilt once after all playlists have been created
+    // (playlistsChanged()) instead of after every single change.
+    const QSignalBlocker blocker(&playlistDao);
+    const int playlistId = playlistDao.createPlaylist(playlist.name);
+    if (playlistId == kInvalidPlaylistId) {
+        qWarning() << "USB import: failed to create playlist" << playlist.name;
+        return;
+    }
+    QSqlQuery query(database());
+    query.prepare(QStringLiteral(
+            "INSERT OR REPLACE INTO %1 (playlist_id, mount_point, sort_order) "
+            "VALUES (:id, :mount_point, :sort_order)")
+                    .arg(kPlaylistTable));
+    query.bindValue(QStringLiteral(":id"), playlistId);
+    query.bindValue(QStringLiteral(":mount_point"), pState->drive.mountPoint);
+    query.bindValue(QStringLiteral(":sort_order"),
+            static_cast<int>(driveIndex) * kSortOrderPerDrive + listIndex);
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+    }
+    if (!trackIds.isEmpty()) {
+        playlistDao.appendTracksToPlaylist(trackIds, playlistId);
+    }
+    // Import only: the list is a copy of what is on the drive
+    playlistDao.setPlaylistLocked(playlistId, true);
+    if (trackIds.size() != playlist.locations.size()) {
+        qInfo() << "USB import: playlist" << playlist.name << "has"
+                << playlist.locations.size() - trackIds.size()
+                << "tracks that are not in the library";
+    }
+}
+
+void UsbLibraryImporter::applyAnalysisResults(int driveIndex, int maxMillis) {
+    DriveState* pState = m_states[driveIndex].get();
+    const std::shared_ptr<AnalysisJob> pJob = pState->pJob;
+    if (!pJob) {
+        return;
+    }
+    QElapsedTimer timer;
+    timer.start();
+    AnalysisJob::Result result;
+    while (timer.elapsed() < maxMillis && pJob->takeResult(&result)) {
+        if (pState->applied.contains(result.key)) {
+            continue; // loaded into a player meanwhile
+        }
+        pState->applied.insert(result.key);
+        const TrackId trackId = pState->trackIds.value(result.key);
+        if (!trackId.isValid()) {
+            continue;
+        }
+        const TrackPointer pTrack = m_pTrackCollectionManager->getTrackById(trackId);
+        if (!pTrack) {
+            continue;
+        }
+        applyToTrack(pTrack, result.track, result.analysis);
+        pState->appliedCount++;
+        // The track is saved when pTrack is released and it is not used
+        // elsewhere.
+    }
+    if (pJob->isDone()) {
+        qInfo() << "USB import: applied the rekordbox data of"
+                << pState->appliedCount << "tracks of" << pState->drive.mountPoint;
+        pState->pJob.reset();
+    }
+}
+
+void UsbLibraryImporter::applyBeforeLoad(const TrackPointer& pTrack) {
+    const QString location = pTrack->getLocation();
+    for (const auto& pState : std::as_const(m_states)) {
+        if (!pState->present || !isOnDrive(location, pState->drive.mountPoint)) {
+            continue;
+        }
+        const QString key = locationKey(location);
+        if (pState->applied.contains(key)) {
+            return;
+        }
+        if (!pState->pIndex) {
+            // Applied as soon as the drive has been read
+            qInfo() << "USB import: track loaded before the drive has been read:"
+                    << location;
+            pState->loadedBeforeIndex.insert(key, location);
+            return;
+        }
+        applyNow(pState.get(), pTrack, key);
+        return;
+    }
+}
+
+void UsbLibraryImporter::applyNow(
+        DriveState* pState, const TrackPointer& pTrack, const QString& key) {
+    pState->applied.insert(key);
+    const auto it = pState->pIndex->rekordboxTracks.constFind(key);
+    if (it == pState->pIndex->rekordboxTracks.constEnd()) {
+        return; // not in the rekordbox export
+    }
+    const rekordbox::ExportTrack& track = it.value();
+    qInfo() << "USB import: applying rekordbox data before loading" << track.location;
+    const rekordbox::Analysis analysis = rekordbox::readAnalysis(
+            track.anlzPath, rekordbox::timingOffsetMillis(track.location), true);
+    applyToTrack(pTrack, track, analysis);
+}
+
+void UsbLibraryImporter::applyToTrack(const TrackPointer& pTrack,
+        const rekordbox::ExportTrack& exportTrack,
+        const rekordbox::Analysis& analysis) {
+    const auto pStructure = rekordbox::applyAnalysis(
+            pTrack, analysis, rekordbox::ApplyMode::Replace);
+    if (pStructure) {
+        const auto pOldStructure = pTrack->getStructure();
+        if (!pOldStructure || pOldStructure->toByteArray() != pStructure->toByteArray()) {
+            pTrack->setStructure(pStructure);
+            if (pTrack->getId().isValid()) {
+                m_pTrackCollectionManager->internalCollection()
+                        ->getAnalysisDAO()
+                        .saveTrackStructure(pTrack->getId(), pStructure);
+            }
+        }
+    }
+
+    // Normalized like RekordboxPlaylistModel::getTrack() does
+    if (!exportTrack.key.isEmpty()) {
+        const Keys keys = KeyFactory::makeBasicKeysNormalized(
+                exportTrack.key, mixxx::track::io::key::USER);
+        if (keys.getGlobalKey() != mixxx::track::io::key::INVALID &&
+                keys.getGlobalKey() != pTrack->getKeys().getGlobalKey()) {
+            pTrack->setKeys(keys);
+        }
+    }
+
+    const mixxx::RgbColor::optional_t color = exportTrack.colorId != 0
+            ? mixxx::RgbColor::optional(rekordbox::colorFromId(exportTrack.colorId))
+            : mixxx::RgbColor::nullopt();
+    if (pTrack->getColor() != color) {
+        pTrack->setColor(color);
+    }
+}
+
+QSet<int> UsbLibraryImporter::deletePlaylists(const QString& mountPoint) {
+    QSet<int> playlistIds;
+    QSqlQuery query(database());
+    query.prepare(QStringLiteral("SELECT playlist_id FROM %1 WHERE mount_point = :mount_point")
+                    .arg(kPlaylistTable));
+    query.bindValue(QStringLiteral(":mount_point"), mountPoint);
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+        return playlistIds;
+    }
+    while (query.next()) {
+        playlistIds.insert(query.value(0).toInt());
+    }
+    if (playlistIds.isEmpty()) {
+        return playlistIds;
+    }
+
+    PlaylistDAO& playlistDao = m_pTrackCollectionManager->internalCollection()->getPlaylistDAO();
+    {
+        // The sidebar is rebuilt once (playlistsChanged())
+        const QSignalBlocker blocker(&playlistDao);
+        for (const int playlistId : std::as_const(playlistIds)) {
+            playlistDao.deletePlaylist(playlistId);
+        }
+    }
+    query.prepare(QStringLiteral("DELETE FROM %1 WHERE mount_point = :mount_point")
+                    .arg(kPlaylistTable));
+    query.bindValue(QStringLiteral(":mount_point"), mountPoint);
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+    }
+    qInfo() << "USB import: deleted" << playlistIds.size() << "playlists of" << mountPoint;
+    return playlistIds;
+}
+
+void UsbLibraryImporter::cancelJob(DriveState* pState) {
+    if (!pState->pJob) {
+        return;
+    }
+    pState->pJob->canceled = true;
+    pState->pJob->notFull.wakeAll();
+    pState->pJob.reset();
+}
+
+void UsbLibraryImporter::updateQueueTimer() {
+    bool hasWork = false;
+    for (const auto& pState : std::as_const(m_states)) {
+        if (pState->present && pState->importStarted &&
+                (pState->nextPlaylist >= 0 || pState->pJob)) {
+            hasWork = true;
+            break;
+        }
+    }
+    if (hasWork && !m_queueTimer.isActive()) {
+        m_queueTimer.start();
+    } else if (!hasWork && m_queueTimer.isActive()) {
+        m_queueTimer.stop();
+    }
+}
+
+} // namespace usbimport
+} // namespace mixxx
diff --git a/src/library/usbimport/usblibraryimporter.h b/src/library/usbimport/usblibraryimporter.h
new file mode 100644
index 00000000..dd69614f
--- /dev/null
+++ b/src/library/usbimport/usblibraryimporter.h
@@ -0,0 +1,147 @@
+#pragma once
+
+// DecksmithOS: "transparent layers" for USB drives prepared in rekordbox or
+// Serato.
+//
+// Enabled by the environment variable DECKSMITHOS_USB_IMPORT, a colon
+// separated list of mount points ("/usb:/usb2"); without it Mixxx behaves
+// exactly as upstream. The mount points are library root directories, so the
+// audio files of a drive are scanned into the normal library.
+//
+// When a drive appears (a file system other than "/" is mounted at the mount
+// point, polled every 2 s):
+//  1. A library rescan is requested, so the files of the drive are in the
+//     library.
+//  2. In the background, export.pdb (rekordbox) and the Serato crates are
+//     read (phase 1, "drive index").
+//  3. When both are done, the rekordbox playlists and the Serato crates
+//     become locked Mixxx playlists named "USB ▸ Folder ▸ Playlist", listed at
+//     the top of the Playlists section in rekordbox/Serato order. The
+//     rekordbox analysis (beat grid, hot cues, memory cues, loops, phrases,
+//     key, color) of every track of the export is read in the background
+//     (phase 2) and applied to the library track in the GUI thread, in small
+//     batches. rekordbox always wins over existing Mixxx data.
+//  4. A track of the drive that is loaded into a player before the
+//     background import reached it gets its rekordbox data applied right
+//     before loading (beforeTrackLoad()).
+// When the drive disappears its playlists are deleted. Playlists of drives
+// are also deleted at startup and when a drive appears, so they never get
+// stale.
+//
+// Nothing is ever written to the drive.
+//
+// The playlists that belong to a drive are recorded in the table
+// decksmithos_usb_playlists (playlist id, mount point, sort order), which
+// PlaylistFeature uses to list them first.
+
+#include <QHash>
+#include <QList>
+#include <QObject>
+#include <QSet>
+#include <QSqlDatabase>
+#include <QString>
+#include <QThreadPool>
+#include <QTimer>
+#include <memory>
+
+#include "library/rekordbox/rekordboxanalysis.h"
+#include "library/usbimport/usbimportutil.h"
+#include "track/track_decl.h"
+#include "track/trackid.h"
+
+class TrackCollectionManager;
+
+namespace mixxx {
+namespace usbimport {
+
+/// Table that records the playlists created for drives
+extern const QString kPlaylistTable;
+
+/// A playlist of a drive, before it is created in the library
+struct DrivePlaylist {
+    QString name;
+    QStringList locations; // absolute paths in list order
+};
+
+/// What is read from a drive in phase 1
+struct DriveIndex {
+    /// rekordbox tracks by locationKey()
+    QHash<QString, rekordbox::ExportTrack> rekordboxTracks;
+    /// rekordbox tracks in export order (for phase 2)
+    QList<rekordbox::ExportTrack> rekordboxTrackList;
+    /// rekordbox playlists, then Serato crates, in their order
+    QList<DrivePlaylist> playlists;
+};
+
+/// Reads a drive (rekordbox export and Serato crates). Runs in a worker
+/// thread.
+std::shared_ptr<const DriveIndex> readDriveIndex(const Drive& drive);
+
+class UsbLibraryImporter : public QObject {
+    Q_OBJECT
+  public:
+    /// True if DECKSMITHOS_USB_IMPORT is set
+    static bool isEnabled();
+
+    /// Creates kPlaylistTable if it does not exist
+    static bool ensureSchema(const QSqlDatabase& database);
+
+    /// Called right before a track is loaded into a player (GUI thread).
+    /// Applies the rekordbox data of a drive track that has not been
+    /// imported in this session. No-op if the import is disabled.
+    static void beforeTrackLoad(const TrackPointer& pTrack);
+
+    UsbLibraryImporter(QObject* parent, TrackCollectionManager* pTrackCollectionManager);
+    ~UsbLibraryImporter() override;
+
+    /// Deletes the playlists of all drives and starts watching the drives
+    void start();
+
+  signals:
+    /// Playlists of drives were created or deleted. The ids are the ones of
+    /// the deleted playlists (empty if playlists were only created).
+    void playlistsChanged(const QSet<int>& removedPlaylistIds);
+
+  private slots:
+    void slotPoll();
+    void slotLibraryScanStarted();
+    void slotLibraryScanFinished();
+    void slotProcessQueue();
+
+  private:
+    struct AnalysisJob;
+    struct DriveState;
+
+    void driveAppeared(int driveIndex);
+    void driveRemoved(int driveIndex);
+    void driveIndexRead(int driveIndex,
+            quint64 generation,
+            std::shared_ptr<const DriveIndex> pIndex);
+    void requestLibraryScan();
+    void maybeStartImport(int driveIndex);
+    void createPlaylist(int driveIndex, int listIndex);
+    void applyAnalysisResults(int driveIndex, int maxMillis);
+    void applyBeforeLoad(const TrackPointer& pTrack);
+    void applyNow(DriveState* pState, const TrackPointer& pTrack, const QString& key);
+    void applyToTrack(const TrackPointer& pTrack,
+            const rekordbox::ExportTrack& exportTrack,
+            const rekordbox::Analysis& analysis);
+    QSet<int> deletePlaylists(const QString& mountPoint);
+    void cancelJob(DriveState* pState);
+    void updateQueueTimer();
+
+    QSqlDatabase database() const;
+
+    static UsbLibraryImporter* s_pInstance;
+
+    TrackCollectionManager* const m_pTrackCollectionManager;
+    DriveWatcher m_watcher;
+    QList<std::shared_ptr<DriveState>> m_states;
+    QTimer m_pollTimer;
+    QTimer m_queueTimer;
+    QThreadPool m_threadPool;
+    bool m_libraryScanRunning;
+};
+
+} // namespace usbimport
+} // namespace mixxx
