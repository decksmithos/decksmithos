+template<typename Base, typename T>
+inline bool instanceof (const T* ptr) {
+    return dynamic_cast<const Base*>(ptr) != nullptr;
+}
+
+QString fromUtf16LeString(const std::string& toConvert) {
+    // Kaitai uses std::string as single container for all string encodings.
+    return QTextCodec::codecForName("UTF-16LE")
+            ->toUnicode(toConvert.data(), static_cast<int>(toConvert.length()));
+}
+
+/// Cue color of an extended (PCO2) memory cue or loop. 0 means no color.
+mixxx::RgbColor::optional_t memoryCueColor(int colorId) {
+    if (colorId == 0) {
+        return mixxx::RgbColor::nullopt();
+    }
+    return colorFromId(colorId);
+}
+
+/// Time corrected by the timing offset. Ensure no offset times are less than 1
+int correctedMillis(uint32_t time, int timingOffset) {
+    const int millis = static_cast<int>(time) - timingOffset;
+    return millis < 1 ? 1 : millis;
+}
+
+/// Cue lists found in ANLZ files, kept separately for the legacy (PCOB) and
+/// the extended (PCO2) format: files usually contain both, and the extended
+/// one (with labels and colors) is preferred.
+struct CueLists {
+    bool hotCuesFound = false;
+    bool memoryCuesFound = false;
+    QList<AnalysisCue> hotCues;
+    QList<AnalysisCue> memoryCues;
+};
+
+template<typename Entry>
+void addCue(CueLists* pLists,
+        rekordbox_anlz_t::cue_list_type_t listType,
+        const Entry& entry,
+        int timingOffset,
+        const QString& label,
+        mixxx::RgbColor::optional_t color) {
+    AnalysisCue cue;
+    cue.startMillis = correctedMillis(entry.time(), timingOffset);
+    if (entry.type() == rekordbox_anlz_t::CUE_ENTRY_TYPE_LOOP) {
+        cue.endMillis = correctedMillis(entry.loop_time(), timingOffset);
+    }
+    cue.label = label;
+    cue.color = color;
+    switch (listType) {
+    case rekordbox_anlz_t::CUE_LIST_TYPE_MEMORY_CUES:
+        pLists->memoryCues.append(cue);
+        break;
+    case rekordbox_anlz_t::CUE_LIST_TYPE_HOT_CUES:
+        cue.hotCueIndex = static_cast<int>(entry.hot_cue()) - 1;
+        pLists->hotCues.append(cue);
+        break;
+    }
+}
+
+void markListFound(CueLists* pLists, rekordbox_anlz_t::cue_list_type_t listType) {
+    switch (listType) {
+    case rekordbox_anlz_t::CUE_LIST_TYPE_MEMORY_CUES:
+        pLists->memoryCuesFound = true;
+        break;
+    case rekordbox_anlz_t::CUE_LIST_TYPE_HOT_CUES:
+        pLists->hotCuesFound = true;
+        break;
+    }
+}
+
+void parseAnlzFile(const QString& anlzPath,
+        int timingOffset,
+        bool readBeatGrid,
+        bool readCues,
+        Analysis* pAnalysis,
+        CueLists* pLegacyCues,
+        CueLists* pExtendedCues) {
+    if (!QFile(anlzPath).exists()) {
+        return;
+    }
+
+    // Hold sandbox access for the ANLZ file while it is read.
+    mixxx::FileInfo anlzFileInfo(anlzPath);
+    const auto securityToken = Sandbox::openSecurityToken(&anlzFileInfo, true);
+    std::ifstream ifs(anlzPath.toStdString(), std::ifstream::binary);
+    try {
+        kaitai::kstream ks(&ifs);
+        rekordbox_anlz_t anlz = rekordbox_anlz_t(&ks);
+
+        for (const auto& section : *anlz.sections()) {
+            switch (section->fourcc()) {
+            case rekordbox_anlz_t::SECTION_TAGS_BEAT_GRID: {
+                if (!readBeatGrid) {
+                    break;
+                }
+                auto* beatGridTag =
+                        static_cast<rekordbox_anlz_t::beat_grid_tag_t*>(
+                                section->body());
+                pAnalysis->beatMillis.clear();
+                pAnalysis->beatNumbers.clear();
+                for (const auto& beat : *beatGridTag->beats()) {
+                    pAnalysis->beatMillis.append(
+                            correctedMillis(beat->time(), timingOffset));
+                    pAnalysis->beatNumbers.append(
+                            static_cast<int>(beat->beat_number()));
+                }
+            } break;
+            case rekordbox_anlz_t::SECTION_TAGS_CUES: {
+                if (!readCues) {
+                    break;
+                }
+                auto* cuesTag =
+                        static_cast<rekordbox_anlz_t::cue_tag_t*>(
+                                section->body());
+                markListFound(pLegacyCues, cuesTag->type());
+                for (const auto& cueEntry : *cuesTag->cues()) {
+                    addCue(pLegacyCues,
+                            cuesTag->type(),
+                            *cueEntry,
+                            timingOffset,
+                            QString(),
+                            mixxx::RgbColor::nullopt());
+                }
+            } break;
+            case rekordbox_anlz_t::SECTION_TAGS_CUES_2: {
+                if (!readCues) {
+                    break;
+                }
+                auto* cuesExtendedTag =
+                        static_cast<rekordbox_anlz_t::cue_extended_tag_t*>(
+                                section->body());
+                markListFound(pExtendedCues, cuesExtendedTag->type());
+                for (const auto& cueEntry : *cuesExtendedTag->cues()) {
+                    mixxx::RgbColor::optional_t color;
+                    if (cuesExtendedTag->type() == rekordbox_anlz_t::CUE_LIST_TYPE_HOT_CUES) {
+                        color = mixxx::RgbColor(qRgb(
+                                static_cast<int>(cueEntry->color_red()),
+                                static_cast<int>(cueEntry->color_green()),
+                                static_cast<int>(cueEntry->color_blue())));
+                    } else {
+                        color = memoryCueColor(static_cast<int>(cueEntry->color_id()));
+                    }
+                    addCue(pExtendedCues,
+                            cuesExtendedTag->type(),
+                            *cueEntry,
+                            timingOffset,
+                            fromUtf16BeString(cueEntry->comment()),
+                            color);
+                }
+            } break;
+            case rekordbox_anlz_t::SECTION_TAGS_SONG_STRUCTURE: {
+                auto* songStructureTag =
+                        static_cast<rekordbox_anlz_t::song_structure_tag_t*>(
+                                section->body());
+                const auto* pBody = songStructureTag->body();
+                if (!pBody || !pBody->entries()) {
+                    break;
+                }
+                pAnalysis->hasStructure = true;
+                pAnalysis->mood = pBody->mood();
+                pAnalysis->endBeat = pBody->end_beat();
+                pAnalysis->phrases.clear();
+                for (const auto& entry : *pBody->entries()) {
+                    int kindId = 0;
+                    switch (pBody->mood()) {
+                    case rekordbox_anlz_t::TRACK_MOOD_HIGH:
+                        kindId = static_cast<rekordbox_anlz_t::phrase_high_t*>(
+                                entry->kind())
+                                         ->id();
+                        break;
+                    case rekordbox_anlz_t::TRACK_MOOD_LOW:
+                        kindId = static_cast<rekordbox_anlz_t::phrase_low_t*>(
+                                entry->kind())
+                                         ->id();
+                        break;
+                    default: // the parser reads unknown moods as mid
+                        kindId = static_cast<rekordbox_anlz_t::phrase_mid_t*>(
+                                entry->kind())
+                                         ->id();
+                        break;
+                    }
+                    pAnalysis->phrases.append(
+                            {static_cast<int>(entry->beat()), kindId});
+                }
+            } break;
+            default:
+                break;
+            }
+        }
+    } catch (const std::exception& e) {
+        qWarning() << "Failed to read rekordbox analysis file" << anlzPath
+                   << ":" << e.what();
+    }
+}
