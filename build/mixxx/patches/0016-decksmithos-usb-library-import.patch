+TEST(UsbImportTest, FlattenPlaylistTree) {
+    QList<PlaylistTreeNode> nodes;
+    // Root: folder "B" (sort 1), playlist "A" (sort 0), playlist "C" (sort 2)
+    nodes.append({10, 0, 1, true, QStringLiteral("B")});
+    nodes.append({11, 0, 0, false, QStringLiteral("A")});
+    nodes.append({12, 0, 2, false, QStringLiteral("C")});
+    // In "B": sub folder "Sub" (sort 0) with "Deep", playlist "B2" (sort 1)
+    nodes.append({20, 10, 1, false, QStringLiteral("B2")});
+    nodes.append({21, 10, 0, true, QStringLiteral("Sub")});
+    nodes.append({30, 21, 0, false, QStringLiteral("Deep")});
+    // Empty folder
+    nodes.append({40, 0, 3, true, QStringLiteral("Empty")});
+
+    const QList<FlatPlaylist> flat = flattenPlaylistTree(nodes);
+    ASSERT_EQ(4, flat.size());
+    EXPECT_EQ(QStringList{QStringLiteral("A")}, flat[0].path);
+    EXPECT_EQ(11u, flat[0].id);
+    EXPECT_EQ((QStringList{QStringLiteral("B"), QStringLiteral("Sub"), QStringLiteral("Deep")}),
+            flat[1].path);
+    EXPECT_EQ((QStringList{QStringLiteral("B"), QStringLiteral("B2")}), flat[2].path);
+    EXPECT_EQ(QStringList{QStringLiteral("C")}, flat[3].path);
+}
