+TEST(UsbImportTest, SeratoCrateTrackOrder) {
+    const QStringList paths{QStringLiteral("Music/z.mp3"),
+            QStringLiteral("Music/a.mp3"),
+            QStringLiteral("Music/été.flac"),
+            QStringLiteral("Music/a.mp3")};
+    QByteArray data = seratoCrate(paths);
+    QBuffer buffer(&data);
+    buffer.open(QIODevice::ReadOnly);
+    bool ok = false;
+    EXPECT_EQ(paths, mixxx::serato::readCrateTrackPaths(&buffer, &ok));
+    EXPECT_TRUE(ok);
+
+    // Truncated: the complete tracks are returned
+    QByteArray truncated = data.left(data.size() - 3);
+    QBuffer truncatedBuffer(&truncated);
+    truncatedBuffer.open(QIODevice::ReadOnly);
+    EXPECT_EQ(paths.mid(0, 3), mixxx::serato::readCrateTrackPaths(&truncatedBuffer, &ok));
+    EXPECT_FALSE(ok);
+}
