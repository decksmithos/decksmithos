@@ -0,0 +1,124 @@
+#pragma once
+
+// Pure helpers of the DecksmithOS USB library import (see
+// usblibraryimporter.h). Kept free of database and GUI dependencies so they
+// can be unit tested.
+
+#include <QByteArray>
+#include <QList>
+#include <QMap>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+#include <functional>
+
+namespace mixxx {
+namespace usbimport {
+
+/// Environment variable with the colon separated mount points of the drives
+/// to import, e.g. "/usb:/usb2". The import is disabled if it is not set.
+extern const char* const kEnvVar;
+
+/// A configured import drive
+struct Drive {
+    QString mountPoint; // without trailing slash
+    QString label;      // "USB", "USB2", ...
+};
+
+/// The label of the n-th (0-based) configured drive: "USB" for the first
+/// one, "USB2", "USB3", ... for the others. It matches how DecksmithOS names
+/// the mount points /usb and /usb2.
+QString driveLabel(int index);
+
+/// Parses the value of kEnvVar. Empty entries and duplicates are skipped,
+/// trailing slashes are removed. The label follows the position in the list.
+QList<Drive> parseDriveList(const QString& value);
+
+/// Separator between the levels of flattened playlist names
+extern const QString kNameSeparator; // " ▸ "
+
+/// "USB ▸ Folder ▸ Playlist"
+QString playlistName(const QString& driveLabel, const QStringList& path);
+
+/// Key used to match file paths of rekordbox/Serato with the locations of the
+/// Mixxx library: Unicode NFC and case folded, because the drives are mostly
+/// FAT/exFAT (case insensitive) and prepared on macOS (NFD file names).
+QString locationKey(const QString& location);
+
+/// True if `location` lies on the drive mounted at `mountPoint`
+bool isOnDrive(const QString& location, const QString& mountPoint);
+
+/// Absolute location of a path relative to the drive root
+QString driveLocation(const QString& mountPoint, const QString& relativePath);
+
+/// A node of the rekordbox playlist tree
+struct PlaylistTreeNode {
+    quint32 id = 0;
+    quint32 parentId = 0; // 0 = root
+    quint32 sortOrder = 0;
+    bool isFolder = false;
+    QString name;
+};
+
+/// A playlist of a flattened playlist tree
+struct FlatPlaylist {
+    QStringList path; // folder names and the playlist name
+    quint32 id = 0;
+};
+
+/// Flattens the rekordbox playlist tree depth-first in rekordbox order
+/// (sort order of the siblings). Folders are not playlists themselves; they
+/// only contribute their name to the path.
+QList<FlatPlaylist> flattenPlaylistTree(const QList<PlaylistTreeNode>& nodes);
+
+/// Separator of the hierarchy levels in Serato crate names
+/// ("Parent%%Child.crate")
+extern const QString kSeratoCrateSeparator;
+
+/// The crate names listed in _Serato_/neworder.pref (the crate order of the
+/// Serato sidebar), in file order. Lines look like "[crate]Parent%%Child".
+/// The file is UTF-16 (with or without BOM); UTF-8 is accepted as well.
+QStringList parseSeratoNewOrder(const QByteArray& data);
+
+/// Orders crate names (file names without ".crate") like the Serato
+/// sidebar: first the crates listed in neworder.pref in that order, then all
+/// others depth-first, siblings sorted case-insensitively by name.
+QStringList orderSeratoCrates(const QStringList& crateNames, const QStringList& newOrder);
+
+/// "Parent%%Child" -> {"Parent", "Child"}
+QStringList seratoCratePath(const QString& crateName);
+
+/// Detects drives appearing and disappearing. The presence check is
+/// injectable for tests; in Mixxx it is isMountedFilesystem().
+class DriveWatcher {
+  public:
+    struct Change {
+        int driveIndex;
+        bool present;
+    };
+
+    DriveWatcher(QList<Drive> drives, std::function<bool(const QString&)> isPresent);
+
+    const QList<Drive>& drives() const {
+        return m_drives;
+    }
+    bool isPresent(int driveIndex) const {
+        return m_present.value(driveIndex, false);
+    }
+
+    /// Checks all drives and returns the ones whose presence changed since
+    /// the last call. Initially all drives are considered absent.
+    QList<Change> poll();
+
+  private:
+    const QList<Drive> m_drives;
+    const std::function<bool(const QString&)> m_isPresent;
+    QList<bool> m_present;
+};
+
+/// True if `path` is (inside) a mounted file system other than the root
+/// file system, i.e. a drive is mounted at the mount point `path`.
+bool isMountedFilesystem(const QString& path);
+
+} // namespace usbimport
+} // namespace mixxx
