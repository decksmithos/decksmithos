+TEST(UsbImportTest, DriveWatcher) {
+    QSet<QString> mounted;
+    DriveWatcher watcher(parseDriveList(QStringLiteral("/usb:/usb2")),
+            [&mounted](const QString& path) { return mounted.contains(path); });
+    EXPECT_TRUE(watcher.poll().isEmpty());
+
+    mounted.insert(QStringLiteral("/usb2"));
+    auto changes = watcher.poll();
+    ASSERT_EQ(1, changes.size());
+    EXPECT_EQ(1, changes[0].driveIndex);
+    EXPECT_TRUE(changes[0].present);
+    EXPECT_TRUE(watcher.isPresent(1));
+    EXPECT_FALSE(watcher.isPresent(0));
+    EXPECT_TRUE(watcher.poll().isEmpty());
+
+    mounted.insert(QStringLiteral("/usb"));
+    mounted.remove(QStringLiteral("/usb2"));
+    changes = watcher.poll();
+    ASSERT_EQ(2, changes.size());
+    EXPECT_EQ(0, changes[0].driveIndex);
+    EXPECT_TRUE(changes[0].present);
+    EXPECT_EQ(1, changes[1].driveIndex);
+    EXPECT_FALSE(changes[1].present);
+}
