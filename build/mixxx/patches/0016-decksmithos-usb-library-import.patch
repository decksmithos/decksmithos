+#include <algorithm>
+
+namespace mixxx {
+namespace usbimport {
+
+const char* const kEnvVar = "DECKSMITHOS_USB_IMPORT";
+
+const QString kNameSeparator = QStringLiteral(" ▸ ");
+
+const QString kSeratoCrateSeparator = QStringLiteral("%%");
+
+namespace {
+
+QString removeTrailingSlashes(QString path) {
+    while (path.size() > 1 && path.endsWith(QChar('/'))) {
+        path.chop(1);
+    }
+    return path;
+}
+
+/// Case-insensitive comparison of crate paths, level by level
+bool lessCratePath(const QStringList& a, const QStringList& b) {
+    const int count = std::min(a.size(), b.size());
+    for (int i = 0; i < count; ++i) {
+        const int result = a[i].compare(b[i], Qt::CaseInsensitive);
+        if (result != 0) {
+            return result < 0;
+        }
+        const int exactResult = a[i].compare(b[i], Qt::CaseSensitive);
+        if (exactResult != 0) {
+            return exactResult < 0;
+        }
+    }
+    // The parent before its children
+    return a.size() < b.size();
+}
+
+void flattenChildren(const QHash<quint32, QList<const PlaylistTreeNode*>>& children,
+        quint32 parentId,
+        const QStringList& parentPath,
+        QSet<quint32>* pVisited,
+        QList<FlatPlaylist>* pResult) {
+    const auto it = children.constFind(parentId);
+    if (it == children.constEnd()) {
+        return;
+    }
+    for (const PlaylistTreeNode* pNode : it.value()) {
+        if (pVisited->contains(pNode->id)) {
+            continue; // broken tree with a cycle
+        }
+        pVisited->insert(pNode->id);
+        const QStringList path = parentPath + QStringList{pNode->name};
+        if (pNode->isFolder) {
+            flattenChildren(children, pNode->id, path, pVisited, pResult);
+        } else {
+            pResult->append(FlatPlaylist{path, pNode->id});
+        }
+    }
+}
+
+} // anonymous namespace
+
+QString driveLabel(int index) {
+    if (index <= 0) {
+        return QStringLiteral("USB");
+    }
+    return QStringLiteral("USB") + QString::number(index + 1);
+}
+
+QList<Drive> parseDriveList(const QString& value) {
+    QList<Drive> drives;
+    QSet<QString> seen;
+    const QStringList entries = value.split(QChar(':'), Qt::SkipEmptyParts);
+    for (const QString& entry : entries) {
+        const QString mountPoint = removeTrailingSlashes(entry.trimmed());
+        if (mountPoint.isEmpty() || seen.contains(mountPoint)) {
+            continue;
+        }
+        seen.insert(mountPoint);
+        drives.append(Drive{mountPoint, driveLabel(static_cast<int>(drives.size()))});
+    }
+    return drives;
+}
+
+QString playlistName(const QString& driveLabel, const QStringList& path) {
+    return (QStringList{driveLabel} + path).join(kNameSeparator);
+}
+
+QString locationKey(const QString& location) {
+    return location.normalized(QString::NormalizationForm_C).toCaseFolded();
+}
+
+bool isOnDrive(const QString& location, const QString& mountPoint) {
+    return location.startsWith(mountPoint + QChar('/'));
+}
+
+QString driveLocation(const QString& mountPoint, const QString& relativePath) {
+    QString path = relativePath;
+    while (path.startsWith(QChar('/'))) {
+        path.remove(0, 1);
+    }
+    return mountPoint + QChar('/') + path;
+}
+
+QList<FlatPlaylist> flattenPlaylistTree(const QList<PlaylistTreeNode>& nodes) {
+    QHash<quint32, QList<const PlaylistTreeNode*>> children;
+    for (const auto& node : nodes) {
+        if (node.id == 0) {
+            continue;
+        }
+        children[node.parentId].append(&node);
+    }
+    for (auto& siblings : children) {
+        std::stable_sort(siblings.begin(),
+                siblings.end(),
+                [](const PlaylistTreeNode* a, const PlaylistTreeNode* b) {
+                    return a->sortOrder < b->sortOrder;
+                });
+    }
+    QList<FlatPlaylist> result;
+    QSet<quint32> visited;
+    flattenChildren(children, 0, QStringList(), &visited, &result);
+    return result;
+}
+
+QStringList parseSeratoNewOrder(const QByteArray& data) {
+    QString text;
+    if (data.startsWith("\xFE\xFF")) {
+        text = QTextCodec::codecForName("UTF-16BE")->toUnicode(data.mid(2));
+    } else if (data.startsWith("\xFF\xFE")) {
+        text = QTextCodec::codecForName("UTF-16LE")->toUnicode(data.mid(2));
+    } else if (data.size() >= 2 && data.at(0) == '\0' && data.at(1) != '\0') {
+        // UTF-16BE without BOM: "\0[\0c..."
+        text = QTextCodec::codecForName("UTF-16BE")->toUnicode(data);
+    } else if (data.size() >= 2 && data.at(0) != '\0' && data.at(1) == '\0') {
+        text = QTextCodec::codecForName("UTF-16LE")->toUnicode(data);
+    } else {
+        text = QString::fromUtf8(data);
+    }
+
+    const QString kCratePrefix = QStringLiteral("[crate]");
+    QStringList crates;
+    const QStringList lines = text.split(QRegularExpression(QStringLiteral("[\r\n]+")),
+            Qt::SkipEmptyParts);
+    for (const QString& rawLine : lines) {
+        const QString line = rawLine.trimmed();
+        if (line.startsWith(kCratePrefix, Qt::CaseInsensitive)) {
+            const QString name = line.mid(kCratePrefix.size()).trimmed();
+            if (!name.isEmpty() && !crates.contains(name)) {
+                crates.append(name);
+            }
+        }
+    }
+    return crates;
+}
+
+QStringList orderSeratoCrates(const QStringList& crateNames, const QStringList& newOrder) {
+    QStringList ordered;
+    QStringList remaining = crateNames;
+    for (const QString& name : newOrder) {
+        int index = remaining.indexOf(name);
+        if (index < 0) {
+            // Accept a different case (FAT file names)
+            for (int i = 0; i < remaining.size(); ++i) {
+                if (remaining[i].compare(name, Qt::CaseInsensitive) == 0) {
+                    index = i;
+                    break;
+                }
+            }
+        }
+        if (index >= 0) {
+            ordered.append(remaining.takeAt(index));
+        }
+    }
+    std::sort(remaining.begin(),
+            remaining.end(),
+            [](const QString& a, const QString& b) {
+                return lessCratePath(seratoCratePath(a), seratoCratePath(b));
+            });
+    return ordered + remaining;
+}
+
+QStringList seratoCratePath(const QString& crateName) {
+    return crateName.split(kSeratoCrateSeparator, Qt::SkipEmptyParts);
+}
+
+DriveWatcher::DriveWatcher(QList<Drive> drives,
+        std::function<bool(const QString&)> isPresent)
+        : m_drives(std::move(drives)),
+          m_isPresent(std::move(isPresent)) {
+    for (int i = 0; i < m_drives.size(); ++i) {
+        m_present.append(false);
+    }
+}
+
+QList<DriveWatcher::Change> DriveWatcher::poll() {
+    QList<Change> changes;
+    for (int i = 0; i < m_drives.size(); ++i) {
+        const bool present = m_isPresent(m_drives[i].mountPoint);
+        if (present != m_present[i]) {
+            m_present[i] = present;
+            changes.append(Change{i, present});
+        }
+    }
+    return changes;
+}
+
+bool isMountedFilesystem(const QString& path) {
+    if (!QFileInfo::exists(path)) {
+        return false;
+    }
+    const QStorageInfo storage(path);
+    return storage.isValid() && storage.isReady() &&
+            storage.rootPath() != QDir::rootPath();
+}
+
+} // namespace usbimport
+} // namespace mixxx
