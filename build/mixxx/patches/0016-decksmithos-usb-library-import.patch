+
+QByteArray serAtoField(const char* id, const QByteArray& data) {
+    QByteArray field(id, 4);
+    quint32 size = qToBigEndian<quint32>(static_cast<quint32>(data.size()));
+    field.append(reinterpret_cast<const char*>(&size), sizeof(size));
+    field.append(data);
+    return field;
+}
+
+QByteArray utf16be(const QString& text) {
+    QByteArray result;
+    for (const QChar c : text) {
+        result.append(static_cast<char>(c.unicode() >> 8));
+        result.append(static_cast<char>(c.unicode() & 0xFF));
+    }
+    return result;
+}
+
+QByteArray utf16le(const QString& text) {
+    QByteArray result;
+    for (const QChar c : text) {
+        result.append(static_cast<char>(c.unicode() & 0xFF));
+        result.append(static_cast<char>(c.unicode() >> 8));
+    }
+    return result;
+}
+
+QByteArray seratoCrate(const QStringList& paths) {
+    QByteArray crate = serAtoField("vrsn", utf16be(QStringLiteral("1.0/Serato ScratchLive Crate")));
+    // A column definition, ignored
+    crate.append(serAtoField("ovct",
+            serAtoField("tvcn", utf16be(QStringLiteral("song"))) +
+                    serAtoField("tvcw", utf16be(QStringLiteral("0")))));
+    for (const QString& path : paths) {
+        crate.append(serAtoField("otrk", serAtoField("ptrk", utf16be(path))));
+    }
+    return crate;
+}
+
+} // namespace
