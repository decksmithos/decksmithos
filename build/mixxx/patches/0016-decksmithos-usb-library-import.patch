-/// Position of a 1-based rekordbox beat number. Beats after the end of
-/// the grid are extrapolated with the last beat length.
-mixxx::audio::FramePos rekordboxBeatPosition(
-        const QVector<mixxx::audio::FramePos>& beats, int beat) {
-    const int index = beat - 1;
-    if (index < 0 || beats.isEmpty()) {
-        return {};
-    }
-    if (index < beats.size()) {
-        return beats[index];
-    }
-    if (beats.size() < 2) {
-        return {};
-    }
-    const double beatLength = beats.last() - beats[beats.size() - 2];
-    return beats.last() + beatLength * (index - beats.size() + 1);
-}
