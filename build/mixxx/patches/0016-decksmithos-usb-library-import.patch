+#pragma once
+
+// Reading of rekordbox USB exports (export.pdb and the ANLZ analysis files)
+// that is shared by RekordboxFeature (the Rekordbox sidebar section) and the
+// DecksmithOS USB library import (library/usbimport).
+//
+// This header deliberately does not include the Kaitai generated parsers, so
+// it can be used outside of mixxx-lib (e.g. by tests).
+
+#include <QHash>
+#include <QList>
+#include <QMap>
+#include <QString>
+#include <QVector>
+
+#include "track/track_decl.h"
+#include "track/trackstructure.h"
+#include "util/color/rgbcolor.h"
+
+namespace mixxx {
+namespace rekordbox {
+
+/// Returns the path of the export.pdb of a rekordbox prepared device, or an
+/// empty string if the device has none.
+QString findPdbPath(const QString& devicePath);
+
+/// The track/cue colors of the rekordbox color table (0 is "no color" and
+/// returns black, as RekordboxFeature always did).
+mixxx::RgbColor colorFromId(int colorId);
+
+/// Timing offset in milliseconds that is subtracted from all rekordbox times
+/// (beats, cues, loops) of this file. It accounts for the different MP3
+/// decoders, see https://github.com/mixxxdj/mixxx/pull/2119
+///
+/// Thread-safe (the mp3guessenc library is not, calls are serialized).
+int timingOffsetMillis(const QString& audioFilePath);
+
+/// A hot cue, memory cue or loop. All times are in milliseconds and already
+/// corrected by the timing offset.
+struct AnalysisCue {
+    int hotCueIndex = -1; // 0-based; -1 for memory cues and loops
+    int startMillis = 0;
+    int endMillis = -1; // -1 if this is not a loop
+    QString label;
+    mixxx::RgbColor::optional_t color;
+};
+
+/// Everything that is read from the ANLZ files of a track, still independent
+/// of the sample rate of the track (so it can be read in any thread).
+struct Analysis {
+    /// Beat grid (PQTZ)
+    QVector<int> beatMillis;
+    QVector<int> beatNumbers; // position in the bar, 1 to 4
+
+    /// True if a cue list (PCOB/PCO2) was found
+    bool cuesRead = false;
+    QList<AnalysisCue> hotCues;
+    QList<AnalysisCue> memoryCues; // memory cues and loops
+
+    /// Song structure (PSSI)
+    bool hasStructure = false;
+    int mood = 0;
+    int endBeat = 0;
+    struct PhraseEntry {
+        int beat; // 1-based index into the beat grid
+        int kindId;
+    };
+    QVector<PhraseEntry> phrases;
+};
+
+/// Reads the ANLZ files of a track. `anlzPath` is the path of the .DAT file;
+/// a .EXT file next to it is read as well if it exists: the beat grid is then
+/// taken from the .DAT file and the cues and phrases from the .EXT file.
+///
+/// `readBeatGridWithoutExt`: whether the beat grid is read from a .DAT file
+/// without a .EXT file. RekordboxFeature never did that.
+///
+/// Never throws, malformed files are logged and skipped.
+Analysis readAnalysis(const QString& anlzPath,
+        int timingOffsetMillis,
+        bool readBeatGridWithoutExt);
+
+enum class ApplyMode {
+    /// What RekordboxFeature does when a track is loaded from its view: set
+    /// the beats unless they are locked, update or add the hot cues by index
+    /// and keep all other cues.
+    Merge,
+    /// rekordbox always wins (like a CDJ): the beats are replaced even if
+    /// they are locked, and all hot cues and saved loops are replaced by the
+    /// ones from rekordbox if the analysis contains cue lists. Nothing is
+    /// changed (or marked dirty) if the track already has exactly this data.
+    Replace,
+};
+
+/// Applies the beat grid and the cues to the track. The memory cues follow
+/// RekordboxFeature: the first memory cue becomes the main cue, all other
+/// memory cues and loops become hot cues after the last rekordbox hot cue.
+///
+/// Returns the track structure (phrases, first downbeat) built from the
+/// analysis, or nullptr. It is not set on the track: the caller sets and
+/// stores it.
+mixxx::TrackStructurePointer applyAnalysis(
+        const TrackPointer& pTrack,
+        const Analysis& analysis,
+        ApplyMode mode);
+
+/// A track of export.pdb
+struct ExportTrack {
+    quint32 id = 0;
+    QString location;  // absolute path of the audio file
+    QString anlzPath;  // absolute path of the .DAT file
+    QString key;       // key text as shown by rekordbox
+    int colorId = 0;   // see colorFromId(), 0 = no color
+};
+
+/// A node of the playlist tree of export.pdb
+struct ExportPlaylistNode {
+    quint32 id = 0;
+    quint32 parentId = 0; // 0 = root
+    quint32 sortOrder = 0;
+    bool isFolder = false;
+    QString name;
+};
+
+/// The parts of export.pdb used by the USB library import.
+struct Export {
+    bool valid = false;
+    QList<ExportTrack> tracks;
+    QList<ExportPlaylistNode> playlistNodes;
+    /// playlist id -> (entry index -> track id)
+    QHash<quint32, QMap<quint32, quint32>> playlistEntries;
+};
+
+/// Reads export.pdb of a rekordbox prepared device mounted at `devicePath`.
+/// Never throws, returns an invalid Export if there is none or it is broken.
+Export readExport(const QString& devicePath);
+
+} // namespace rekordbox
+} // namespace mixxx
