+TEST(UsbImportTest, SeratoNewOrder) {
+    const QString text = QStringLiteral(
+            "[begin record]\n[crate]Zeta\n[end record]\n"
+            "[begin record]\r\n[crate]Alpha%%Child\r\n[end record]\r\n"
+            "[begin record]\n[crate]Alpha\n[end record]\n");
+    const QStringList expected{QStringLiteral("Zeta"),
+            QStringLiteral("Alpha%%Child"),
+            QStringLiteral("Alpha")};
+    EXPECT_EQ(expected, parseSeratoNewOrder(utf16be(text)));
+    EXPECT_EQ(expected, parseSeratoNewOrder(QByteArray("\xFE\xFF", 2) + utf16be(text)));
+    EXPECT_EQ(expected, parseSeratoNewOrder(QByteArray("\xFF\xFE", 2) + utf16le(text)));
+    EXPECT_EQ(expected, parseSeratoNewOrder(utf16le(text)));
+    EXPECT_EQ(expected, parseSeratoNewOrder(text.toUtf8()));
+    EXPECT_TRUE(parseSeratoNewOrder(QByteArray()).isEmpty());
+}
