+/// Beat grid (PQTZ) and song structure (PSSI) collected from the ANLZ files
+struct rekordbox_structure_t {
+    QVector<mixxx::audio::FramePos> beats;
+    QVector<int> beatNumbers; // position in the bar, 1 to 4
+    rekordbox_anlz_t::track_mood_t mood{};
+    int endBeat = 0;
+    QVector<Analysis::PhraseEntry> entries;
+};
+
+mixxx::TrackStructure::Phrase rekordboxPhrase(
+        rekordbox_anlz_t::track_mood_t mood, int kindId) {
+    using Kind = mixxx::TrackStructure::PhraseKind;
+    const auto phrase = [](Kind kind, int number = 0) {
+        return mixxx::TrackStructure::Phrase{{}, {}, kind, static_cast<quint8>(number)};
+    };
+    switch (mood) {
+    case rekordbox_anlz_t::TRACK_MOOD_HIGH:
+        switch (kindId) {
+        case rekordbox_anlz_t::MOOD_HIGH_PHRASE_INTRO:
+            return phrase(Kind::Intro);
+        case rekordbox_anlz_t::MOOD_HIGH_PHRASE_UP:
+            return phrase(Kind::Up);
+        case rekordbox_anlz_t::MOOD_HIGH_PHRASE_DOWN:
+            return phrase(Kind::Down);
+        case rekordbox_anlz_t::MOOD_HIGH_PHRASE_CHORUS:
+            return phrase(Kind::Chorus);
+        case rekordbox_anlz_t::MOOD_HIGH_PHRASE_OUTRO:
+            return phrase(Kind::Outro);
+        }
+        break;
+    case rekordbox_anlz_t::TRACK_MOOD_MID:
+        if (kindId >= rekordbox_anlz_t::MOOD_MID_PHRASE_VERSE_1 &&
+                kindId <= rekordbox_anlz_t::MOOD_MID_PHRASE_VERSE_6) {
+            return phrase(Kind::Verse,
+                    kindId - rekordbox_anlz_t::MOOD_MID_PHRASE_VERSE_1 + 1);
+        }
+        [[fallthrough]];
+    case rekordbox_anlz_t::TRACK_MOOD_LOW:
+        switch (kindId) {
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_INTRO:
+            return phrase(Kind::Intro);
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_VERSE_1:
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_VERSE_1B:
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_VERSE_1C:
+            return phrase(Kind::Verse, 1);
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_VERSE_2:
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_VERSE_2B:
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_VERSE_2C:
+            return phrase(Kind::Verse, 2);
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_BRIDGE:
+            return phrase(Kind::Bridge);
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_CHORUS:
+            return phrase(Kind::Chorus);
+        case rekordbox_anlz_t::MOOD_LOW_PHRASE_OUTRO:
+            return phrase(Kind::Outro);
+        }
+        break;
+    }
+    return phrase(Kind::Other);
+}
+
+/// Position of a 1-based rekordbox beat number. Beats after the end of
+/// the grid are extrapolated with the last beat length.
+mixxx::audio::FramePos rekordboxBeatPosition(
+        const QVector<mixxx::audio::FramePos>& beats, int beat) {
+    const int index = beat - 1;
+    if (index < 0 || beats.isEmpty()) {
+        return {};
+    }
+    if (index < beats.size()) {
+        return beats[index];
+    }
+    if (beats.size() < 2) {
+        return {};
+    }
+    const double beatLength = beats.last() - beats[beats.size() - 2];
+    return beats.last() + beatLength * (index - beats.size() + 1);
+}
+
+mixxx::TrackStructurePointer makeTrackStructure(const rekordbox_structure_t& data) {
+    mixxx::audio::FramePos firstDownbeat;
+    for (int i = 0; i < data.beatNumbers.size(); ++i) {
+        if (data.beatNumbers[i] == 1) {
+            firstDownbeat = data.beats[i];
+            break;
+        }
+    }
+    QVector<mixxx::TrackStructure::Phrase> phrases;
+    for (int i = 0; i < data.entries.size(); ++i) {
+        const int endBeat = i + 1 < data.entries.size()
+                ? data.entries[i + 1].beat
+                : data.endBeat;
+        auto phrase = rekordboxPhrase(data.mood, data.entries[i].kindId);
+        phrase.start = rekordboxBeatPosition(data.beats, data.entries[i].beat);
+        phrase.end = rekordboxBeatPosition(data.beats, endBeat);
+        if (!phrase.start.isValid() || !phrase.end.isValid() ||
+                phrase.end <= phrase.start) {
+            continue;
+        }
+        phrases.append(phrase);
+    }
+    if (phrases.isEmpty() && !firstDownbeat.isValid()) {
+        return nullptr;
+    }
+    mixxx::TrackStructure::Mood mood = mixxx::TrackStructure::Mood::Unknown;
+    if (!phrases.isEmpty()) {
+        switch (data.mood) {
+        case rekordbox_anlz_t::TRACK_MOOD_HIGH:
+            mood = mixxx::TrackStructure::Mood::High;
+            break;
+        case rekordbox_anlz_t::TRACK_MOOD_MID:
+            mood = mixxx::TrackStructure::Mood::Mid;
+            break;
+        case rekordbox_anlz_t::TRACK_MOOD_LOW:
+            mood = mixxx::TrackStructure::Mood::Low;
+            break;
+        }
+    }
+    // rekordbox only knows 4/4
+    return std::make_shared<const mixxx::TrackStructure>(
+            mood, std::move(phrases), firstDownbeat, 4);
+}
+
+/// A cue as it is set on the track
+struct CueSpec {
+    mixxx::CueType type = mixxx::CueType::HotCue;
+    int hotCue = -1;
+    mixxx::audio::FramePos start;
+    mixxx::audio::FramePos end;
+    QString label;
+    mixxx::RgbColor::optional_t color;
+};
+
+/// Hot cues and the main cue from rekordbox, as RekordboxFeature maps them:
+/// the first memory cue (in time) becomes the main cue, all other memory cues
+/// and loops become hot cues after the last rekordbox hot cue.
+void cueSpecs(const Analysis& analysis,
+        mixxx::audio::SampleRate sampleRate,
+        QList<CueSpec>* pHotCues,
+        std::optional<CueSpec>* pMainCue) {
+    const double sampleRateKhz = sampleRate / 1000.0;
+    const auto framePos = [sampleRateKhz](int millis) {
+        return mixxx::audio::FramePos(sampleRateKhz * static_cast<double>(millis));
+    };
+    int lastHotCueIndex = 0;
+    for (const auto& cue : analysis.hotCues) {
+        if (cue.hotCueIndex < 0) {
+            continue;
+        }
+        lastHotCueIndex = std::max(lastHotCueIndex, cue.hotCueIndex);
+        CueSpec spec;
+        spec.hotCue = cue.hotCueIndex;
+        spec.start = framePos(cue.startMillis);
+        if (cue.endMillis >= 0) {
+            spec.type = mixxx::CueType::Loop;
+            spec.end = framePos(cue.endMillis);
+        }
+        spec.label = cue.label;
+        spec.color = cue.color;
+        pHotCues->append(spec);
+    }
+
+    QList<AnalysisCue> memoryCues = analysis.memoryCues;
+    std::stable_sort(memoryCues.begin(),
+            memoryCues.end(),
+            [](const AnalysisCue& a, const AnalysisCue& b) {
+                return a.startMillis < b.startMillis;
+            });
+    for (const auto& cue : std::as_const(memoryCues)) {
+        CueSpec spec;
+        spec.start = framePos(cue.startMillis);
+        spec.label = cue.label;
+        spec.color = cue.color;
+        if (!pMainCue->has_value() && cue.endMillis < 0) {
+            spec.type = mixxx::CueType::MainCue;
+            *pMainCue = spec;
+            continue;
+        }
+        lastHotCueIndex++;
+        spec.hotCue = lastHotCueIndex;
+        if (cue.endMillis >= 0) {
+            spec.type = mixxx::CueType::Loop;
+            spec.end = framePos(cue.endMillis);
+        }
+        pHotCues->append(spec);
+    }
+
+    // Drop what Mixxx cannot show
+    pHotCues->erase(std::remove_if(pHotCues->begin(),
+                            pHotCues->end(),
+                            [](const CueSpec& spec) {
+                                return spec.hotCue >= kNumHotCues;
+                            }),
+            pHotCues->end());
+}
+
+/// Update or add a hot cue by index (RekordboxFeature behaviour)
+void setHotCue(const TrackPointer& pTrack, const CueSpec& spec) {
+    CuePointer pCue;
+    const QList<CuePointer> cuePoints = pTrack->getCuePoints();
+    for (const CuePointer& trackCue : cuePoints) {
+        if (trackCue->getHotCue() == spec.hotCue) {
+            pCue = trackCue;
+            break;
+        }
+    }
+    if (pCue) {
+        pCue->setStartAndEndPosition(spec.start, spec.end);
+    } else {
+        pCue = pTrack->createAndAddCue(
+                spec.type,
+                spec.hotCue,
+                spec.start,
+                spec.end);
+    }
+    pCue->setLabel(spec.label);
+    if (spec.color) {
+        pCue->setColor(*spec.color);
+    }
+}
+
+bool samePosition(mixxx::audio::FramePos a, mixxx::audio::FramePos b) {
+    if (!a.isValid() || !b.isValid()) {
+        return a.isValid() == b.isValid();
+    }
+    return std::abs(a.value() - b.value()) < 0.5;
+}
+
+mixxx::RgbColor cueColor(const CueSpec& spec) {
+    return spec.color.value_or(mixxx::PredefinedColorPalettes::kDefaultCueColor);
+}
+
+/// True if the hot cues and saved loops of the track are exactly `specs`
+bool hasHotCues(const TrackPointer& pTrack, QList<CueSpec> specs) {
+    QList<CuePointer> cues;
+    const QList<CuePointer> cuePoints = pTrack->getCuePoints();
+    for (const CuePointer& pCue : cuePoints) {
+        if (pCue->getType() == mixxx::CueType::HotCue ||
+                pCue->getType() == mixxx::CueType::Loop) {
+            cues.append(pCue);
+        }
+    }
+    if (cues.size() != specs.size()) {
+        return false;
+    }
+    for (const CuePointer& pCue : std::as_const(cues)) {
+        const auto it = std::find_if(specs.begin(),
+                specs.end(),
+                [&pCue](const CueSpec& spec) {
+                    return spec.hotCue == pCue->getHotCue();
+                });
+        if (it == specs.end() ||
+                it->type != pCue->getType() ||
+                !samePosition(it->start, pCue->getPosition()) ||
+                (it->type == mixxx::CueType::Loop &&
+                        !samePosition(it->end, pCue->getEndPosition())) ||
+                it->label != pCue->getLabel() ||
+                cueColor(*it) != pCue->getColor()) {
+            return false;
+        }
+        specs.erase(it);
+    }
+    return specs.isEmpty();
+}
+
+void replaceHotCues(const TrackPointer& pTrack, const QList<CueSpec>& specs) {
+    if (hasHotCues(pTrack, specs)) {
+        return;
+    }
+    pTrack->removeCuesOfType(mixxx::CueType::HotCue);
+    pTrack->removeCuesOfType(mixxx::CueType::Loop);
+    for (const auto& spec : specs) {
+        CuePointer pCue = pTrack->createAndAddCue(
+                spec.type,
+                spec.hotCue,
+                spec.start,
+                spec.end,
+                cueColor(spec));
+        pCue->setLabel(spec.label);
+    }
+}
+
+void setMainCue(const TrackPointer& pTrack, const CueSpec& spec, ApplyMode mode) {
+    if (mode == ApplyMode::Replace) {
+        const CuePointer pMainCue = pTrack->findCueByType(mixxx::CueType::MainCue);
+        if (pMainCue &&
+                samePosition(pTrack->getMainCuePosition(), spec.start) &&
+                pMainCue->getLabel() == spec.label &&
+                (!spec.color || *spec.color == pMainCue->getColor())) {
+            return;
+        }
+    }
+    pTrack->setMainCuePosition(spec.start);
+    CuePointer pMainCue = pTrack->findCueByType(mixxx::CueType::MainCue);
+    if (!pMainCue) {
+        return;
+    }
+    pMainCue->setLabel(spec.label);
+    if (spec.color) {
+        pMainCue->setColor(*spec.color);
+    }
+}
+
+void forEachRow(rekordbox_pdb_t& db,
+        rekordbox_pdb_t::page_type_t type,
+        const std::function<void(kaitai::kstruct*)>& callback) {
+    for (const auto& table : *db.tables()) {
+        if (table->type() != type) {
+            continue;
+        }
+        const uint16_t lastIndex = table->last_page()->index();
+        rekordbox_pdb_t::page_ref_t* currentRef = table->first_page();
+        while (true) {
+            rekordbox_pdb_t::page_t* page = currentRef->body();
+            if (page->is_data_page()) {
+                for (const auto& rowgroup : *page->row_groups()) {
+                    for (const auto& rowRef : *rowgroup->rows()) {
+                        if (rowRef->present()) {
+                            callback(rowRef->body());
+                        }
+                    }
+                }
+            }
+            if (currentRef->index() == lastIndex) {
+                break;
+            }
+            currentRef = page->next_page();
+        }
+    }
+}
+
+} // anonymous namespace
+
+QString getText(rekordbox_pdb_t::device_sql_string_t* deviceString) {
+    QString text;
+
+    if (instanceof <rekordbox_pdb_t::device_sql_short_ascii_t>(deviceString->body())) {
+        rekordbox_pdb_t::device_sql_short_ascii_t* shortAsciiString =
+                static_cast<rekordbox_pdb_t::device_sql_short_ascii_t*>(deviceString->body());
+        text = QString::fromStdString(shortAsciiString->text());
+    } else if (instanceof <rekordbox_pdb_t::device_sql_long_ascii_t>(deviceString->body())) {
+        rekordbox_pdb_t::device_sql_long_ascii_t* longAsciiString =
+                static_cast<rekordbox_pdb_t::device_sql_long_ascii_t*>(deviceString->body());
+        text = QString::fromStdString(longAsciiString->text());
+    } else if (instanceof <rekordbox_pdb_t::device_sql_long_utf16le_t>(deviceString->body())) {
+        rekordbox_pdb_t::device_sql_long_utf16le_t* longUtf16leString =
+                static_cast<rekordbox_pdb_t::device_sql_long_utf16le_t*>(deviceString->body());
+        text = fromUtf16LeString(longUtf16leString->text());
+    }
+
+    // Some strings read from Rekordbox *.PDB files contain random null characters
+    // which if not removed cause Mixxx to crash when attempting to read file paths
+    return text.remove(QChar('\x0'));
+}
+
+QString fromUtf16BeString(const std::string& toConvert) {
+    // Kaitai uses std::string as single container for all string encodings.
+    int length = static_cast<int>(toConvert.length()) - 2; // strip off trailing nullbyte
+    if (length <= 0) {
+        return QString();
+    }
+    return QTextCodec::codecForName("UTF-16BE")->toUnicode(toConvert.data(), length);
+}
+
+QString findPdbPath(const QString& devicePath) {
+    const QDir deviceDir(devicePath);
+    for (const auto& pdbPath : kPdbPaths) {
+        const QFileInfo pdbFileInfo(deviceDir.filePath(pdbPath));
+        if (pdbFileInfo.exists() && pdbFileInfo.isFile()) {
+            return pdbFileInfo.filePath();
+        }
+    }
+    return {};
+}
+
+mixxx::RgbColor colorFromId(int colorId) {
+    switch (static_cast<IDForColor>(colorId)) {
+    case IDForColor::Pink:
+        return kColorForIDPink;
+    case IDForColor::Red:
+        return kColorForIDRed;
+    case IDForColor::Orange:
+        return kColorForIDOrange;
+    case IDForColor::Yellow:
+        return kColorForIDYellow;
+    case IDForColor::Green:
+        return kColorForIDGreen;
+    case IDForColor::Aqua:
+        return kColorForIDAqua;
+    case IDForColor::Blue:
+        return kColorForIDBlue;
+    case IDForColor::Purple:
+        return kColorForIDPurple;
+    }
+    return kColorForIDNoColor;
+}
+
+int timingOffsetMillis(const QString& location) {
+    // The following code accounts for timing offsets required to
+    // correctly align timing information (cue points, loops, beatgrids)
+    // exported from Rekordbox. This is caused by different MP3
+    // decoders treating MP3s encoded in a variety of different cases
+    // differently. The mp3guessenc library is used to determine which
+    // case the MP3 is classified in. See the following PR for more
+    // detailed information:
+    // https://github.com/mixxxdj/mixxx/pull/2119
+
+    int timingOffset = 0;
+
+    if (location.endsWith(".mp3", Qt::CaseInsensitive)) {
+        int timingShiftCase;
+        {
+            const QMutexLocker lock(&s_mp3guessencMutex);
+            timingShiftCase = mp3guessenc_timing_shift_case(location.toStdString().c_str());
+        }
+
+        qDebug() << "Timing shift case:" << timingShiftCase << "for MP3 file:" << location;
+
+        switch (timingShiftCase) {
+#ifdef __COREAUDIO__
+        case EXIT_CODE_CASE_A:
+            timingOffset = 12;
+            break;
+        case EXIT_CODE_CASE_B:
+            timingOffset = 13;
+            break;
+        case EXIT_CODE_CASE_C:
+            timingOffset = 26;
+            break;
+        case EXIT_CODE_CASE_D:
+            timingOffset = 50;
+            break;
+#elif defined(__MAD__)
+        case EXIT_CODE_CASE_A:
+        case EXIT_CODE_CASE_D:
+            timingOffset = 26;
+            break;
+#elif defined(__FFMPEG__)
+        case EXIT_CODE_CASE_D:
+            timingOffset = 26;
+            break;
+#endif
+        }
+    }
+
+#ifdef __COREAUDIO__
+    if (location.toLower().endsWith(".m4a")) {
+        timingOffset = 48;
+    }
+#endif
+
+    return timingOffset;
+}
+
+Analysis readAnalysis(const QString& anlzPath,
+        int timingOffset,
+        bool readBeatGridWithoutExt) {
+    Analysis analysis;
+    if (anlzPath.isEmpty() || !QFile(anlzPath).exists()) {
+        return analysis;
+    }
+    qDebug() << "Rekordbox ANLZ path:" << anlzPath;
+
+    CueLists legacyCues;
+    CueLists extendedCues;
+    const QString anlzPathExt = anlzPath.left(anlzPath.length() - 3) + "EXT";
+    if (QFile(anlzPathExt).exists()) {
+        // Beatgrids appear to be only correct in legacy ANLZ file
+        parseAnlzFile(anlzPath,
+                timingOffset,
+                true,
+                false,
+                &analysis,
+                &legacyCues,
+                &extendedCues);
+        parseAnlzFile(anlzPathExt,
+                timingOffset,
+                false,
+                true,
+                &analysis,
+                &legacyCues,
+                &extendedCues);
+    } else {
+        parseAnlzFile(anlzPath,
+                timingOffset,
+                readBeatGridWithoutExt,
+                true,
+                &analysis,
+                &legacyCues,
+                &extendedCues);
+    }
+
+    // Files contain the same cue list in both formats, prefer the extended
+    // one (it has labels and colors) instead of importing both.
+    analysis.hotCues = extendedCues.hotCuesFound ? extendedCues.hotCues : legacyCues.hotCues;
+    analysis.memoryCues = extendedCues.memoryCuesFound
+            ? extendedCues.memoryCues
+            : legacyCues.memoryCues;
+    analysis.cuesRead = extendedCues.hotCuesFound || extendedCues.memoryCuesFound ||
+            legacyCues.hotCuesFound || legacyCues.memoryCuesFound;
+    return analysis;
+}
+
+mixxx::TrackStructurePointer applyAnalysis(
+        const TrackPointer& pTrack,
+        const Analysis& analysis,
+        ApplyMode mode) {
+    VERIFY_OR_DEBUG_ASSERT(pTrack) {
+        return nullptr;
+    }
+    const mixxx::audio::SampleRate sampleRate = pTrack->getSampleRate();
+    if (!sampleRate.isValid()) {
+        qWarning() << "Cannot apply rekordbox analysis without a sample rate:"
+                   << pTrack->getLocation();
+        return nullptr;
+    }
+    const double sampleRateKhz = sampleRate / 1000.0;
+
+    rekordbox_structure_t structure;
+    for (int millis : analysis.beatMillis) {
+        structure.beats.append(
+                mixxx::audio::FramePos(sampleRateKhz * static_cast<double>(millis)));
+    }
+    structure.beatNumbers = analysis.beatNumbers;
+    structure.mood = static_cast<rekordbox_anlz_t::track_mood_t>(analysis.mood);
+    structure.endBeat = analysis.endBeat;
+    structure.entries = analysis.phrases;
+
+    if (!structure.beats.isEmpty()) {
+        const auto pBeats = mixxx::Beats::fromBeatPositions(
+                sampleRate,
+                structure.beats,
+                mixxx::rekordboxconstants::beatsSubversion);
+        if (mode == ApplyMode::Merge) {
+            pTrack->trySetBeats(pBeats);
+        } else if (pBeats) {
+            const auto pOldBeats = pTrack->getBeats();
+            if (!pOldBeats || !(*pOldBeats == *pBeats)) {
+                if (pTrack->isBpmLocked()) {
+                    pTrack->setBpmLocked(false);
+                }
+                pTrack->trySetBeats(pBeats);
+            }
+        }
+    }
+
+    if (analysis.cuesRead) {
+        QList<CueSpec> hotCues;
+        std::optional<CueSpec> mainCue;
+        cueSpecs(analysis, sampleRate, &hotCues, &mainCue);
+        if (mode == ApplyMode::Merge) {
+            for (const auto& spec : std::as_const(hotCues)) {
+                setHotCue(pTrack, spec);
+            }
+        } else {
+            replaceHotCues(pTrack, hotCues);
+        }
+        if (mainCue) {
+            setMainCue(pTrack, *mainCue, mode);
+        }
+    }
+
+    return makeTrackStructure(structure);
+}
+
+Export readExport(const QString& devicePath) {
+    Export result;
+    const QString dbPath = findPdbPath(devicePath);
+    if (dbPath.isEmpty()) {
+        return result;
+    }
+    qInfo() << "Reading rekordbox export" << dbPath;
+
+    mixxx::FileInfo fileInfo(dbPath);
+    const auto securityToken = Sandbox::openSecurityToken(&fileInfo, true);
+    std::ifstream ifs(dbPath.toStdString(), std::ifstream::binary);
+    try {
+        kaitai::kstream ks(&ifs);
+        rekordbox_pdb_t db = rekordbox_pdb_t(&ks);
+
+        QHash<quint32, QString> keys;
+        forEachRow(db, rekordbox_pdb_t::PAGE_TYPE_KEYS, [&keys](kaitai::kstruct* pRow) {
+            auto* key = static_cast<rekordbox_pdb_t::key_row_t*>(pRow);
+            keys.insert(key->id(), getText(key->name()));
+        });
+        forEachRow(db,
+                rekordbox_pdb_t::PAGE_TYPE_TRACKS,
+                [&result, &keys, &devicePath](kaitai::kstruct* pRow) {
+                    auto* track = static_cast<rekordbox_pdb_t::track_row_t*>(pRow);
+                    ExportTrack exportTrack;
+                    exportTrack.id = track->id();
+                    exportTrack.location = devicePath + getText(track->file_path());
+                    exportTrack.anlzPath = devicePath + getText(track->analyze_path());
+                    exportTrack.key = keys.value(track->key_id());
+                    exportTrack.colorId = static_cast<int>(track->color_id());
+                    result.tracks.append(exportTrack);
+                });
+        forEachRow(db,
+                rekordbox_pdb_t::PAGE_TYPE_PLAYLIST_TREE,
+                [&result](kaitai::kstruct* pRow) {
+                    auto* node = static_cast<rekordbox_pdb_t::playlist_tree_row_t*>(pRow);
+                    ExportPlaylistNode exportNode;
+                    exportNode.id = node->id();
+                    exportNode.parentId = node->parent_id();
+                    exportNode.sortOrder = node->sort_order();
+                    exportNode.isFolder = node->is_folder();
+                    exportNode.name = getText(node->name());
+                    result.playlistNodes.append(exportNode);
+                });
+        forEachRow(db,
+                rekordbox_pdb_t::PAGE_TYPE_PLAYLIST_ENTRIES,
+                [&result](kaitai::kstruct* pRow) {
+                    auto* entry = static_cast<rekordbox_pdb_t::playlist_entry_row_t*>(pRow);
+                    result.playlistEntries[entry->playlist_id()].insert(
+                            entry->entry_index(), entry->track_id());
+                });
+        result.valid = true;
+    } catch (const std::exception& e) {
+        qWarning() << "Failed to read rekordbox export" << dbPath << ":" << e.what();
+        return Export();
+    }
+    qInfo() << "rekordbox export" << dbPath << "has" << result.tracks.size()
+            << "tracks and" << result.playlistNodes.size() << "playlists/folders";
+    return result;
+}
+
+} // namespace rekordbox
+} // namespace mixxx
