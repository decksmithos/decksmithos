+#include "library/serato/seratocrate.h"
+
+#include <QBuffer>
+#include <QByteArray>
+#include <QIODevice>
+#include <QTextCodec>
+#include <QtDebug>
+#include <QtEndian>
+
+namespace mixxx {
+namespace serato {
+
+namespace {
+
+// Serato database field IDs, see SeratoFeature
+constexpr quint32 kFieldVersion = 0x7672736e;   // vrsn
+constexpr quint32 kFieldTrack = 0x6f74726b;     // otrk
+constexpr quint32 kFieldTrackPath = 0x7074726b; // ptrk
+
+constexpr int kHeaderSize = 2 * sizeof(quint32);
+
+QString utf16beToQString(const QByteArray& data) {
+    return QTextCodec::codecForName("UTF-16BE")->toUnicode(data);
+}
+
+quint32 bytesToUInt32(const QByteArray& data, int offset) {
+    return qFromBigEndian<quint32>(data.constData() + offset);
+}
+
+/// Reads all fields of a device, calls `handleField` for each one.
+/// Returns false if the data ends in the middle of a field.
+template<typename Handler>
+bool readFields(QIODevice* pDevice, Handler handleField) {
+    QByteArray headerData = pDevice->read(kHeaderSize);
+    while (headerData.length() == kHeaderSize) {
+        const quint32 fieldId = bytesToUInt32(headerData, 0);
+        const quint32 fieldSize = bytesToUInt32(headerData, sizeof(quint32));
+        const QByteArray data = pDevice->read(fieldSize);
+        if (static_cast<quint32>(data.length()) != fieldSize) {
+            qWarning() << "Serato crate: failed to read" << fieldSize
+                       << "bytes for field" << headerData.left(sizeof(quint32));
+            return false;
+        }
+        handleField(fieldId, data);
+        headerData = pDevice->read(kHeaderSize);
+    }
+    if (headerData.length() != 0) {
+        qWarning() << "Serato crate: found" << headerData.length()
+                   << "extra bytes at the end";
+        return false;
+    }
+    return true;
+}
+
+QString parseCrateTrackPath(const QByteArray& trackData, bool* pOk) {
+    QByteArray data = trackData;
+    QBuffer buffer(&data);
+    buffer.open(QIODevice::ReadOnly);
+    QString location;
+    const bool ok = readFields(&buffer, [&location](quint32 fieldId, const QByteArray& fieldData) {
+        if (fieldId == kFieldTrackPath) {
+            location = utf16beToQString(fieldData);
+        }
+    });
+    if (!ok) {
+        *pOk = false;
+        return QString();
+    }
+    return location;
+}
+
+} // anonymous namespace
+
+QStringList readCrateTrackPaths(QIODevice* pDevice, bool* pOk) {
+    QStringList paths;
+    bool ok = true;
+    const bool complete = readFields(pDevice,
+            [&paths, &ok](quint32 fieldId, const QByteArray& data) {
+                switch (fieldId) {
+                case kFieldVersion:
+                    qDebug() << "Serato crate version:" << utf16beToQString(data);
+                    break;
+                case kFieldTrack: {
+                    const QString path = parseCrateTrackPath(data, &ok);
+                    if (!path.isEmpty()) {
+                        paths.append(path);
+                    }
+                } break;
+                default:
+                    // Column definitions etc.
+                    break;
+                }
+            });
+    if (pOk) {
+        *pOk = ok && complete;
+    }
+    return paths;
+}
+
+} // namespace serato
+} // namespace mixxx
