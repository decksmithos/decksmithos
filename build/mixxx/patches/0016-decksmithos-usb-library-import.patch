+class UsbImportApplyTest : public MixxxTest {
+  protected:
+    UsbImportApplyTest()
+            : m_pTrack(Track::newTemporary()) {
+        m_pTrack->setAudioProperties(
+                mixxx::audio::ChannelCount(2),
+                mixxx::audio::SampleRate(44100),
+                mixxx::audio::Bitrate(),
+                mixxx::Duration::fromSeconds(180));
+    }
+
+    static mixxx::rekordbox::Analysis analysis() {
+        mixxx::rekordbox::Analysis analysis;
+        // 120 BPM, starting at 100 ms
+        for (int i = 0; i < 64; ++i) {
+            analysis.beatMillis.append(100 + i * 500);
+            analysis.beatNumbers.append(i % 4 + 1);
+        }
+        analysis.cuesRead = true;
+        mixxx::rekordbox::AnalysisCue hotCue;
+        hotCue.hotCueIndex = 0;
+        hotCue.startMillis = 1000;
+        hotCue.label = QStringLiteral("Drop");
+        hotCue.color = mixxx::RgbColor(0xFF0000);
+        analysis.hotCues.append(hotCue);
+        mixxx::rekordbox::AnalysisCue hotLoop;
+        hotLoop.hotCueIndex = 2;
+        hotLoop.startMillis = 2000;
+        hotLoop.endMillis = 4000;
+        analysis.hotCues.append(hotLoop);
+        // Memory cues: the first one becomes the main cue, the loop a hot cue
+        // after the last hot cue
+        mixxx::rekordbox::AnalysisCue memoryLoop;
+        memoryLoop.startMillis = 8000;
+        memoryLoop.endMillis = 10000;
+        analysis.memoryCues.append(memoryLoop);
+        mixxx::rekordbox::AnalysisCue memoryCue;
+        memoryCue.startMillis = 500;
+        memoryCue.label = QStringLiteral("Start");
+        analysis.memoryCues.append(memoryCue);
+        return analysis;
+    }
+
+    QList<CuePointer> hotCues() const {
+        QList<CuePointer> cues;
+        for (const auto& pCue : m_pTrack->getCuePoints()) {
+            if (pCue->getHotCue() >= 0) {
+                cues.append(pCue);
+            }
+        }
+        std::sort(cues.begin(), cues.end(), [](const CuePointer& a, const CuePointer& b) {
+            return a->getHotCue() < b->getHotCue();
+        });
+        return cues;
+    }
+
+    TrackPointer m_pTrack;
+};
+
+TEST_F(UsbImportApplyTest, ReplaceWins) {
+    // Mixxx data that rekordbox replaces
+    m_pTrack->createAndAddCue(mixxx::CueType::HotCue,
+            5,
+            mixxx::audio::FramePos(1234),
+            mixxx::audio::kInvalidFramePos);
+    m_pTrack->trySetAndLockBeats(mixxx::Beats::fromConstTempo(
+            mixxx::audio::SampleRate(44100),
+            mixxx::audio::FramePos(0),
+            mixxx::Bpm(100)));
+    ASSERT_TRUE(m_pTrack->isBpmLocked());
+
+    const auto pStructure = mixxx::rekordbox::applyAnalysis(
+            m_pTrack, analysis(), mixxx::rekordbox::ApplyMode::Replace);
+
+    ASSERT_NE(nullptr, m_pTrack->getBeats());
+    EXPECT_NEAR(120.0, m_pTrack->getBeats()->getBpmInRange(
+                               mixxx::audio::kStartFramePos,
+                               mixxx::audio::FramePos(44100 * 30))
+                               .value(),
+            0.01);
+    EXPECT_FALSE(m_pTrack->isBpmLocked());
+
+    const QList<CuePointer> cues = hotCues();
+    ASSERT_EQ(3, cues.size());
+    EXPECT_EQ(0, cues[0]->getHotCue());
+    EXPECT_EQ(mixxx::CueType::HotCue, cues[0]->getType());
+    EXPECT_DOUBLE_EQ(44100.0, cues[0]->getPosition().value());
+    EXPECT_EQ(QStringLiteral("Drop"), cues[0]->getLabel());
+    EXPECT_EQ(mixxx::RgbColor(0xFF0000), cues[0]->getColor());
+    EXPECT_EQ(2, cues[1]->getHotCue());
+    EXPECT_EQ(mixxx::CueType::Loop, cues[1]->getType());
+    EXPECT_DOUBLE_EQ(44100.0 * 4, cues[1]->getEndPosition().value());
+    EXPECT_EQ(3, cues[2]->getHotCue());
+    EXPECT_EQ(mixxx::CueType::Loop, cues[2]->getType());
+    EXPECT_DOUBLE_EQ(44100.0 * 8, cues[2]->getPosition().value());
+
+    EXPECT_DOUBLE_EQ(44100.0 * 0.5, m_pTrack->getMainCuePosition().value());
+    EXPECT_EQ(QStringLiteral("Start"),
+            m_pTrack->findCueByType(mixxx::CueType::MainCue)->getLabel());
+
+    // The first downbeat
+    ASSERT_NE(nullptr, pStructure);
+    EXPECT_DOUBLE_EQ(44100.0 * 0.1, pStructure->firstDownbeat().value());
+
+    // Applying the same data again changes nothing
+    m_pTrack->markClean();
+    mixxx::rekordbox::applyAnalysis(
+            m_pTrack, analysis(), mixxx::rekordbox::ApplyMode::Replace);
+    EXPECT_FALSE(m_pTrack->isDirty());
+    EXPECT_EQ(3, hotCues().size());
+}
+
+TEST_F(UsbImportApplyTest, MergeKeepsOtherCues) {
+    m_pTrack->createAndAddCue(mixxx::CueType::HotCue,
+            5,
+            mixxx::audio::FramePos(1234),
+            mixxx::audio::kInvalidFramePos);
+    mixxx::rekordbox::applyAnalysis(
+            m_pTrack, analysis(), mixxx::rekordbox::ApplyMode::Merge);
+    const QList<CuePointer> cues = hotCues();
+    ASSERT_EQ(4, cues.size());
+    EXPECT_EQ(5, cues[3]->getHotCue());
+}
+
+TEST_F(UsbImportApplyTest, NoCuesKeepsCues) {
+    m_pTrack->createAndAddCue(mixxx::CueType::HotCue,
+            5,
+            mixxx::audio::FramePos(1234),
+            mixxx::audio::kInvalidFramePos);
+    mixxx::rekordbox::Analysis noCues = analysis();
+    noCues.cuesRead = false;
+    mixxx::rekordbox::applyAnalysis(
+            m_pTrack, noCues, mixxx::rekordbox::ApplyMode::Replace);
+    EXPECT_EQ(1, hotCues().size());
+}
