+TEST(UsbImportTest, SeratoCrateOrder) {
+    const QStringList crates{QStringLiteral("beta"),
+            QStringLiteral("Alpha%%Child"),
+            QStringLiteral("Alpha"),
+            QStringLiteral("Alpha B"),
+            QStringLiteral("Zeta"),
+            QStringLiteral("Gamma")};
+    // Without neworder.pref: depth-first, case-insensitive
+    EXPECT_EQ((QStringList{QStringLiteral("Alpha"),
+                      QStringLiteral("Alpha%%Child"),
+                      QStringLiteral("Alpha B"),
+                      QStringLiteral("beta"),
+                      QStringLiteral("Gamma"),
+                      QStringLiteral("Zeta")}),
+            orderSeratoCrates(crates, {}));
+    // neworder.pref first (unknown entries ignored, case-insensitive match),
+    // the rest after it
+    EXPECT_EQ((QStringList{QStringLiteral("Zeta"),
+                      QStringLiteral("Alpha"),
+                      QStringLiteral("beta"),
+                      QStringLiteral("Alpha%%Child"),
+                      QStringLiteral("Alpha B"),
+                      QStringLiteral("Gamma")}),
+            orderSeratoCrates(crates,
+                    {QStringLiteral("Zeta"),
+                            QStringLiteral("Deleted"),
+                            QStringLiteral("Alpha"),
+                            QStringLiteral("BETA")}));
+    EXPECT_EQ((QStringList{QStringLiteral("Alpha"), QStringLiteral("Child")}),
+            seratoCratePath(QStringLiteral("Alpha%%Child")));
+}
