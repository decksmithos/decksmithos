+
+std::optional<mixxx::Beats::ConstIterator> WaveformRenderBeat::firstDownbeat(
+        const TrackPointer& pTrack,
+        const mixxx::BeatsPointer& pBeats,
+        int* pBeatsPerBar) {
+    mixxx::audio::FramePos anchor;
+    *pBeatsPerBar = 4;
+    const mixxx::TrackStructurePointer pStructure = pTrack->getStructure();
+    if (pStructure && pStructure->firstDownbeat().isValid()) {
+        anchor = pStructure->firstDownbeat();
+        *pBeatsPerBar = pStructure->beatsPerBar();
+    } else if (m_downbeatFromIntroStart) {
+        const CuePointer pIntro = pTrack->findCueByType(mixxx::CueType::Intro);
+        if (pIntro) {
+            anchor = pIntro->getPosition();
+        }
+    }
+    if (!anchor.isValid()) {
+        return std::nullopt;
+    }
+    if (pBeats != m_pCachedBeats || anchor != m_cachedAnchor) {
+        m_pCachedBeats = pBeats;
+        m_cachedAnchor = anchor;
+        m_cachedDownbeat = std::nullopt;
+        const auto closestBeat = pBeats->findClosestBeat(anchor);
+        if (closestBeat.isValid()) {
+            const auto it = pBeats->iteratorFrom(closestBeat);
+            if (it != pBeats->cend()) {
+                m_cachedDownbeat = it;
+            }
+        }
+    }
+    return m_cachedDownbeat;
+}
