@@ -0,0 +1,88 @@
+#pragma once
+
+#include <QByteArray>
+#include <QColor>
+#include <QString>
+#include <QVector>
+#include <memory>
+
+#include "audio/frame.h"
+
+namespace mixxx {
+
+class TrackStructure;
+typedef std::shared_ptr<const TrackStructure> TrackStructurePointer;
+
+/// Song structure of a track: its phrases and the position of its first
+/// downbeat. Imported from rekordbox analysis files (PSSI and PQTZ tags).
+///
+/// DecksmithOS addition. It is stored as an analysis of its own type, so the
+/// library database schema and the beats format stay unchanged.
+class TrackStructure final {
+  public:
+    /// The mood rekordbox assigns to the whole track. It determines the
+    /// phrase names.
+    enum class Mood : quint8 {
+        Unknown = 0,
+        High = 1,
+        Mid = 2,
+        Low = 3,
+    };
+
+    /// Phrase names as rekordbox shows them.
+    enum class PhraseKind : quint8 {
+        Other = 0,
+        Intro = 1,
+        Verse = 2,
+        Bridge = 3,
+        Chorus = 4,
+        Up = 5,
+        Down = 6,
+        Outro = 7,
+    };
+
+    struct Phrase {
+        audio::FramePos start;
+        audio::FramePos end;
+        PhraseKind kind;
+        /// Verse number (1 to 6) for verses, otherwise 0
+        quint8 number;
+    };
+
+    TrackStructure(Mood mood,
+            QVector<Phrase> phrases,
+            audio::FramePos firstDownbeat,
+            int beatsPerBar);
+
+    Mood mood() const {
+        return m_mood;
+    }
+    const QVector<Phrase>& phrases() const {
+        return m_phrases;
+    }
+    /// The first beat of a bar, or invalid if unknown
+    audio::FramePos firstDownbeat() const {
+        return m_firstDownbeat;
+    }
+    int beatsPerBar() const {
+        return m_beatsPerBar;
+    }
+    bool isEmpty() const {
+        return m_phrases.isEmpty() && !m_firstDownbeat.isValid();
+    }
+
+    QByteArray toByteArray() const;
+    /// Returns nullptr if the data is not a valid track structure.
+    static TrackStructurePointer fromByteArray(const QByteArray& data);
+
+    static QColor phraseColor(PhraseKind kind);
+    static QString phraseLabel(const Phrase& phrase);
+
+  private:
+    Mood m_mood;
+    QVector<Phrase> m_phrases;
+    audio::FramePos m_firstDownbeat;
+    int m_beatsPerBar;
+};
+
+} // namespace mixxx
