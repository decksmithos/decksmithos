+mixxx::TrackStructurePointer AnalysisDao::loadTrackStructure(TrackId trackId) {
+    if (!trackId.isValid()) {
+        return nullptr;
+    }
+    const QList<AnalysisInfo> analyses =
+            getAnalysesForTrackByType(trackId, TYPE_DECKSMITHOS_TRACK_STRUCTURE);
+    for (const auto& analysis : analyses) {
+        auto pStructure = mixxx::TrackStructure::fromByteArray(analysis.data);
+        if (pStructure) {
+            return pStructure;
+        }
+    }
+    return nullptr;
+}
+
+bool AnalysisDao::saveTrackStructure(TrackId trackId,
+        const mixxx::TrackStructurePointer& pStructure) {
+    if (!trackId.isValid()) {
+        return false;
+    }
+    const QList<AnalysisInfo> analyses =
+            getAnalysesForTrackByType(trackId, TYPE_DECKSMITHOS_TRACK_STRUCTURE);
+    AnalysisInfo info;
+    for (const auto& analysis : analyses) {
+        if (info.analysisId == -1 && pStructure && !pStructure->isEmpty()) {
+            info.analysisId = analysis.analysisId;
+        } else {
+            deleteAnalysis(analysis.analysisId);
+        }
+    }
+    if (!pStructure || pStructure->isEmpty()) {
+        return true;
+    }
+    info.trackId = trackId;
+    info.type = TYPE_DECKSMITHOS_TRACK_STRUCTURE;
+    info.description = QStringLiteral("DecksmithOS track structure");
+    info.version = QStringLiteral("1");
+    info.data = pStructure->toByteArray();
+    return saveAnalysis(&info);
+}
