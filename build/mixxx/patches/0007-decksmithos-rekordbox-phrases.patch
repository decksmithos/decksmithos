new file mode 100644
index 00000000..d2776645
--- /dev/null
+++ b/src/track/trackstructure.cpp
@@ -0,0 +1,147 @@
+#include "track/trackstructure.h"
+
+#include <QDataStream>
+#include <QIODevice>
+
+#include "util/fpclassify.h"
+
+namespace mixxx {
+
+namespace {
+
+constexpr quint32 kMagic = 0x44535453; // "DSTS"
+constexpr quint16 kVersion = 1;
+constexpr int kMaxPhrases = 1024;
+
+// Not std::isfinite(): Mixxx is built with -ffast-math
+double framePosToDouble(audio::FramePos pos) {
+    return pos.isValid() ? pos.value() : audio::FramePos::kInvalidValue;
+}
+
+audio::FramePos framePosFromDouble(double value) {
+    return util_isfinite(value) ? audio::FramePos(value) : audio::FramePos();
+}
+
+} // namespace
+
+TrackStructure::TrackStructure(Mood mood,
+        QVector<Phrase> phrases,
+        audio::FramePos firstDownbeat,
+        int beatsPerBar)
+        : m_mood(mood),
+          m_phrases(std::move(phrases)),
+          m_firstDownbeat(firstDownbeat),
+          m_beatsPerBar(beatsPerBar > 0 ? beatsPerBar : 4) {
+}
+
+QByteArray TrackStructure::toByteArray() const {
+    QByteArray data;
+    QDataStream out(&data, QIODevice::WriteOnly);
+    out.setVersion(QDataStream::Qt_5_12);
+    out << kMagic << kVersion << static_cast<quint8>(m_mood)
+        << framePosToDouble(m_firstDownbeat)
+        << static_cast<qint32>(m_beatsPerBar)
+        << static_cast<qint32>(m_phrases.size());
+    for (const auto& phrase : m_phrases) {
+        out << framePosToDouble(phrase.start) << framePosToDouble(phrase.end)
+            << static_cast<quint8>(phrase.kind) << phrase.number;
+    }
+    return data;
+}
+
+// static
+TrackStructurePointer TrackStructure::fromByteArray(const QByteArray& data) {
+    QDataStream in(data);
+    in.setVersion(QDataStream::Qt_5_12);
+    quint32 magic = 0;
+    quint16 version = 0;
+    in >> magic >> version;
+    if (magic != kMagic || version != kVersion) {
+        return nullptr;
+    }
+    quint8 mood = 0;
+    double firstDownbeat = 0;
+    qint32 beatsPerBar = 0;
+    qint32 count = 0;
+    in >> mood >> firstDownbeat >> beatsPerBar >> count;
+    if (in.status() != QDataStream::Ok || count < 0 || count > kMaxPhrases) {
+        return nullptr;
+    }
+    QVector<Phrase> phrases;
+    phrases.reserve(count);
+    for (qint32 i = 0; i < count; ++i) {
+        double start = 0;
+        double end = 0;
+        quint8 kind = 0;
+        quint8 number = 0;
+        in >> start >> end >> kind >> number;
+        if (kind > static_cast<quint8>(PhraseKind::Outro)) {
+            kind = static_cast<quint8>(PhraseKind::Other);
+        }
+        phrases.append(Phrase{framePosFromDouble(start),
+                framePosFromDouble(end),
+                static_cast<PhraseKind>(kind),
+                number});
+    }
+    if (in.status() != QDataStream::Ok) {
+        return nullptr;
+    }
+    if (mood > static_cast<quint8>(Mood::Low)) {
+        mood = static_cast<quint8>(Mood::Unknown);
+    }
+    return std::make_shared<const TrackStructure>(static_cast<Mood>(mood),
+            std::move(phrases),
+            framePosFromDouble(firstDownbeat),
+            beatsPerBar);
+}
+
+// static
+QColor TrackStructure::phraseColor(PhraseKind kind) {
+    // Close to the colours of the rekordbox / CDJ phrase display.
+    switch (kind) {
+    case PhraseKind::Intro:
+        return QColor(0xe0, 0x30, 0x4a);
+    case PhraseKind::Verse:
+        return QColor(0x3a, 0x6e, 0xe8);
+    case PhraseKind::Bridge:
+        return QColor(0xe8, 0xb8, 0x20);
+    case PhraseKind::Chorus:
+        return QColor(0x50, 0xc8, 0x40);
+    case PhraseKind::Up:
+        return QColor(0xa0, 0x50, 0xf0);
+    case PhraseKind::Down:
+        return QColor(0x40, 0x48, 0xb0);
+    case PhraseKind::Outro:
+        return QColor(0x30, 0xa8, 0xd8);
+    case PhraseKind::Other:
+        break;
+    }
+    return QColor(0x80, 0x80, 0x80);
+}
+
+// static
+QString TrackStructure::phraseLabel(const Phrase& phrase) {
+    switch (phrase.kind) {
+    case PhraseKind::Intro:
+        return QStringLiteral("Intro");
+    case PhraseKind::Verse:
+        return phrase.number > 0
+                ? QStringLiteral("Verse %1").arg(phrase.number)
+                : QStringLiteral("Verse");
+    case PhraseKind::Bridge:
+        return QStringLiteral("Bridge");
+    case PhraseKind::Chorus:
+        return QStringLiteral("Chorus");
+    case PhraseKind::Up:
+        return QStringLiteral("Up");
+    case PhraseKind::Down:
+        return QStringLiteral("Down");
+    case PhraseKind::Outro:
+        return QStringLiteral("Outro");
+    case PhraseKind::Other:
+        break;
+    }
+    return QString();
+}
+
+} // namespace mixxx
