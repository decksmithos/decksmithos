index 00000000..13e0f01b
--- /dev/null
+++ b/src/test/trackstructuretest.cpp
@@ -0,0 +1,48 @@
+#include <gtest/gtest.h>
+
+#include "track/trackstructure.h"
+
+namespace {
+
+using mixxx::TrackStructure;
+using mixxx::audio::FramePos;
+
+TEST(TrackStructureTest, SerializationRoundTrip) {
+    const QVector<TrackStructure::Phrase> phrases{
+            {FramePos(1000), FramePos(50000), TrackStructure::PhraseKind::Intro, 0},
+            {FramePos(50000), FramePos(90000.5), TrackStructure::PhraseKind::Verse, 3},
+    };
+    const TrackStructure structure(
+            TrackStructure::Mood::Mid, phrases, FramePos(1000), 4);
+    const auto pLoaded = TrackStructure::fromByteArray(structure.toByteArray());
+    ASSERT_NE(nullptr, pLoaded);
+    EXPECT_EQ(TrackStructure::Mood::Mid, pLoaded->mood());
+    EXPECT_EQ(FramePos(1000), pLoaded->firstDownbeat());
+    EXPECT_EQ(4, pLoaded->beatsPerBar());
+    ASSERT_EQ(2, pLoaded->phrases().size());
+    EXPECT_EQ(FramePos(90000.5), pLoaded->phrases()[1].end);
+    EXPECT_EQ(TrackStructure::PhraseKind::Verse, pLoaded->phrases()[1].kind);
+    EXPECT_EQ(QStringLiteral("Verse 3"),
+            TrackStructure::phraseLabel(pLoaded->phrases()[1]));
+}
+
+TEST(TrackStructureTest, InvalidDownbeat) {
+    const TrackStructure structure(TrackStructure::Mood::Unknown, {}, FramePos(), 4);
+    const auto pLoaded = TrackStructure::fromByteArray(structure.toByteArray());
+    ASSERT_NE(nullptr, pLoaded);
+    EXPECT_FALSE(pLoaded->firstDownbeat().isValid());
+    EXPECT_TRUE(pLoaded->isEmpty());
+}
+
+TEST(TrackStructureTest, RejectsBadData) {
+    EXPECT_EQ(nullptr, TrackStructure::fromByteArray(QByteArray("garbage")));
+    const TrackStructure structure(TrackStructure::Mood::High,
+            {{FramePos(0), FramePos(10), TrackStructure::PhraseKind::Up, 0}},
+            FramePos(0),
+            4);
+    QByteArray data = structure.toByteArray();
+    data.chop(5);
+    EXPECT_EQ(nullptr, TrackStructure::fromByteArray(data));
+}
+
+} // namespace
