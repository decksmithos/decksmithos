+            m_waveformRenderer->getTruePosSample(positionType));
+    if (!playPosition.isValid()) {
+        return;
+    }
+    // The beat at or before the play position
+    auto it = pBeats->iteratorFrom(playPosition);
+    if (it == pBeats->cend()) {
+        return;
+    }
+    if (*it > playPosition) {
+        --it;
+    }
+    const int beatIndex = it - downbeat;
+    if (beatIndex < 0) {
+        return; // before the first bar
+    }
+    const QString text = QStringLiteral("%1.%2").arg(
+            QString::number(beatIndex / beatsPerBar + 1),
+            QString::number(beatIndex % beatsPerBar + 1));
+
+    m_digitsRenderer.updateTexture(
+            WaveformWidgetFactory::instance()->getUntilMarkTextPointSize(),
+            std::roundf(m_waveformRenderer->getBreadth() * 0.33f),
+            m_waveformRenderer->getDevicePixelRatio());
+    const float markerX = static_cast<float>(
+            m_waveformRenderer->getPlayMarkerPosition() * m_waveformRenderer->getLength());
+    m_digitsRenderer.draw(matrix, markerX + 6.f, 0.f, text);
 }
 
