+namespace {
+/// DecksmithOS: an outro that ends in the first tenth of a track is the
+/// result of a failed analysis (a file the decoder could not read: intro,
+/// outro and last sound all at 0), not a real outro; treated as not set, so
+/// that Auto DJ does not leave such a track after a few seconds.
+constexpr double kMinOutroEndFraction = 0.1;
+
+bool isImplausibleOutro(mixxx::audio::FramePos outroStart,
+        mixxx::audio::FramePos outroEnd,
+        mixxx::audio::FramePos trackEnd) {
+    if (!trackEnd.isValid() || trackEnd.value() <= 0) {
+        return false;
+    }
+    const auto end = outroEnd.isValid() ? outroEnd : outroStart;
+    return end.isValid() && end.value() < kMinOutroEndFraction * trackEnd.value();
+}
+} // namespace
