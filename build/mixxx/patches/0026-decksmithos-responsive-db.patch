+void TrackDAO::addTracksCommitBatch() {
+    constexpr int kBatchTracks = 50;
+    constexpr qint64 kBatchMillis = 500;
+    if (!m_pTransaction) {
+        return;
+    }
+    ++m_batchTracks;
+    if (m_batchTracks < kBatchTracks && m_batchTimer.elapsed() < kBatchMillis) {
+        return;
+    }
+    m_pTransaction->commit();
+    m_pTransaction = std::make_unique<SqlTransaction>(m_database);
+    m_batchTracks = 0;
+    m_batchTimer.start();
+    if (!m_tracksAddedSet.isEmpty()) {
+        emit tracksAdded(m_tracksAddedSet);
+        m_tracksAddedSet.clear();
+    }
+}
