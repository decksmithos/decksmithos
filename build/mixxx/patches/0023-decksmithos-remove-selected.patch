Description: Remove or hide the selected tracks from a control
 [Library],remove_selected: the selected tracks out of the Auto DJ queue,
 playlist or crate shown, or hidden from the library in views without a
 remove action (Tracks), as the track menu's "Remove"/"Hide" and its
 shortcut do, but without the confirmation dialog (the skin or controller
 asks for a second press instead). For a touch screen without context
 menus. Locked playlists and crates and views without either action
 (Browse, Rekordbox, Serato) are left unchanged.
Author: DecksmithOS
Forwarded: no
Last-Update: 2026-11-24
---
diff --git a/src/library/librarycontrol.cpp b/src/library/librarycontrol.cpp
index 4c301ee9..b08ad9e2 100644
--- a/src/library/librarycontrol.cpp
+++ b/src/library/librarycontrol.cpp
@@ -310,6 +310,21 @@ LibraryControl::LibraryControl(Library* pLibrary)
                 &LibraryControl::slotAutoDjAddAllBottom);
     }
 
+    // DecksmithOS: the selected tracks out of the Auto DJ queue, playlist or
+    // crate shown, or hidden from the library (Tracks), without a dialog
+    // (the skin or controller asks for a second press instead)
+    m_pRemoveSelected = std::make_unique<ControlPushButton>(
+            ConfigKey("[Library]", "remove_selected"));
+#ifdef MIXXX_USE_QML
+    if (!CmdlineArgs::Instance().isQml())
+#endif
+    {
+        connect(m_pRemoveSelected.get(),
+                &ControlPushButton::valueChanged,
+                this,
+                &LibraryControl::slotRemoveSelected);
+    }
+
     // Sort controls
     m_pSortColumn = std::make_unique<ControlEncoder>(ConfigKey("[Library]", "sort_column"));
     m_pSortOrder = std::make_unique<ControlPushButton>(ConfigKey("[Library]", "sort_order"));
@@ -705,6 +720,17 @@ void LibraryControl::slotAutoDjAddAllBottom(double v) {
     }
 }
 
+void LibraryControl::slotRemoveSelected(double v) {
+    if (!m_pLibraryWidget || v <= 0) {
+        return;
+    }
+
+    WTrackTableView* pTrackTableView = m_pLibraryWidget->getCurrentTrackTableView();
+    if (pTrackTableView) {
+        pTrackTableView->hideOrRemoveSelectedTracks(false);
+    }
+}
