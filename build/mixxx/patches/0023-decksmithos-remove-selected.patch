+namespace {
+/// DecksmithOS: counts changes of the selected tracks or of the list shown
+/// ([Library],selection_changes, read only; the skin bridge disarms REMOVE)
+void countSelectionChange() {
+    ControlObject* pChanges = ControlObject::getControl(
+            ConfigKey(QStringLiteral("[Library]"), QStringLiteral("selection_changes")),
+            ControlFlag::NoWarnIfMissing);
+    if (pChanges) {
+        pChanges->forceSet(pChanges->get() + 1);
+    }
+}
