@@ -0,0 +1,45 @@
+#pragma once
+
+#include <QFrame>
+#include <QPointer>
+
+class QWidget;
+
+/// DecksmithOS: an on-screen keyboard for a touch screen without a physical
+/// keyboard, enabled by DECKSMITHOS_TOUCH_KEYBOARD. A panel across the bottom
+/// of a window; its keys never take the focus and send key events to the
+/// target widget (letters, digits, space, Backspace, Return), plus CLEAR.
+///  - The library search box (WSearchLineEdit) shows its own keyboard while
+///    it has the focus (Return = SEARCH, CLEAR = clear the search).
+///  - installFocusFilter() shows one for any other editable QLineEdit that
+///    gets the focus (preferences, renaming, cell editors), in its window.
+/// Style it with WTouchKeyboard / #TouchKeyboardKey.
+class WTouchKeyboard : public QFrame {
+    Q_OBJECT
+  public:
+    /// A keyboard at the bottom of `pWindow` (a top-level widget)
+    WTouchKeyboard(QWidget* pWindow, const QString& returnLabel);
+
+    static bool isEnabled();
+    /// Once per application, if enabled
+    static void installFocusFilter();
+
+    void showFor(QWidget* pTarget);
+    QWidget* target() const {
+        return m_pTarget;
+    }
+
+  signals:
+    /// CLEAR on a target that is not a QLineEdit
+    void clearRequested();
+
+  protected:
+    bool eventFilter(QObject* pObject, QEvent* pEvent) override;
+
+  private:
+    void sendKey(int key, const QString& text);
+    void clearTarget();
+    void place();
+
+    QPointer<QWidget> m_pTarget;
+};
