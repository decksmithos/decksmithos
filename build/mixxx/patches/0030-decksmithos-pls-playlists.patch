+QStringList parsePls(const QByteArray& data,
+        const QString& plsDirectory,
+        const QString& mountPoint) {
+    static const QRegularExpression kFileLine(
+            QStringLiteral("^\\s*File(\\d+)\\s*=\\s*(.*?)\\s*$"),
+            QRegularExpression::CaseInsensitiveOption);
+    static const QRegularExpression kWindowsDrive(QStringLiteral("^[A-Za-z]:/"));
+    QMap<int, QString> files;
+    const QStringList lines = QString::fromUtf8(data).split(QChar('\n'));
+    for (const QString& line : lines) {
+        const QRegularExpressionMatch match = kFileLine.match(line);
+        if (!match.hasMatch()) {
+            continue;
+        }
+        QString path = match.captured(2);
+        if (path.isEmpty()) {
+            continue;
+        }
+        if (path.startsWith(QStringLiteral("file:"), Qt::CaseInsensitive)) {
+            path = QUrl(path).toLocalFile();
+        }
+        path.replace(QChar('\\'), QChar('/'));
+        QString location;
+        if (kWindowsDrive.match(path).hasMatch()) {
+            location = QDir(mountPoint).filePath(path.mid(3));
+        } else if (path.startsWith(QChar('/'))) {
+            location = path.startsWith(mountPoint + QChar('/'))
+                    ? path
+                    : QDir(mountPoint).filePath(path.mid(1));
+        } else {
+            location = QDir(plsDirectory).filePath(path);
+        }
+        files.insert(match.captured(1).toInt(), QDir::cleanPath(location));
+    }
+    return files.values();
+}
+
 } // namespace usbimport
 } // namespace mixxx
