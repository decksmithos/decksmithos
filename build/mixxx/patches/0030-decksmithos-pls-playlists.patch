+/// DecksmithOS: PLS playlists in the root of the drive and in a folder
+/// "playlists" there (any case), by name
+void readPls(const Drive& drive, DriveIndex* pIndex) {
+    const QDir root(drive.mountPoint);
+    QList<QDir> directories{root};
+    const QStringList subdirectories = root.entryList(QDir::Dirs | QDir::NoDotAndDotDot);
+    for (const QString& name : subdirectories) {
+        if (name.compare(QStringLiteral("playlists"), Qt::CaseInsensitive) == 0) {
+            directories.append(QDir(root.filePath(name)));
+        }
+    }
+    int count = 0;
+    for (const QDir& directory : std::as_const(directories)) {
+        const QStringList files = directory.entryList(QDir::Files, QDir::Name | QDir::IgnoreCase);
+        for (const QString& fileName : files) {
+            if (!fileName.endsWith(QStringLiteral(".pls"), Qt::CaseInsensitive)) {
+                continue;
+            }
+            QFile file(directory.filePath(fileName));
+            if (!file.open(QIODevice::ReadOnly)) {
+                qWarning() << "USB import: cannot open" << file.fileName();
+                continue;
+            }
+            DrivePlaylist playlist;
+            playlist.name = playlistName(drive.label,
+                    QStringList{QFileInfo(fileName).completeBaseName()});
+            playlist.locations = parsePls(
+                    file.readAll(), directory.absolutePath(), drive.mountPoint);
+            pIndex->playlists.append(playlist);
+            ++count;
+        }
+    }
+    if (count > 0) {
+        qInfo() << "USB import:" << drive.mountPoint << "has" << count << "PLS playlists";
+    }
+}
