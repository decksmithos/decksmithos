+void AutoDJProcessor::updateBeatsToBar(DeckAttributes* pDeck, double playPosition) {
+    constexpr int kBeatsPerBar = 4;
+    if (pDeck->index < 0 || pDeck->index >= static_cast<int>(m_beatsToBar.size())) {
+        return;
+    }
+    double value = 0;
+    const TrackPointer pTrack = pDeck->getLoadedTrack();
+    const mixxx::BeatsPointer pBeats = pTrack ? pTrack->getBeats() : nullptr;
+    const mixxx::audio::FramePos trackEnd = pDeck->trackEndPosition();
+    if (pBeats && trackEnd.isValid()) {
+        // Bars counted from the first phrase, else the first downbeat,
+        // else the first beat
+        mixxx::audio::FramePos anchor;
+        const mixxx::TrackStructurePointer pStructure = pTrack->getStructure();
+        if (pStructure && !pStructure->phrases().isEmpty()) {
+            anchor = pStructure->phrases().first().start;
+        }
+        if (!anchor.isValid() && pStructure) {
+            anchor = pStructure->firstDownbeat();
+        }
+        if (!anchor.isValid()) {
+            anchor = pBeats->firstBeat();
+        }
+        const mixxx::audio::FramePos position(playPosition * trackEnd.value());
+        mixxx::audio::FramePos prev;
+        mixxx::audio::FramePos next;
+        if (anchor.isValid() && position.isValid() &&
+                pBeats->findPrevNextBeats(position, &prev, &next, false) && next > prev) {
+            const double fraction = (position - prev) / (next - prev);
+            if (m_barCounts.size() < m_beatsToBar.size()) {
+                m_barCounts.resize(m_beatsToBar.size());
+            }
+            BarCount& count = m_barCounts[pDeck->index];
+            if (count.pBeats != pBeats || count.anchor != anchor || !count.beat.isValid() ||
+                    prev < count.beat) {
+                count.pBeats = pBeats;
+                count.anchor = anchor;
+                count.beat = prev;
+                count.beats = prev >= anchor ? pBeats->numBeatsInRange(anchor, prev)
+                                             : -pBeats->numBeatsInRange(prev, anchor);
+            } else if (prev > count.beat) {
+                count.beats += pBeats->numBeatsInRange(count.beat, prev);
+                count.beat = prev;
+            }
+            const double beats = count.beats + fraction;
+            double inBar = std::fmod(beats, static_cast<double>(kBeatsPerBar));
+            if (inBar < 0) {
+                inBar += kBeatsPerBar;
+            }
+            value = kBeatsPerBar - inBar;
+        }
+    }
+    m_beatsToBar[pDeck->index]->forceSet(value);
+}
