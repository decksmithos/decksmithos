     // The user has either reconfigured devices or accepted no outputs,
     // so it's now safe to write the new config to disk.
-    m_pCoreServices->getSoundManager()->getConfig().writeToDisk();
+    // DecksmithOS: not when Mixxx started without its output device (no
+    // controller plugged in yet): that would replace the configured device
+    // with an empty configuration on disk.
+    if (!noSoundDialogs ||
+            !m_pCoreServices->getSoundManager()->getConfig().getOutputs().isEmpty()) {
+        m_pCoreServices->getSoundManager()->getConfig().writeToDisk();
+    }
+
+    // DecksmithOS: sound and controller hotplug. Mixxx 2.5 opens sound devices
+    // and controllers only at start-up; an appliance must pick up a controller
+    // (USB audio + MIDI) plugged in later, or unplugged and plugged in again,
+    // without a restart. With DECKSMITHOS_SOUND_HOTPLUG_HOOK set, the list of
+    // ALSA cards is checked every second; when it changes, the hook (which
+    // writes soundconfig.xml for the controller) runs, the sound devices are
+    // queried again and set up from soundconfig.xml, and the controllers are
+    // enumerated again. Lines "DECKSMITHOS_<NAME>=<value>" printed by the hook
+    // are set in Mixxx's environment first (the ALSA configuration selects the
+    // card through DECKSMITHOS_ALSA_CARD). Not while the preferences are open
+    // (their pages hold the old device lists); retried once they are closed.
+    const QString hotplugHook = qEnvironmentVariable("DECKSMITHOS_SOUND_HOTPLUG_HOOK");
+    if (!hotplugHook.isEmpty()) {
+        const auto readCards = []() {
+            QFile cards(QStringLiteral("/proc/asound/cards"));
+            return cards.open(QIODevice::ReadOnly) ? QString::fromUtf8(cards.readAll()) : QString();
+        };
+        auto pLastCards = std::make_shared<QString>(readCards());
+        auto* pHotplugTimer = new QTimer(this);
+        connect(pHotplugTimer,
+                &QTimer::timeout,
+                this,
+                [this, pLastCards, readCards, hotplugHook]() {
+                    const QString cards = readCards();
+                    if (cards == *pLastCards) {
+                        return;
+                    }
+                    if (m_pPrefDlg && m_pPrefDlg->isVisible()) {
+                        return;
+                    }
+                    *pLastCards = cards;
+                    qInfo() << "DecksmithOS: audio devices changed; setting up sound and controllers again";
+                    QProcess hook;
+                    hook.setProcessChannelMode(QProcess::SeparateChannels);
+                    hook.start(hotplugHook, QStringList());
+                    if (hook.waitForFinished(5000)) {
+                        const QStringList lines = QString::fromUtf8(hook.readAllStandardOutput())
+                                                          .split(QChar('\n'), Qt::SkipEmptyParts);
+                        for (const QString& line : lines) {
+                            const int eq = line.indexOf(QChar('='));
+                            if (eq > 0 && line.startsWith(QStringLiteral("DECKSMITHOS_"))) {
+                                qputenv(line.left(eq).toUtf8().constData(),
+                                        line.mid(eq + 1).trimmed().toUtf8());
+                                qInfo() << "DecksmithOS:" << line.trimmed();
+                            }
+                        }
+                    } else {
+                        qWarning() << "DecksmithOS: hotplug hook did not finish:" << hotplugHook;
+                        hook.kill();
+                    }
+                    auto pSoundManager = m_pCoreServices->getSoundManager();
+                    pSoundManager->clearAndQueryDevices();
+                    SoundManagerConfig config = pSoundManager->getConfig();
+                    if (config.readFromDisk() && !config.getOutputs().isEmpty()) {
+                        const SoundDeviceStatus status = pSoundManager->setConfig(config);
+                        qInfo() << "DecksmithOS: sound devices set up, status"
+                                << static_cast<int>(status);
+                    } else {
+                        qInfo() << "DecksmithOS: the configured output device is not present";
+                    }
+                    m_pCoreServices->getControllerManager()->setUpDevices();
+                });
+        pHotplugTimer->start(1000);
+    }
 
