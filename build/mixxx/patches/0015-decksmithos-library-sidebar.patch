+void Library::addFeaturesToSidebar() {
+    m_pSidebarUp = std::make_unique<ControlPushButton>(
+            ConfigKey(kLibraryGroup, QStringLiteral("sidebar_up")));
+    connect(m_pSidebarUp.get(), &ControlObject::valueChanged, this, [this](double value) {
+        if (value <= 0 || !m_pSidebarWidget) {
+            return;
+        }
+        const QModelIndex parent = m_pSidebarWidget->currentIndex().parent();
+        if (parent.isValid()) {
+            m_pSidebarWidget->selectIndex(parent);
+            m_pSidebarModel->clicked(parent);
+        }
+    });
+    m_pSidebarAtTop = std::make_unique<ControlObject>(
+            ConfigKey(kLibraryGroup, QStringLiteral("sidebar_at_top")));
+    m_pSidebarAtTop->setReadOnly();
+    m_pSidebarAtTop->forceSet(1.0);
+
+    const QStringList hidden = configList(m_pConfig, kSidebarHiddenKey);
+    const QList<LibraryFeature*> features =
+            orderedFeatures(m_features, configList(m_pConfig, kSidebarOrderKey));
+    for (LibraryFeature* pFeature : features) {
+        if (!hidden.contains(pFeature->iconName())) {
+            m_pSidebarModel->addLibraryFeature(pFeature);
+            addShowFeatureControl(pFeature);
+        }
+    }
+    m_pSidebarModel->setFeatureLabels(configLabels(m_pConfig));
+    m_bSidebarDeferred = false;
+}
+
+void Library::addShowFeatureControl(LibraryFeature* pFeature) {
+    auto pControl = std::make_unique<ControlPushButton>(
+            ConfigKey(kLibraryGroup, QStringLiteral("show_") + pFeature->iconName()));
+    connect(pControl.get(),
+            &ControlObject::valueChanged,
+            this,
+            [this, pFeature](double value) {
+                if (value > 0) {
+                    m_pSidebarModel->slotFeatureSelect(pFeature);
+                    pFeature->activate();
+                }
+            });
+    m_showFeatureControls.push_back(std::move(pControl));
+
+    auto pActive = std::make_unique<ControlObject>(
+            ConfigKey(kLibraryGroup, QStringLiteral("active_") + pFeature->iconName()));
+    pActive->setReadOnly();
+    m_activeFeatureControls.insert(pFeature, pActive.get());
+    m_activeControlsOwner.push_back(std::move(pActive));
+    // A feature shows its root page or one of its lists
+    connect(pFeature, &LibraryFeature::switchToView, this, [this, pFeature]() {
+        setActiveFeature(pFeature);
+    });
+    connect(pFeature, &LibraryFeature::showTrackModel, this, [this, pFeature]() {
+        setActiveFeature(pFeature);
+    });
+}
+
+void Library::setActiveFeature(LibraryFeature* pFeature) {
+    for (auto it = m_activeFeatureControls.constBegin();
+            it != m_activeFeatureControls.constEnd();
+            ++it) {
+        it.value()->forceSet(it.key() == pFeature ? 1.0 : 0.0);
+    }
+}
+
+QList<Library::SidebarEntry> Library::sidebarEntries(bool mixxxDefaults) const {
+    const QStringList hidden =
+            mixxxDefaults ? QStringList() : configList(m_pConfig, kSidebarHiddenKey);
+    const QHash<QString, QString> labels =
+            mixxxDefaults ? QHash<QString, QString>() : configLabels(m_pConfig);
+    const QStringList order =
+            mixxxDefaults ? QStringList() : configList(m_pConfig, kSidebarOrderKey);
+    QList<SidebarEntry> entries;
+    for (LibraryFeature* pFeature : orderedFeatures(m_features, order)) {
+        const QString key = pFeature->iconName();
+        entries.append(SidebarEntry{key,
+                pFeature->title().toString(),
+                labels.value(key),
+                !hidden.contains(key)});
+    }
+    return entries;
+}
+
+void Library::saveSidebarEntries(const QList<SidebarEntry>& entries) {
+    QStringList order;
+    QStringList hidden;
+    QStringList labels;
+    for (const SidebarEntry& entry : entries) {
+        order.append(entry.key);
+        if (!entry.visible) {
+            hidden.append(entry.key);
+        }
+        const QString label = entry.label.trimmed().remove(QChar(';'));
+        if (!label.isEmpty() && label != entry.title) {
+            labels.append(entry.key + QChar('=') + label);
+        }
+    }
+    m_pConfig->setValue(kSidebarOrderKey, order.join(QChar(',')));
+    m_pConfig->setValue(kSidebarHiddenKey, hidden.join(QChar(',')));
+    m_pConfig->setValue(kSidebarLabelsKey, labels.join(QChar(';')));
+    // Labels apply at once; order and visibility at the next start
+    m_pSidebarModel->setFeatureLabels(configLabels(m_pConfig));
 }
 
