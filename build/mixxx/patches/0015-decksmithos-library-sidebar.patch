+void DlgPrefLibrary::setupSidebarEditor() {
+    auto* pGroup = new QGroupBox(tr("Sidebar"), this);
+    auto* pLayout = new QVBoxLayout(pGroup);
+    auto* pHint = new QLabel(
+            tr("Order, show and rename the library sections. Tick to show; "
+               "double-tap a name to rename it. The order and hidden sections "
+               "apply when Mixxx starts again, names at once."),
+            pGroup);
+    pHint->setWordWrap(true);
+    pLayout->addWidget(pHint);
+    auto* pRow = new QHBoxLayout();
+    m_pSidebarList = new QListWidget(pGroup);
+    m_pSidebarList->setDragDropMode(QAbstractItemView::InternalMove);
+    m_pSidebarList->setEditTriggers(
+            QAbstractItemView::DoubleClicked | QAbstractItemView::EditKeyPressed);
+    m_pSidebarList->setMinimumHeight(260);
+    pRow->addWidget(m_pSidebarList, 1);
+    auto* pButtons = new QVBoxLayout();
+    auto* pUp = new QPushButton(tr("Up"), pGroup);
+    auto* pDown = new QPushButton(tr("Down"), pGroup);
+    connect(pUp, &QPushButton::clicked, this, [this]() {
+        moveSidebarItem(-1);
+    });
+    connect(pDown, &QPushButton::clicked, this, [this]() {
+        moveSidebarItem(1);
+    });
+    pButtons->addWidget(pUp);
+    pButtons->addWidget(pDown);
+    pButtons->addStretch(1);
+    pRow->addLayout(pButtons);
+    pLayout->addLayout(pRow);
+    // After the music directories
+    verticalLayout->insertWidget(1, pGroup);
+}
+
+void DlgPrefLibrary::populateSidebarList(bool mixxxDefaults) {
+    m_pSidebarList->clear();
+    for (const auto& entry : m_pLibrary->sidebarEntries(mixxxDefaults)) {
+        auto* pItem = new QListWidgetItem(
+                entry.label.isEmpty() ? entry.title : entry.label, m_pSidebarList);
+        pItem->setData(Qt::UserRole, entry.key);
+        pItem->setData(Qt::UserRole + 1, entry.title);
+        pItem->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable |
+                Qt::ItemIsUserCheckable | Qt::ItemIsEditable | Qt::ItemIsDragEnabled);
+        pItem->setCheckState(entry.visible ? Qt::Checked : Qt::Unchecked);
+    }
+}
+
+void DlgPrefLibrary::moveSidebarItem(int delta) {
+    const int row = m_pSidebarList->currentRow();
+    const int newRow = row + delta;
+    if (row < 0 || newRow < 0 || newRow >= m_pSidebarList->count()) {
+        return;
+    }
+    QListWidgetItem* pItem = m_pSidebarList->takeItem(row);
+    m_pSidebarList->insertItem(newRow, pItem);
+    m_pSidebarList->setCurrentRow(newRow);
+}
