+const QString kLibraryGroup = QStringLiteral("[Library]");
+const ConfigKey kSidebarOrderKey = ConfigKey(kLibraryGroup, QStringLiteral("SidebarOrder"));
+const ConfigKey kSidebarHiddenKey = ConfigKey(kLibraryGroup, QStringLiteral("SidebarHidden"));
+const ConfigKey kSidebarLabelsKey = ConfigKey(kLibraryGroup, QStringLiteral("SidebarLabels"));
+
+QStringList configList(const UserSettingsPointer& pConfig, const ConfigKey& key) {
+    QStringList items;
+    const QStringList parts = pConfig->getValueString(key).split(QChar(','), Qt::SkipEmptyParts);
+    for (const QString& part : parts) {
+        items.append(part.trimmed());
+    }
+    return items;
+}
+
+QHash<QString, QString> configLabels(const UserSettingsPointer& pConfig) {
+    QHash<QString, QString> labels;
+    const QStringList pairs =
+            pConfig->getValueString(kSidebarLabelsKey).split(QChar(';'), Qt::SkipEmptyParts);
+    for (const QString& pair : pairs) {
+        const int equals = pair.indexOf(QChar('='));
+        if (equals > 0 && equals < pair.size() - 1) {
+            labels.insert(pair.left(equals).trimmed(), pair.mid(equals + 1).trimmed());
+        }
+    }
+    return labels;
+}
+
+/// m_features in the configured order: listed keys first, then the rest
+QList<LibraryFeature*> orderedFeatures(
+        const QList<LibraryFeature*>& features, const QStringList& order) {
+    QList<LibraryFeature*> ordered = features;
+    std::stable_sort(ordered.begin(),
+            ordered.end(),
+            [&order](LibraryFeature* a, LibraryFeature* b) {
+                const auto rank = [&order](LibraryFeature* f) {
+                    const int i = static_cast<int>(order.indexOf(f->iconName()));
+                    return i < 0 ? static_cast<int>(order.size()) : i;
+                };
+                return rank(a) < rank(b);
+            });
+    return ordered;
+}
+
 } // namespace
 
