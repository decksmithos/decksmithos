+bool AutoDJProcessor::addRandomTrack(const QList<TrackPointer>& candidates) {
+    const auto harmonicTrack = [](const TrackPointer& pTrack) {
+        mixxx::autodj::HarmonicTrack track;
+        if (pTrack) {
+            track.bpm = pTrack->getBpm();
+            track.key = pTrack->getKey();
+        }
+        return track;
+    };
+    if (candidates.isEmpty()) {
+        return false;
+    }
+    m_pAutoDJTableModel->select();
+    const int rowCount = m_pAutoDJTableModel->rowCount();
+    // A running Auto DJ has the first queued track cued already: it stays
+    // first. Requests stay ahead of random tracks.
+    const int head = (m_eState != ADJ_DISABLED && rowCount > 0) ? 1 : 0;
+    QList<mixxx::autodj::HarmonicTrack> queue;
+    int first = 0;
+    for (int row = head; row < rowCount; ++row) {
+        const QModelIndex index = m_pAutoDJTableModel->index(row, 0);
+        if (m_requestedTracks.contains(m_pAutoDJTableModel->getTrackId(index))) {
+            first = row - head + 1;
+        }
+        queue.append(harmonicTrack(m_pAutoDJTableModel->getTrack(index)));
+    }
+    std::optional<mixxx::autodj::HarmonicTrack> previous;
+    if (head > 0) {
+        previous = harmonicTrack(m_pAutoDJTableModel->getTrack(m_pAutoDJTableModel->index(0, 0)));
+    } else {
+        for (const auto& pDeck : m_decks) {
+            if (pDeck->isPlaying()) {
+                previous = harmonicTrack(pDeck->getLoadedTrack());
+                break;
+            }
+        }
+    }
+    const int last = static_cast<int>(queue.size());
+    TrackPointer pBest;
+    mixxx::autodj::HarmonicFill bestFill;
+    for (const auto& pCandidate : candidates) {
+        if (!pCandidate) {
+            continue;
+        }
+        const auto fill = mixxx::autodj::harmonicFillSlot(
+                queue, harmonicTrack(pCandidate), previous, first, last);
+        if (!pBest || fill.cost < bestFill.cost) {
+            pBest = pCandidate;
+            bestFill = fill;
+        }
+    }
+    if (!pBest) {
+        return false;
+    }
+    // An invalid index appends
+    const QModelIndex before = bestFill.slot < last
+            ? m_pAutoDJTableModel->index(head + bestFill.slot, 0)
+            : QModelIndex();
+    if (m_pAutoDJTableModel->addTracksWithTrackIds(before, {pBest->getId()}, nullptr) < 1) {
+        return false;
+    }
+    m_pAutoDJTableModel->select();
+    return true;
+}
