diff --git a/src/library/autodj/harmonicorder.h b/src/library/autodj/harmonicorder.h
index 40cbb3fb..55bc2009 100644
--- a/src/library/autodj/harmonicorder.h
+++ b/src/library/autodj/harmonicorder.h
@@ -157,5 +157,45 @@ inline int harmonicRequestSlot(const QList<HarmonicTrack>& queue,
     return bestSlot;
 }
 
+/// DecksmithOS: where a random track (AUTO FILL, "Add random") fits best
+/// in `queue`, at slots first..last (slot 0: after `previous`), and the cost
+/// there: the change in transition cost, plus `slotCost` for each slot before
+/// `last`, so that it goes to the end unless it fits clearly better earlier.
+struct HarmonicFill {
+    int slot = 0;
+    double cost = 0.0;
+};
+
+inline HarmonicFill harmonicFillSlot(const QList<HarmonicTrack>& queue,
+        const HarmonicTrack& track,
+        const std::optional<HarmonicTrack>& previous,
+        int first,
+        int last,
+        double slotCost = 1.0) {
+    last = std::clamp(last, 0, static_cast<int>(queue.size()));
+    first = std::clamp(first, 0, last);
+    HarmonicFill best;
+    for (int slot = last; slot >= first; --slot) {
+        const HarmonicTrack* pBefore = slot > 0 ? &queue[slot - 1]
+                                                : (previous ? &*previous : nullptr);
+        const HarmonicTrack* pAfter = slot < queue.size() ? &queue[slot] : nullptr;
+        double cost = slotCost * (last - slot);
+        if (pBefore) {
+            cost += harmonicTransitionCost(*pBefore, track);
+        }
+        if (pAfter) {
+            cost += harmonicTransitionCost(track, *pAfter);
+        }
+        if (pBefore && pAfter) {
+            cost -= harmonicTransitionCost(*pBefore, *pAfter);
+        }
+        if (slot == last || cost < best.cost) {
+            best.slot = slot;
+            best.cost = cost;
+        }
+    }
+    return best;
+}
+
 } // namespace autodj
 } // namespace mixxx
