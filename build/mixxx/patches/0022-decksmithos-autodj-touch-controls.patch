+void CrateFeature::updateCrateControls() {
+    Crate crate;
+    const bool shown = m_pTrackCollection->crates().readCrateById(
+            m_crateTableModel.selectedCrate(), &crate);
+    m_pCoCrateSelected->forceSet(shown ? 1 : 0);
+    m_pCoAutoDjSource->setAndConfirm(shown && crate.isAutoDjSource() ? 1 : 0);
+}
+
+void CrateFeature::slotAutoDjSourceRequest(double value) {
+    Crate crate;
+    if (m_pCoCrateSelected->get() > 0 &&
+            m_pTrackCollection->crates().readCrateById(
+                    m_crateTableModel.selectedCrate(), &crate)) {
+        if (crate.isAutoDjSource() != (value > 0)) {
+            crate.setAutoDjSource(value > 0);
+            m_pTrackCollection->updateCrate(crate);
+        }
+    }
+    updateCrateControls();
 }
 
