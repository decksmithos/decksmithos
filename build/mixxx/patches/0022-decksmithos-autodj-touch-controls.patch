diff --git a/src/test/autodjprocessor_test.cpp b/src/test/autodjprocessor_test.cpp
index 86ffcbdc..0d00164f 100644
--- a/src/test/autodjprocessor_test.cpp
+++ b/src/test/autodjprocessor_test.cpp
@@ -1801,6 +1801,30 @@ TEST(AutoDJHarmonicOrderTest, RequestSlot) {
     EXPECT_EQ(0, harmonicRequestSlot({}, {120.0, key::C_MAJOR}, previous, 0, 4));
 }
 
+TEST(AutoDJHarmonicOrderTest, FillSlot) {
+    using mixxx::autodj::harmonicFillSlot;
+    const QList<HarmonicTrack> queue = {
+            {124.0, key::A_MINOR},       // 0
+            {128.0, key::F_SHARP_MAJOR}, // 1: far key
+            {124.0, key::G_MAJOR},       // 2
+            {126.0, key::E_MINOR},       // 3
+    };
+    const HarmonicTrack previous{120.0, key::C_MAJOR};
+    // Fits after the last track: at the end
+    const auto end = harmonicFillSlot(queue, {126.0, key::E_MINOR}, previous, 0, 4);
+    EXPECT_EQ(4, end.slot);
+    EXPECT_DOUBLE_EQ(0.0, end.cost);
+    // Fits only next to the other F# major track: there, although earlier
+    EXPECT_EQ(2, harmonicFillSlot(queue, {128.0, key::F_SHARP_MAJOR}, previous, 0, 4).slot);
+    // ...but not before the first allowed slot (requests stay ahead)
+    EXPECT_EQ(4, harmonicFillSlot(queue, {128.0, key::F_SHARP_MAJOR}, previous, 3, 4).slot);
+    // Nothing known: the end
+    EXPECT_EQ(4, harmonicFillSlot(QList<HarmonicTrack>(4), {}, std::nullopt, 0, 4).slot);
+    // A better fitting track costs less (the candidate chosen)
+    EXPECT_LT(end.cost,
+            harmonicFillSlot(queue, {100.0, key::D_FLAT_MAJOR}, previous, 0, 4).cost);
+}
+
 TEST_F(AutoDJProcessorTest, Request) {
