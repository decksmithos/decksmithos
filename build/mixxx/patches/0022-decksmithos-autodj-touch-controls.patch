+void WTrackTableView::addAllToAutoDJBottom() {
+    auto* pTrackModel = getTrackModel();
+    QAbstractItemModel* pModel = model();
+    if (!pTrackModel || !pModel ||
+            !pTrackModel->hasCapabilities(TrackModel::Capability::AddToAutoDJ)) {
+        return;
+    }
+    // SQL models load their rows in chunks
+    while (pModel->canFetchMore(QModelIndex())) {
+        pModel->fetchMore(QModelIndex());
+    }
+    QList<TrackId> trackIds;
+    trackIds.reserve(pModel->rowCount());
+    for (int row = 0; row < pModel->rowCount(); ++row) {
+        const TrackId trackId = pTrackModel->getTrackId(pModel->index(row, 0));
+        if (trackId.isValid()) {
+            trackIds.append(trackId);
+        }
+    }
+    if (trackIds.isEmpty()) {
+        return;
+    }
+    PlaylistDAO& playlistDao = m_pLibrary->trackCollectionManager()
+                                       ->internalCollection()
+                                       ->getPlaylistDAO();
+    m_pLibrary->trackCollectionManager()->unhideTracks(trackIds);
+    playlistDao.addTracksToAutoDJQueue(trackIds, PlaylistDAO::AutoDJSendLoc::BOTTOM);
+}
