diff --git a/src/mixer/removabledrives.cpp b/src/mixer/removabledrives.cpp
new file mode 100644
index 00000000..d06cf238
--- /dev/null
+++ b/src/mixer/removabledrives.cpp
@@ -0,0 +1,157 @@
+#include "mixer/removabledrives.h"
+
+#include <QDir>
+#include <QProcess>
+#include <QStorageInfo>
+#include <QtDebug>
+
+#include "control/controlobject.h"
+#include "control/controlpushbutton.h"
+#include "mixer/basetrackplayer.h"
+#include "mixer/playermanager.h"
+#include "moc_removabledrives.cpp"
+#include "track/track.h"
+
+namespace {
+
+const QString kGroup = QStringLiteral("[Drives]");
+
+bool isMounted(const QString& path) {
+    if (!QFileInfo(path).isDir()) {
+        return false;
+    }
+    const QStorageInfo storage(path);
+    return storage.isValid() && storage.isReady() && storage.rootPath() != QDir::rootPath();
+}
+
+} // namespace
+
+// static
+bool RemovableDrives::isEnabled() {
+    return !qEnvironmentVariableIsEmpty("DECKSMITHOS_DRIVES");
+}
+
+RemovableDrives::RemovableDrives(QObject* pParent, PlayerManager* pPlayerManager)
+        : QObject(pParent),
+          m_pPlayerManager(pPlayerManager),
+          m_ejectCommand(QProcess::splitCommand(
+                  qEnvironmentVariable("DECKSMITHOS_EJECT_COMMAND"))) {
+    const QStringList paths = qEnvironmentVariable("DECKSMITHOS_DRIVES")
+                                      .split(QChar(':'), Qt::SkipEmptyParts);
+    for (int i = 0; i < paths.size(); ++i) {
+        auto pDrive = std::make_unique<Drive>();
+        pDrive->path = QDir::cleanPath(paths[i]);
+        const QString n = QString::number(i + 1);
+        pDrive->pMounted = std::make_unique<ControlObject>(
+                ConfigKey(kGroup, QStringLiteral("mounted_") + n));
+        pDrive->pMounted->setReadOnly();
+        pDrive->pEjectError = std::make_unique<ControlObject>(
+                ConfigKey(kGroup, QStringLiteral("eject_error_") + n));
+        pDrive->pEjectError->setReadOnly();
+        pDrive->pEject = std::make_unique<ControlPushButton>(
+                ConfigKey(kGroup, QStringLiteral("eject_") + n));
+        Drive* pRaw = pDrive.get();
+        connect(pDrive->pEject.get(),
+                &ControlObject::valueChanged,
+                this,
+                [this, pRaw](double value) {
+                    if (value > 0) {
+                        eject(pRaw);
+                    }
+                });
+        m_drives.push_back(std::move(pDrive));
+    }
+    slotPoll();
+    m_pollTimer.setInterval(1000);
+    connect(&m_pollTimer, &QTimer::timeout, this, &RemovableDrives::slotPoll);
+    m_pollTimer.start();
+}
+
+RemovableDrives::~RemovableDrives() = default;
+
+void RemovableDrives::slotPoll() {
+    for (const auto& pDrive : m_drives) {
+        const bool mounted = isMounted(pDrive->path);
+        if (mounted != (pDrive->pMounted->get() > 0)) {
+            pDrive->pMounted->forceSet(mounted ? 1.0 : 0.0);
+            if (!mounted) {
+                pDrive->pEjectError->forceSet(0.0);
+            }
+        }
+    }
+}
+
+QStringList RemovableDrives::playersWithTracksFrom(const QString& path, bool* pPlaying) const {
+    QStringList groups;
+    *pPlaying = false;
+    const QString prefix = path + QChar('/');
+    QStringList candidates;
+    for (int i = 0; i < m_pPlayerManager->numberOfDecks(); ++i) {
+        candidates.append(PlayerManager::groupForDeck(i));
+    }
+    for (int i = 0; i < m_pPlayerManager->numberOfSamplers(); ++i) {
+        candidates.append(PlayerManager::groupForSampler(i));
+    }
+    for (int i = 0; i < m_pPlayerManager->numberOfPreviewDecks(); ++i) {
+        candidates.append(PlayerManager::groupForPreviewDeck(i));
+    }
+    for (const QString& group : std::as_const(candidates)) {
+        BaseTrackPlayer* pPlayer = m_pPlayerManager->getPlayer(group);
+        const TrackPointer pTrack = pPlayer ? pPlayer->getLoadedTrack() : TrackPointer();
+        if (!pTrack || !pTrack->getLocation().startsWith(prefix)) {
+            continue;
+        }
+        groups.append(group);
+        if (ControlObject::get(ConfigKey(group, QStringLiteral("play"))) > 0) {
+            *pPlaying = true;
+        }
+    }
+    return groups;
+}
+
+void RemovableDrives::eject(Drive* pDrive) {
+    if (pDrive->ejecting || pDrive->pMounted->get() <= 0) {
+        return;
+    }
+    pDrive->pEjectError->forceSet(0.0);
+    bool playing = false;
+    const QStringList groups = playersWithTracksFrom(pDrive->path, &playing);
+    if (playing) {
+        qWarning() << "Not ejecting" << pDrive->path << ": a track from it is playing";
+        pDrive->pEjectError->forceSet(1.0);
+        return;
+    }
+    if (m_ejectCommand.isEmpty()) {
+        qWarning() << "No DECKSMITHOS_EJECT_COMMAND to eject" << pDrive->path;
+        pDrive->pEjectError->forceSet(1.0);
+        return;
+    }
+    // Close the files: unload the tracks from the stopped players
+    for (const QString& group : groups) {
+        ControlObject::set(ConfigKey(group, QStringLiteral("eject")), 1.0);
+        ControlObject::set(ConfigKey(group, QStringLiteral("eject")), 0.0);
+    }
+    pDrive->ejecting = true;
+    auto* pProcess = new QProcess(this);
+    QStringList arguments = m_ejectCommand.mid(1);
+    arguments.append(pDrive->path);
+    connect(pProcess,
+            &QProcess::finished,
+            this,
+            [this, pDrive, pProcess](int exitCode, QProcess::ExitStatus exitStatus) {
+                pDrive->ejecting = false;
+                const bool ok = exitStatus == QProcess::NormalExit && exitCode == 0;
+                qInfo() << "Eject" << pDrive->path << (ok ? "done" : "failed")
+                        << QString::fromLocal8Bit(pProcess->readAllStandardError()).trimmed();
+                if (!ok) {
+                    pDrive->pEjectError->forceSet(1.0);
+                }
+                slotPoll();
+                pProcess->deleteLater();
+            });
+    // The players release their files asynchronously: give them a moment
+    QTimer::singleShot(500, pProcess, [pProcess, this, arguments]() {
+        pProcess->start(m_ejectCommand.first(), arguments);
+    });
+    qInfo() << "Ejecting" << pDrive->path;
+}
diff --git a/src/mixer/removabledrives.h b/src/mixer/removabledrives.h
new file mode 100644
index 00000000..858394ce
--- /dev/null
+++ b/src/mixer/removabledrives.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <QList>
+#include <QObject>
+#include <QString>
+#include <QTimer>
+#include <memory>
+#include <vector>
+
+class ControlObject;
+class ControlPushButton;
+class PlayerManager;
+
+/// DecksmithOS: removable drives at fixed mount points, with an eject button
+/// for the skin. DECKSMITHOS_DRIVES="/usb:/usb2" lists the mount points;
+/// DECKSMITHOS_EJECT_COMMAND is run with the mount point as last argument
+/// (e.g. "sudo -n /usr/local/sbin/decksmithos-system eject"). Per drive n
+/// (1-based, in that order):
+///   [Drives],mounted_<n>      1 while a drive is mounted there (read-only)
+///   [Drives],eject_<n>        eject it: tracks from it are unloaded from
+///                             stopped players first; refused while one of
+///                             them plays
+///   [Drives],eject_error_<n>  1 after a refused or failed eject, until the
+///                             next attempt or until the drive is gone
+/// Mount state is polled every second (a drive on "/" means none).
+class RemovableDrives : public QObject {
+    Q_OBJECT
+  public:
+    RemovableDrives(QObject* pParent, PlayerManager* pPlayerManager);
+    ~RemovableDrives() override;
+
+    static bool isEnabled();
+
+  private slots:
+    void slotPoll();
+
+  private:
+    struct Drive {
+        QString path; // without trailing '/'
+        std::unique_ptr<ControlObject> pMounted;
+        std::unique_ptr<ControlPushButton> pEject;
+        std::unique_ptr<ControlObject> pEjectError;
+        bool ejecting = false;
+    };
+    void eject(Drive* pDrive);
+    /// Groups of players with a track from `path`; `pPlaying` is set if one
+    /// of them is playing
+    QStringList playersWithTracksFrom(const QString& path, bool* pPlaying) const;
+
+    PlayerManager* const m_pPlayerManager;
+    std::vector<std::unique_ptr<Drive>> m_drives;
+    QStringList m_ejectCommand;
+    QTimer m_pollTimer;
+};
