 void LibraryControl::slotGoToItem(double v) {
-    if (v <= 0) {
+    // DecksmithOS: a push acts when it is released; held for a second it
+    // opens the search instead. Mappings that never send a release (no 0
+    // seen yet) act on the push, as before.
+    if (v > 0) {
+        m_goToItemHeld = true;
+        if (m_goToItemReleaseSeen) {
+            m_goToItemHoldTimer.start();
+        } else {
+            goToItemPush();
+        }
+        return;
+    }
+    if (!m_goToItemHeld) {
+        return;
+    }
+    m_goToItemHeld = false;
+    m_goToItemReleaseSeen = true;
+    if (m_goToItemHoldTimer.isActive()) {
+        m_goToItemHoldTimer.stop();
+        goToItemPush();
+    }
+}
+
+namespace {
+const ConfigKey kShowLibraryKey("[Skin]", "show_maximized_library");
+
+/// DecksmithOS: shows a library the skin hides (a library page behind
+/// [Skin],show_maximized_library); true if it was hidden
+bool showHiddenLibrary(WLibrary* pLibraryWidget) {
+    if (pLibraryWidget && !pLibraryWidget->isVisible() &&
+            ControlObject::exists(kShowLibraryKey) &&
+            ControlObject::get(kShowLibraryKey) <= 0) {
+        ControlObject::set(kShowLibraryKey, 1.0);
+        return true;
+    }
+    return false;
+}
+} // namespace
+
+void LibraryControl::goToItemHold() {
+    if (!m_goToItemHeld) {
+        return;
+    }
+    // The skin may switch to the list it searches (DecksmithOS skin bridge:
+    // Tracks, all music); the search box gets the focus here for any skin
+    showHiddenLibrary(m_pLibraryWidget);
+    m_pSearchRequest->forceSet(m_pSearchRequest->get() + 1);
+    setLibraryFocus(FocusWidget::Searchbar);
+}
+
+void LibraryControl::goToItemPush() {
+    // DecksmithOS: while the skin hides the library, a push shows it, at the
+    // list shown last, instead of acting on something nobody can see
+    if (showHiddenLibrary(m_pLibraryWidget)) {
         return;
     }
 
