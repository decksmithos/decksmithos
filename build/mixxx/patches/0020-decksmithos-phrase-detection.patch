diff --git a/src/analyzer/analyzerphrases.cpp b/src/analyzer/analyzerphrases.cpp
new file mode 100644
index 00000000..455ddfa6
--- /dev/null
+++ b/src/analyzer/analyzerphrases.cpp
@@ -0,0 +1,212 @@
+#include "analyzer/analyzerphrases.h"
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+
+#include "analyzer/analyzerbeats.h"
+#include "analyzer/analyzertrack.h"
+#include "analyzer/constants.h"
+#include "analyzer/phrasedetector.h"
+#include "track/track.h"
+#include "util/logger.h"
+
+namespace {
+
+const mixxx::Logger kLogger("AnalyzerPhrases");
+
+const ConfigKey kDetectPhrasesKey(
+        QStringLiteral("[Library]"), QStringLiteral("DetectPhrases"));
+
+constexpr int kBlock = 512; // frames per mean square value
+constexpr double kBassHz = 150;
+
+double toDb(double meanSquare) {
+    return 10 * std::log10(meanSquare + 1e-10);
+}
+
+} // namespace
+
+AnalyzerPhrases::AnalyzerPhrases(UserSettingsPointer pConfig,
+        const AnalyzerBeats* pAnalyzerBeats,
+        const QSqlDatabase& database)
+        : m_pConfig(pConfig),
+          m_pAnalyzerBeats(pAnalyzerBeats),
+          m_hasDatabase(database.isValid()),
+          m_analysisDao(pConfig),
+          m_b0(0),
+          m_b1(0),
+          m_b2(0),
+          m_a1(0),
+          m_a2(0),
+          m_x1(0),
+          m_x2(0),
+          m_y1(0),
+          m_y2(0),
+          m_sum(0),
+          m_bassSum(0),
+          m_blockFrames(0) {
+    if (m_hasDatabase) {
+        m_analysisDao.initialize(database);
+    }
+}
+
+// static
+bool AnalyzerPhrases::isEnabled(const UserSettingsPointer& pConfig) {
+    return pConfig->getValue(kDetectPhrasesKey, true);
+}
+
+bool AnalyzerPhrases::initialize(const AnalyzerTrack& track,
+        mixxx::audio::SampleRate sampleRate,
+        SINT frameLength) {
+    if (frameLength <= 0 || !sampleRate.isValid() || !isEnabled(m_pConfig)) {
+        return false;
+    }
+    const TrackPointer& pTrack = track.getTrack();
+    const bool beatsAnalyzing = m_pAnalyzerBeats && m_pAnalyzerBeats->isAnalyzing();
+    if (!pTrack->getBeats() && !beatsAnalyzing) {
+        return false; // no beat grid to work with
+    }
+    const mixxx::TrackStructurePointer pStructure = pTrack->getStructure();
+    if (!Track::isStructureReplaceableByDetection(pStructure)) {
+        return false; // rekordbox phrases
+    }
+    if (pStructure && pStructure->isDetected() && !beatsAnalyzing) {
+        return false; // already detected for this beat grid
+    }
+
+    // RBJ biquad low-pass, Q = 1/sqrt(2)
+    const double w0 = 2 * std::numbers::pi * kBassHz / sampleRate.value();
+    const double alpha = std::sin(w0) / std::numbers::sqrt2; // sin(w0) / (2 Q)
+    const double cosw0 = std::cos(w0);
+    const double a0 = 1 + alpha;
+    m_b0 = (1 - cosw0) / 2 / a0;
+    m_b1 = (1 - cosw0) / a0;
+    m_b2 = m_b0;
+    m_a1 = -2 * cosw0 / a0;
+    m_a2 = (1 - alpha) / a0;
+    m_x1 = m_x2 = m_y1 = m_y2 = 0;
+    m_sum = m_bassSum = 0;
+    m_blockFrames = 0;
+    m_power.clear();
+    m_bassPower.clear();
+    m_power.reserve(frameLength / kBlock + 1);
+    m_bassPower.reserve(frameLength / kBlock + 1);
+    return true;
+}
+
+bool AnalyzerPhrases::processSamples(const CSAMPLE* pIn, SINT count) {
+    // Mixxx 2.5: the analyzers always get stereo samples
+    const SINT frames = count / mixxx::kAnalysisChannels;
+    for (SINT f = 0; f < frames; ++f) {
+        const double x = 0.5 *
+                (static_cast<double>(pIn[2 * f]) + static_cast<double>(pIn[2 * f + 1]));
+        const double y = m_b0 * x + m_b1 * m_x1 + m_b2 * m_x2 - m_a1 * m_y1 - m_a2 * m_y2;
+        m_x2 = m_x1;
+        m_x1 = x;
+        m_y2 = m_y1;
+        m_y1 = y;
+        m_sum += x * x;
+        m_bassSum += y * y;
+        if (++m_blockFrames == kBlock) {
+            m_power.push_back(static_cast<float>(m_sum / kBlock));
+            m_bassPower.push_back(static_cast<float>(m_bassSum / kBlock));
+            m_sum = m_bassSum = 0;
+            m_blockFrames = 0;
+        }
+    }
+    // Denormals after long silence
+    if (std::abs(m_y1) < 1e-20 && std::abs(m_y2) < 1e-20) {
+        m_y1 = m_y2 = 0;
+    }
+    return true;
+}
+
+void AnalyzerPhrases::storeResults(TrackPointer pTrack) {
+    const mixxx::BeatsPointer pBeats = pTrack->getBeats();
+    const mixxx::TrackStructurePointer pOldStructure = pTrack->getStructure();
+    if (!pBeats || m_power.empty() ||
+            !Track::isStructureReplaceableByDetection(pOldStructure)) {
+        return;
+    }
+
+    // Level of each beat
+    const auto blocks = static_cast<int>(m_power.size());
+    std::vector<double> loudDb;
+    std::vector<double> bassDb;
+    std::vector<mixxx::audio::FramePos> positions;
+    const auto firstBeat = pBeats->iteratorFrom(mixxx::audio::kStartFramePos);
+    if (firstBeat == pBeats->cend()) {
+        return;
+    }
+    positions.push_back(*firstBeat);
+    for (auto it = firstBeat; static_cast<int>(loudDb.size()) < blocks; ++it) {
+        const auto next = std::next(it);
+        if (next == pBeats->cend() || !next->isValid()) {
+            break;
+        }
+        const int from = std::max(0, static_cast<int>(it->value() / kBlock));
+        const int to = std::max(from + 1, static_cast<int>(next->value() / kBlock));
+        if (to > blocks) {
+            break;
+        }
+        double power = 0;
+        double bass = 0;
+        for (int b = from; b < to; ++b) {
+            power += m_power[b];
+            bass += m_bassPower[b];
+        }
+        loudDb.push_back(toDb(power / (to - from)));
+        bassDb.push_back(toDb(bass / (to - from)));
+        positions.push_back(*next);
+    }
+
+    // Keep a rekordbox downbeat
+    mixxx::audio::FramePos keptDownbeat;
+    int knownPhase = -1;
+    if (pOldStructure && !pOldStructure->isDetected() &&
+            pOldStructure->firstDownbeat().isValid()) {
+        keptDownbeat = pOldStructure->firstDownbeat();
+        const auto closest = pBeats->findClosestBeat(keptDownbeat);
+        if (closest.isValid()) {
+            const int index = pBeats->iteratorFrom(closest) - firstBeat;
+            knownPhase = (index % mixxx::phrasedetect::kBeatsPerBar +
+                                 mixxx::phrasedetect::kBeatsPerBar) %
+                    mixxx::phrasedetect::kBeatsPerBar;
+        }
+    }
+
+    const auto result = mixxx::phrasedetect::detect(loudDb, bassDb, knownPhase);
+    QVector<mixxx::TrackStructure::Phrase> phrases;
+    for (const auto& phrase : result.phrases) {
+        phrases.append(mixxx::TrackStructure::Phrase{
+                positions[phrase.startBeat], positions[phrase.endBeat], phrase.kind, 0});
+    }
+    mixxx::audio::FramePos firstDownbeat = keptDownbeat;
+    if (!firstDownbeat.isValid() && result.firstDownbeat >= 0) {
+        firstDownbeat = positions[result.firstDownbeat];
+    }
+    if (phrases.isEmpty() && (keptDownbeat.isValid() || !firstDownbeat.isValid())) {
+        kLogger.debug() << "Nothing detected for" << pTrack->getLocation();
+        return;
+    }
+    const auto pStructure = std::make_shared<const mixxx::TrackStructure>(
+            mixxx::TrackStructure::Mood::High,
+            std::move(phrases),
+            firstDownbeat,
+            mixxx::phrasedetect::kBeatsPerBar,
+            mixxx::TrackStructure::Source::Detected);
+    if (!pTrack->trySetDetectedStructure(pStructure)) {
+        return; // rekordbox data arrived meanwhile
+    }
+    kLogger.info() << "Detected" << pStructure->phrases().size()
+                   << "phrases in" << pTrack->getLocation();
+    if (m_hasDatabase && pTrack->getId().isValid()) {
+        m_analysisDao.saveTrackStructure(pTrack->getId(), pStructure);
+    }
+}
+
+void AnalyzerPhrases::cleanup() {
+    m_power = {};
+    m_bassPower = {};
+}
