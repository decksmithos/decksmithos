+#pragma once
+
+#include <QSqlDatabase>
+#include <vector>
+
+#include "analyzer/analyzer.h"
+#include "library/dao/analysisdao.h"
+#include "preferences/usersettings.h"
+
+class AnalyzerBeats;
+
+/// DecksmithOS: detects phrases and the first downbeat of tracks without
+/// rekordbox phrase data (see analyzer/phrasedetector.h) and stores them as
+/// the track structure (source Detected).
+///
+/// While decoding it keeps two mean squares per block of 512 frames: the
+/// signal and a 150 Hz low-pass (one biquad). The beat grid is only needed
+/// in storeResults(), so this works in the same pass that detects the beats
+/// (AnalyzerBeats stores its results first).
+///
+/// Runs when the track has no structure, rekordbox data without phrases
+/// (first downbeat only; it is kept), or a detected structure while the
+/// beats are being detected again. Never replaces rekordbox phrases.
+/// [Library],DetectPhrases (default 1) switches it off.
+class AnalyzerPhrases : public Analyzer {
+  public:
+    /// pAnalyzerBeats: the beat analyzer of the same pass, or nullptr.
+    /// database: where the structure is saved; if invalid the structure is
+    /// only set on the track.
+    AnalyzerPhrases(UserSettingsPointer pConfig,
+            const AnalyzerBeats* pAnalyzerBeats,
+            const QSqlDatabase& database = QSqlDatabase());
+    ~AnalyzerPhrases() override = default;
+
+    static bool isEnabled(const UserSettingsPointer& pConfig);
+
+    bool initialize(const AnalyzerTrack& track,
+            mixxx::audio::SampleRate sampleRate,
+            SINT frameLength) override;
+    bool processSamples(const CSAMPLE* pIn, SINT count) override;
+    void storeResults(TrackPointer pTrack) override;
+    void cleanup() override;
+
+  private:
+    const UserSettingsPointer m_pConfig;
+    const AnalyzerBeats* const m_pAnalyzerBeats;
+    const bool m_hasDatabase;
+    AnalysisDao m_analysisDao;
+
+    // biquad low-pass, direct form I
+    double m_b0, m_b1, m_b2, m_a1, m_a2;
+    double m_x1, m_x2, m_y1, m_y2;
+    double m_sum;
+    double m_bassSum;
+    int m_blockFrames;
+    std::vector<float> m_power;
+    std::vector<float> m_bassPower;
+};
