index 00000000..d6c9b68b
--- /dev/null
+++ b/src/analyzer/phrasedetector.cpp
@@ -0,0 +1,241 @@
+#include "analyzer/phrasedetector.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace mixxx::phrasedetect {
+
+namespace {
+
+using Kind = TrackStructure::PhraseKind;
+
+/// 2 on the 8-bar grid, 1 on the 4-bar grid, 0 otherwise
+int gridRank(int bar, int gridOffset) {
+    const int pos = ((bar - gridOffset) % 8 + 8) % 8;
+    return pos == 0 ? 2 : (pos % 4 == 0 ? 1 : 0);
+}
+
+struct Section {
+    int startBar;
+    int endBar;
+    Kind kind;
+};
+
+} // namespace
+
+std::vector<double> changeScore(const std::vector<double>& loudDb,
+        const std::vector<double>& bassDb,
+        int firstSound,
+        int lastSound) {
+    const int n = static_cast<int>(loudDb.size());
+    std::vector<double> score(n, 0.0);
+    if (n == 0 || static_cast<int>(bassDb.size()) != n || firstSound < 0 ||
+            lastSound >= n || firstSound > lastSound) {
+        return score;
+    }
+    // prefix sums
+    std::vector<double> loudSum(n + 1, 0.0);
+    std::vector<double> bassSum(n + 1, 0.0);
+    for (int i = 0; i < n; ++i) {
+        loudSum[i + 1] = loudSum[i] + loudDb[i];
+        bassSum[i + 1] = bassSum[i] + bassDb[i];
+    }
+    const auto mean = [](const std::vector<double>& sum, int from, int to) {
+        return (sum[to] - sum[from]) / (to - from);
+    };
+    for (int i = firstSound + kMinWindowBeats; i + kMinWindowBeats <= lastSound + 1; ++i) {
+        const int w = std::min({kWindowBeats, i - firstSound, lastSound + 1 - i});
+        const double dLoud = mean(loudSum, i, i + w) - mean(loudSum, i - w, i);
+        const double dBass = mean(bassSum, i, i + w) - mean(bassSum, i - w, i);
+        score[i] = std::abs(dLoud) + std::abs(dBass);
+    }
+    return score;
+}
+
+int barPhase(const std::vector<double>& score, int firstSound) {
+    const int n = static_cast<int>(score.size());
+    std::array<double, kBeatsPerBar> votes{};
+    bool anyPeak = false;
+    for (int i = 0; i < n; ++i) {
+        if (score[i] < kMinChangeDb) {
+            continue;
+        }
+        bool isPeak = true;
+        for (int j = std::max(0, i - 2); j <= std::min(n - 1, i + 2); ++j) {
+            if (score[j] > score[i]) {
+                isPeak = false;
+                break;
+            }
+        }
+        if (isPeak) {
+            votes[i % kBeatsPerBar] += score[i];
+            anyPeak = true;
+        }
+    }
+    if (!anyPeak) {
+        return std::max(0, firstSound) % kBeatsPerBar;
+    }
+    return static_cast<int>(std::max_element(votes.begin(), votes.end()) - votes.begin());
+}
+
+Result detect(const std::vector<double>& loudDb,
+        const std::vector<double>& bassDb,
+        int knownDownbeat) {
+    Result result;
+    const int n = static_cast<int>(loudDb.size());
+    if (n == 0 || static_cast<int>(bassDb.size()) != n) {
+        return result;
+    }
+
+    // Range with sound
+    std::vector<double> sorted = loudDb;
+    const auto p90 = sorted.begin() + static_cast<int>(0.9 * (n - 1));
+    std::nth_element(sorted.begin(), p90, sorted.end());
+    const double soundDb = std::max(kSilenceDb, *p90 - kSoundRangeDb);
+    int firstSound = -1;
+    int lastSound = -1;
+    for (int i = 0; i < n; ++i) {
+        if (loudDb[i] >= soundDb) {
+            if (firstSound < 0) {
+                firstSound = i;
+            }
+            lastSound = i;
+        }
+    }
+    if (firstSound < 0) {
+        return result;
+    }
+
+    const std::vector<double> score = changeScore(loudDb, bassDb, firstSound, lastSound);
+    const int phase = knownDownbeat >= 0
+            ? knownDownbeat % kBeatsPerBar
+            : barPhase(score, firstSound);
+    const int start = firstSound +
+            ((phase - firstSound % kBeatsPerBar) + kBeatsPerBar) % kBeatsPerBar;
+    if (start >= n) {
+        return result;
+    }
+    result.firstDownbeat = start;
+    if (lastSound < start) {
+        return result;
+    }
+    const int numBars = (lastSound + 1 - start + kBeatsPerBar - 1) / kBeatsPerBar;
+    if (numBars < kMinBars) {
+        return result;
+    }
+
+    // Change at each bar start, allowing the peak to be one beat off
+    std::vector<double> barScore(numBars, 0.0);
+    for (int b = 1; b < numBars; ++b) {
+        const int d = start + b * kBeatsPerBar;
+        for (int j = std::max(0, d - 1); j <= std::min(n - 1, d + 1); ++j) {
+            barScore[b] = std::max(barScore[b], score[j]);
+        }
+    }
+    std::vector<int> peaks;
+    for (int b = 1; b < numBars; ++b) {
+        if (barScore[b] >= kMinChangeDb && barScore[b] >= barScore[b - 1] &&
+                (b + 1 == numBars || barScore[b] >= barScore[b + 1])) {
+            peaks.push_back(b);
+        }
+    }
+
+    // Phrase grid: the bar offset mod 8 on which the changes fall
+    std::array<double, 8> gridVotes{};
+    for (const int b : peaks) {
+        gridVotes[b % 8] += barScore[b];
+    }
+    const int gridOffset = static_cast<int>(
+            std::max_element(gridVotes.begin(), gridVotes.end()) - gridVotes.begin());
+
+    // Move broad peaks onto the grid
+    struct Candidate {
+        int bar;
+        double strength;
+    };
+    std::vector<Candidate> candidates;
+    for (const int b : peaks) {
+        int bar = b;
+        int bestRank = gridRank(b, gridOffset);
+        for (const int g : {b - 1, b + 1}) {
+            if (g < 1 || g >= numBars) {
+                continue;
+            }
+            const int rank = gridRank(g, gridOffset);
+            if (rank > bestRank && barScore[g] >= kSnapRatio * barScore[b]) {
+                bar = g;
+                bestRank = rank;
+            }
+        }
+        candidates.push_back({bar, barScore[b]});
+    }
+
+    // Strongest first; boundaries closer than kMinPhraseBars are merged
+    std::stable_sort(candidates.begin(),
+            candidates.end(),
+            [](const Candidate& a, const Candidate& b) {
+                return a.strength > b.strength;
+            });
+    std::vector<int> boundaries{0, numBars};
+    for (const auto& candidate : candidates) {
+        const bool farEnough = std::all_of(boundaries.begin(),
+                boundaries.end(),
+                [&](int bar) {
+                    return std::abs(bar - candidate.bar) >= kMinPhraseBars;
+                });
+        if (farEnough) {
+            boundaries.push_back(candidate.bar);
+        }
+    }
+    std::sort(boundaries.begin(), boundaries.end());
+
+    const auto beatOfBar = [&](int bar) {
+        return std::min(n, start + bar * kBeatsPerBar);
+    };
+
+    // Labels
+    std::vector<Section> sections;
+    std::vector<double> levels;
+    for (size_t k = 0; k + 1 < boundaries.size(); ++k) {
+        sections.push_back({boundaries[k], boundaries[k + 1], Kind::Other});
+        const int from = beatOfBar(boundaries[k]);
+        const int to = beatOfBar(boundaries[k + 1]);
+        double sum = 0;
+        for (int i = from; i < to; ++i) {
+            sum += 0.5 * (loudDb[i] + bassDb[i]);
+        }
+        levels.push_back(to > from ? sum / (to - from) : kSilenceDb);
+    }
+    const size_t count = sections.size();
+    const size_t firstMiddle = count >= 3 ? 1 : 0;
+    const size_t endMiddle = count >= 3 ? count - 1 : count;
+    const double maxLevel = *std::max_element(
+            levels.begin() + firstMiddle, levels.begin() + endMiddle);
+    for (size_t k = 0; k < count; ++k) {
+        if (count >= 2 && k == 0) {
+            sections[k].kind = Kind::Intro;
+        } else if (count >= 2 && k == count - 1) {
+            sections[k].kind = Kind::Outro;
+        } else if (levels[k] >= maxLevel - kChorusRangeDb) {
+            sections[k].kind = Kind::Chorus;
+        } else if (levels[k] < maxLevel - kDownRangeDb) {
+            sections[k].kind = Kind::Down;
+        } else {
+            sections[k].kind = Kind::Up;
+        }
+    }
+
+    // Long sections: kSplitBars pieces until the rest fits kMaxPhraseBars
+    for (const auto& section : sections) {
+        int bar = section.startBar;
+        while (section.endBar - bar > kMaxPhraseBars) {
+            result.phrases.push_back({beatOfBar(bar), beatOfBar(bar + kSplitBars), section.kind});
+            bar += kSplitBars;
+        }
+        result.phrases.push_back({beatOfBar(bar), beatOfBar(section.endBar), section.kind});
+    }
+    return result;
+}
+
+} // namespace mixxx::phrasedetect
diff --git a/src/analyzer/phrasedetector.h b/src/analyzer/phrasedetector.h
new file mode 100644
index 00000000..0b73c50c
--- /dev/null
+++ b/src/analyzer/phrasedetector.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <vector>
+
+#include "track/trackstructure.h"
+
+namespace mixxx::phrasedetect {
+
+/// DecksmithOS: phrase detection from per-beat levels, for tracks without
+/// rekordbox phrase data. Kept free of audio and track code so that it can
+/// be tested with synthetic levels.
+///
+/// Ideas from upstream Mixxx PRs #16582 (energy novelty quantized to bars)
+/// and #17404 (loudness + bass change around each beat, bar phase from the
+/// beats where the changes peak).
+
+constexpr int kBeatsPerBar = 4;
+/// Beats compared before and after a beat
+constexpr int kWindowBeats = 16;
+/// Shortest window near the start and end of the sound
+constexpr int kMinWindowBeats = 8;
+/// |loudness change| + |bass change| that makes a phrase boundary (dB)
+constexpr double kMinChangeDb = 3.0;
+/// Shortest phrase; closer boundaries are merged (the stronger one stays)
+constexpr int kMinPhraseBars = 4;
+/// Tracks with less sound than this get a first downbeat, but no phrases
+constexpr int kMinBars = 8;
+/// Sections longer than this are cut into kSplitBars pieces
+constexpr int kMaxPhraseBars = 32;
+constexpr int kSplitBars = 16;
+/// A boundary moves by one bar onto the 4/8-bar grid if the change there is
+/// at least this fraction of the peak (only broad changes move: a sharp
+/// step scores 13/16 of its peak one bar away)
+constexpr double kSnapRatio = 0.9;
+/// Sound starts where the loudness is within this of the loud part (the
+/// 90th percentile of the beat loudness), but above kSilenceDb
+constexpr double kSoundRangeDb = 30.0;
+constexpr double kSilenceDb = -60.0;
+/// Phrase labels (level = mean of loudness and bass level, in dB):
+/// within kChorusRangeDb of the loudest section: Chorus,
+/// more than kDownRangeDb below it: Down, in between: Up.
+constexpr double kChorusRangeDb = 3.0;
+constexpr double kDownRangeDb = 6.0;
+
+struct Phrase {
+    /// Beat indices; endBeat is the first beat after the phrase
+    int startBeat;
+    int endBeat;
+    TrackStructure::PhraseKind kind;
+};
+
+struct Result {
+    /// Beat index of the first downbeat (the first downbeat with sound),
+    /// or -1 if the track has no sound
+    int firstDownbeat = -1;
+    std::vector<Phrase> phrases;
+};
+
+/// Change score per beat: |loudness change| + |bass change| between the
+/// beats before and the beats from the beat on (up to kWindowBeats each,
+/// limited to the range with sound [firstSound, lastSound]).
+std::vector<double> changeScore(const std::vector<double>& loudDb,
+        const std::vector<double>& bassDb,
+        int firstSound,
+        int lastSound);
+
+/// Bar phase (beat index mod kBeatsPerBar of the downbeats): the phase on
+/// which the change peaks fall, weighted by their score. Returns
+/// firstSound % kBeatsPerBar if there is no change peak.
+int barPhase(const std::vector<double>& score, int firstSound);
+
+/// loudDb and bassDb: level of each beat (mean square in dB), same size.
+/// knownDownbeat: beat index of a known downbeat (e.g. from rekordbox), or
+/// -1 to detect the bar phase.
+Result detect(const std::vector<double>& loudDb,
+        const std::vector<double>& bassDb,
+        int knownDownbeat);
+
+} // namespace mixxx::phrasedetect
diff --git a/src/test/analyzerphrases_test.cpp b/src/test/analyzerphrases_test.cpp
new file mode 100644
index 00000000..41312212
--- /dev/null
+++ b/src/test/analyzerphrases_test.cpp
@@ -0,0 +1,328 @@
+#include "analyzer/analyzerphrases.h"
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+#include <numbers>
+#include <vector>
+
+#include "analyzer/analyzertrack.h"
+#include "analyzer/constants.h"
+#include "analyzer/phrasedetector.h"
+#include "test/mixxxtest.h"
+#include "track/beats.h"
+#include "track/track.h"
+
+// DecksmithOS phrase detection. These tests use synthetic levels and
+// synthetic audio only; they say nothing about the results on real music.
+
+namespace {
+
+using mixxx::TrackStructure;
+using mixxx::audio::FramePos;
+using Kind = TrackStructure::PhraseKind;
+namespace pd = mixxx::phrasedetect;
+
+struct Section {
+    int beats;
+    double loudDb;
+    double bassDb;
+};
+
+/// Per-beat levels with a little deterministic noise
+void makeLevels(const std::vector<Section>& sections,
+        std::vector<double>* pLoud,
+        std::vector<double>* pBass) {
+    unsigned seed = 1;
+    for (const auto& section : sections) {
+        for (int i = 0; i < section.beats; ++i) {
+            seed = seed * 1103515245 + 12345;
+            const double noise = (static_cast<int>((seed >> 16) % 1000) / 1000.0 - 0.5) * 0.6;
+            pLoud->push_back(section.loudDb + noise);
+            pBass->push_back(section.bassDb - noise);
+        }
+    }
+}
+
+std::vector<int> startBars(const pd::Result& result) {
+    std::vector<int> bars;
+    for (const auto& phrase : result.phrases) {
+        EXPECT_EQ(0, (phrase.startBeat - result.firstDownbeat) % 4);
+        bars.push_back((phrase.startBeat - result.firstDownbeat) / 4);
+    }
+    return bars;
+}
+
+// A pickup of 2 beats before the first downbeat (beat 3): the bar phase
+// comes from the section changes, not from where the sound starts.
+const std::vector<Section> kTrack{
+        {1, -100, -100}, // silence
+        {2, -25, -35},   // pickup
+        {64, -20, -30},  // intro, 16 bars
+        {64, -12, -14},  // chorus, 16 bars
+        {32, -18, -40},  // breakdown, 8 bars
+        {64, -12, -14},  // chorus, 16 bars
+        {64, -20, -30},  // outro, 16 bars
+        {10, -100, -100},
+};
+
+TEST(PhraseDetectorTest, BoundariesAndBarPhase) {
+    std::vector<double> loud;
+    std::vector<double> bass;
+    makeLevels(kTrack, &loud, &bass);
+    const auto result = pd::detect(loud, bass, -1);
+    EXPECT_EQ(3, result.firstDownbeat);
+    EXPECT_EQ((std::vector<int>{0, 16, 32, 40, 56}), startBars(result));
+    ASSERT_EQ(5u, result.phrases.size());
+    EXPECT_EQ(Kind::Intro, result.phrases[0].kind);
+    EXPECT_EQ(Kind::Chorus, result.phrases[1].kind);
+    EXPECT_EQ(Kind::Down, result.phrases[2].kind);
+    EXPECT_EQ(Kind::Chorus, result.phrases[3].kind);
+    EXPECT_EQ(Kind::Outro, result.phrases[4].kind);
+    // ends where the sound ends
+    EXPECT_EQ(3 + 72 * 4, result.phrases.back().endBeat);
+    for (size_t i = 1; i < result.phrases.size(); ++i) {
+        EXPECT_EQ(result.phrases[i - 1].endBeat, result.phrases[i].startBeat);
+    }
+}
+
+TEST(PhraseDetectorTest, KnownDownbeatPhaseIsUsed) {
+    std::vector<double> loud;
+    std::vector<double> bass;
+    makeLevels(kTrack, &loud, &bass);
+    // phase 1: the first beat with sound
+    const auto result = pd::detect(loud, bass, 5);
+    EXPECT_EQ(1, result.firstDownbeat);
+    EXPECT_FALSE(result.phrases.empty());
+}
+
+TEST(PhraseDetectorTest, CloseBoundariesAreMerged) {
+    std::vector<double> loud;
+    std::vector<double> bass;
+    // a 2-bar fill between intro and chorus
+    makeLevels({{64, -20, -30}, {8, -17, -30}, {64, -12, -14}, {64, -20, -30}},
+            &loud,
+            &bass);
+    const auto result = pd::detect(loud, bass, -1);
+    const auto bars = startBars(result);
+    ASSERT_EQ(3u, bars.size());
+    EXPECT_GE(bars[1], 16);
+    EXPECT_LE(bars[1], 18);
+    for (size_t i = 1; i < bars.size(); ++i) {
+        EXPECT_GE(bars[i] - bars[i - 1], pd::kMinPhraseBars);
+    }
+}
+
+TEST(PhraseDetectorTest, LongSectionsAreSplit) {
+    std::vector<double> loud;
+    std::vector<double> bass;
+    makeLevels({{32, -20, -30}, {256, -12, -14}, {32, -20, -30}}, &loud, &bass);
+    const auto result = pd::detect(loud, bass, -1);
+    EXPECT_EQ((std::vector<int>{0, 8, 24, 40, 72}), startBars(result));
+    for (const auto& phrase : result.phrases) {
+        EXPECT_LE(phrase.endBeat - phrase.startBeat, pd::kMaxPhraseBars * 4);
+    }
+}
+
+TEST(PhraseDetectorTest, SharpChangeStaysBroadChangeSnapsToGrid) {
+    for (const int rampBeats : {4, 16}) {
+        std::vector<double> loud;
+        std::vector<double> bass;
+        makeLevels({{64, -20, -30}, {64, -12, -14}, {64, -20, -30}}, &loud, &bass);
+        // bass comes in around bar 57 (beat 228), over rampBeats beats
+        while (static_cast<int>(loud.size()) < 228 - rampBeats / 2) {
+            loud.push_back(-12);
+            bass.push_back(-30);
+        }
+        for (int i = 0; i < rampBeats; ++i) {
+            loud.push_back(-12);
+            bass.push_back(-30 + 16 * (i + 0.5) / rampBeats);
+        }
+        for (int i = 0; i < 64; ++i) {
+            loud.push_back(-12);
+            bass.push_back(-14);
+        }
+        const auto bars = startBars(pd::detect(loud, bass, -1));
+        ASSERT_GE(bars.size(), 5u) << rampBeats;
+        EXPECT_EQ(rampBeats == 4 ? 57 : 56, bars[4]) << rampBeats;
+    }
+}
+
+TEST(PhraseDetectorTest, SilenceAndShortTracks) {
+    std::vector<double> loud(100, -100);
+    std::vector<double> bass(100, -100);
+    auto result = pd::detect(loud, bass, -1);
+    EXPECT_EQ(-1, result.firstDownbeat);
+    EXPECT_TRUE(result.phrases.empty());
+
+    loud.assign(20, -12);
+    bass.assign(20, -14);
+    result = pd::detect(loud, bass, -1);
+    EXPECT_EQ(0, result.firstDownbeat);
+    EXPECT_TRUE(result.phrases.empty());
+
+    EXPECT_TRUE(pd::detect({}, {}, -1).phrases.empty());
+}
+
+// Synthetic audio through the analyzer: 120 BPM, 8 bars noise, 16 bars
+// noise + 60 Hz sine, 8 bars noise.
+constexpr int kSampleRate = 44100;
+constexpr int kFramesPerBeat = kSampleRate / 2;
+
+class AnalyzerPhrasesTest : public MixxxTest {
+  protected:
+    void SetUp() override {
+        m_pTrack = Track::newTemporary();
+        m_frames = 32 * 4 * kFramesPerBeat;
+        m_pTrack->setAudioProperties(mixxx::audio::ChannelCount(2),
+                mixxx::audio::SampleRate(kSampleRate),
+                mixxx::audio::Bitrate(),
+                mixxx::Duration::fromSeconds(static_cast<double>(m_frames) / kSampleRate));
+        m_pTrack->trySetBeats(mixxx::Beats::fromConstTempo(
+                mixxx::audio::SampleRate(kSampleRate),
+                mixxx::audio::kStartFramePos,
+                mixxx::Bpm(120)));
+        m_samples.resize(m_frames * 2);
+        unsigned seed = 7;
+        for (SINT f = 0; f < m_frames; ++f) {
+            seed = seed * 1103515245 + 12345;
+            const double noise = static_cast<int>((seed >> 16) % 2001) / 1000.0 - 1.0;
+            const int bar = static_cast<int>(f / (4 * kFramesPerBeat));
+            double x = 0.05 * noise;
+            if (bar >= 8 && bar < 24) {
+                x = 0.1 * noise +
+                        0.4 * std::sin(2 * std::numbers::pi * 60.0 * f / kSampleRate);
+            }
+            m_samples[2 * f] = static_cast<CSAMPLE>(x);
+            m_samples[2 * f + 1] = static_cast<CSAMPLE>(x);
+        }
+    }
+
+    bool initialize(AnalyzerPhrases* pAnalyzer) {
+        return pAnalyzer->initialize(AnalyzerTrack(m_pTrack),
+                mixxx::audio::SampleRate(kSampleRate),
+                m_frames);
+    }
+
+    void process(AnalyzerPhrases* pAnalyzer) {
+        constexpr SINT kChunk = mixxx::kAnalysisSamplesPerChunk;
+        for (SINT i = 0; i < static_cast<SINT>(m_samples.size()); i += kChunk) {
+            pAnalyzer->processSamples(&m_samples[i],
+                    std::min(kChunk, static_cast<SINT>(m_samples.size()) - i));
+        }
+    }
+
+    void analyze() {
+        AnalyzerPhrases analyzer(config(), nullptr);
+        ASSERT_TRUE(initialize(&analyzer));
+        process(&analyzer);
+        analyzer.storeResults(m_pTrack);
+        analyzer.cleanup();
+    }
+
+    static TrackStructure::Phrase phrase(int startBar, int endBar, Kind kind) {
+        return {FramePos(startBar * 4.0 * kFramesPerBeat),
+                FramePos(endBar * 4.0 * kFramesPerBeat),
+                kind,
+                0};
+    }
+
+    TrackPointer m_pTrack;
+    SINT m_frames;
+    std::vector<CSAMPLE> m_samples;
+};
+
+TEST_F(AnalyzerPhrasesTest, DetectsSections) {
+    analyze();
+    const auto pStructure = m_pTrack->getStructure();
+    ASSERT_NE(nullptr, pStructure);
+    EXPECT_TRUE(pStructure->isDetected());
+    EXPECT_EQ(TrackStructure::Mood::High, pStructure->mood());
+    EXPECT_EQ(FramePos(0), pStructure->firstDownbeat());
+    ASSERT_EQ(3, pStructure->phrases().size());
+    const double bar = 4.0 * kFramesPerBeat;
+    EXPECT_EQ(FramePos(0), pStructure->phrases()[0].start);
+    EXPECT_EQ(FramePos(8 * bar), pStructure->phrases()[1].start);
+    EXPECT_EQ(FramePos(24 * bar), pStructure->phrases()[2].start);
+    EXPECT_EQ(Kind::Intro, pStructure->phrases()[0].kind);
+    EXPECT_EQ(Kind::Chorus, pStructure->phrases()[1].kind);
+    EXPECT_EQ(Kind::Outro, pStructure->phrases()[2].kind);
+
+    // Detected once: not again for the same beat grid
+    AnalyzerPhrases again(config(), nullptr);
+    EXPECT_FALSE(initialize(&again));
+}
+
+TEST_F(AnalyzerPhrasesTest, DisabledByConfig) {
+    config()->setValue(ConfigKey("[Library]", "DetectPhrases"), false);
+    AnalyzerPhrases analyzer(config(), nullptr);
+    EXPECT_FALSE(initialize(&analyzer));
+    config()->setValue(ConfigKey("[Library]", "DetectPhrases"), true);
+}
+
+TEST_F(AnalyzerPhrasesTest, RekordboxPhrasesAreNotReplaced) {
+    const auto pRekordbox = std::make_shared<const TrackStructure>(
+            TrackStructure::Mood::Mid,
+            QVector<TrackStructure::Phrase>{phrase(0, 32, Kind::Verse)},
+            FramePos(4 * kFramesPerBeat),
+            4);
+    m_pTrack->setStructure(pRekordbox);
+    AnalyzerPhrases analyzer(config(), nullptr);
+    EXPECT_FALSE(initialize(&analyzer));
+    EXPECT_EQ(pRekordbox, m_pTrack->getStructure());
+
+    const auto pDetected = std::make_shared<const TrackStructure>(
+            TrackStructure::Mood::High,
+            QVector<TrackStructure::Phrase>{phrase(0, 32, Kind::Chorus)},
+            FramePos(0),
+            4,
+            TrackStructure::Source::Detected);
+    EXPECT_FALSE(m_pTrack->trySetDetectedStructure(pDetected));
+    EXPECT_EQ(pRekordbox, m_pTrack->getStructure());
+}
+
+TEST_F(AnalyzerPhrasesTest, RekordboxArrivingDuringAnalysisWins) {
+    AnalyzerPhrases analyzer(config(), nullptr);
+    ASSERT_TRUE(initialize(&analyzer));
+    process(&analyzer);
+    const auto pRekordbox = std::make_shared<const TrackStructure>(
+            TrackStructure::Mood::Low,
+            QVector<TrackStructure::Phrase>{phrase(0, 32, Kind::Verse)},
+            FramePos(0),
+            4);
+    m_pTrack->setStructure(pRekordbox);
+    analyzer.storeResults(m_pTrack);
+    analyzer.cleanup();
+    EXPECT_EQ(pRekordbox, m_pTrack->getStructure());
+}
+
+TEST_F(AnalyzerPhrasesTest, RekordboxDownbeatIsKept) {
+    // rekordbox beat grid without phrase analysis: downbeat on beat 4
+    const FramePos downbeat(4 * kFramesPerBeat);
+    m_pTrack->setStructure(std::make_shared<const TrackStructure>(
+            TrackStructure::Mood::Unknown,
+            QVector<TrackStructure::Phrase>{},
+            downbeat,
+            4));
+    analyze();
+    const auto pStructure = m_pTrack->getStructure();
+    ASSERT_NE(nullptr, pStructure);
+    EXPECT_TRUE(pStructure->isDetected());
+    EXPECT_EQ(downbeat, pStructure->firstDownbeat());
+    EXPECT_FALSE(pStructure->phrases().isEmpty());
+}
+
+TEST_F(AnalyzerPhrasesTest, RekordboxImportReplacesDetected) {
+    analyze();
+    ASSERT_TRUE(m_pTrack->getStructure()->isDetected());
+    // what the rekordbox import paths do (setStructure)
+    const auto pRekordbox = std::make_shared<const TrackStructure>(
+            TrackStructure::Mood::Mid,
+            QVector<TrackStructure::Phrase>{phrase(0, 32, Kind::Verse)},
+            FramePos(0),
+            4);
+    m_pTrack->setStructure(pRekordbox);
+    EXPECT_EQ(pRekordbox, m_pTrack->getStructure());
+}
+
+} // namespace
