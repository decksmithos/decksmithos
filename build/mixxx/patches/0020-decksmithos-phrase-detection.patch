+TEST(TrackStructureTest, SourceRoundTrip) {
+    const TrackStructure detected(TrackStructure::Mood::High,
+            {{FramePos(0), FramePos(10), TrackStructure::PhraseKind::Chorus, 0}},
+            FramePos(0),
+            4,
+            TrackStructure::Source::Detected);
+    const auto pDetected = TrackStructure::fromByteArray(detected.toByteArray());
+    ASSERT_NE(nullptr, pDetected);
+    EXPECT_TRUE(pDetected->isDetected());
+    EXPECT_EQ(TrackStructure::Source::Detected, pDetected->source());
+
+    const TrackStructure imported(TrackStructure::Mood::Low, {}, FramePos(5), 4);
+    const auto pImported = TrackStructure::fromByteArray(imported.toByteArray());
+    ASSERT_NE(nullptr, pImported);
+    EXPECT_EQ(TrackStructure::Source::Rekordbox, pImported->source());
+}
+
+// Data written by patch 0007 (version 1, no source field) is rekordbox data
+TEST(TrackStructureTest, ReadsVersion1) {
+    QByteArray data;
+    QDataStream out(&data, QIODevice::WriteOnly);
+    out.setVersion(QDataStream::Qt_5_12);
+    out << quint32(0x44535453) << quint16(1) << quint8(2) // Mid
+        << double(1000) << qint32(4) << qint32(1)
+        << double(1000) << double(50000) << quint8(3) << quint8(0); // Bridge
+    const auto pLoaded = TrackStructure::fromByteArray(data);
+    ASSERT_NE(nullptr, pLoaded);
+    EXPECT_EQ(TrackStructure::Source::Rekordbox, pLoaded->source());
+    EXPECT_FALSE(pLoaded->isDetected());
+    EXPECT_EQ(TrackStructure::Mood::Mid, pLoaded->mood());
+    EXPECT_EQ(FramePos(1000), pLoaded->firstDownbeat());
+    ASSERT_EQ(1, pLoaded->phrases().size());
+    EXPECT_EQ(FramePos(50000), pLoaded->phrases()[0].end);
+    EXPECT_EQ(TrackStructure::PhraseKind::Bridge, pLoaded->phrases()[0].kind);
+}
+
+TEST(TrackStructureTest, RejectsUnknownVersion) {
+    QByteArray data;
+    QDataStream out(&data, QIODevice::WriteOnly);
+    out.setVersion(QDataStream::Qt_5_12);
+    out << quint32(0x44535453) << quint16(99) << quint8(0) << quint8(0)
+        << double(0) << qint32(4) << qint32(0);
+    EXPECT_EQ(nullptr, TrackStructure::fromByteArray(data));
+}
+
 } // namespace
diff --git a/src/track/track.cpp b/src/track/track.cpp
