diff --git a/src/util/threadplacement.h b/src/util/threadplacement.h
new file mode 100644
index 00000000..ed69b011
--- /dev/null
+++ b/src/util/threadplacement.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <QByteArray>
+#include <QList>
+#include <QtDebug>
+
+#ifdef __linux__
+#include <pthread.h>
+#include <sched.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#endif
+
+namespace mixxx {
+
+/// DecksmithOS: place Mixxx's threads on an appliance with a fixed number of
+/// CPUs (Linux only; without the variables nothing changes).
+///  - DECKSMITHOS_AUDIO_CPUS="3" (comma separated CPU numbers): the audio
+///    (engine) thread moves itself there; the system keeps these CPUs free.
+///  - DECKSMITHOS_BACKGROUND_NICE=10: track analysis and the library scan
+///    run with this nice value, below the GUI and the waveforms.
+namespace threadplacement {
+
+inline void moveCurrentThreadToAudioCpus() {
+#ifdef __linux__
+    const QByteArray value = qgetenv("DECKSMITHOS_AUDIO_CPUS");
+    if (value.isEmpty()) {
+        return;
+    }
+    cpu_set_t cpus;
+    CPU_ZERO(&cpus);
+    int count = 0;
+    for (const QByteArray& part : value.split(',')) {
+        bool ok = false;
+        const int cpu = part.trimmed().toInt(&ok);
+        if (ok && cpu >= 0 && cpu < CPU_SETSIZE) {
+            CPU_SET(cpu, &cpus);
+            ++count;
+        }
+    }
+    if (count == 0) {
+        return;
+    }
+    const int error = pthread_setaffinity_np(pthread_self(), sizeof(cpus), &cpus);
+    if (error != 0) {
+        qWarning() << "Audio thread: could not move to CPUs" << value << ":" << error;
+    } else {
+        qInfo() << "Audio thread on CPUs" << value;
+    }
+#endif
+}
+
+inline void lowerCurrentThreadPriority(const char* name) {
+#ifdef __linux__
+    bool ok = false;
+    const int nice = qgetenv("DECKSMITHOS_BACKGROUND_NICE").toInt(&ok);
+    if (!ok) {
+        return;
+    }
+    // On Linux, setpriority() with a thread ID applies to that thread only
+    if (setpriority(PRIO_PROCESS, static_cast<id_t>(gettid()), nice) != 0) {
+        qWarning() << name << "thread: could not set nice" << nice;
+    }
+#else
+    Q_UNUSED(name);
+#endif
+}
+
+} // namespace threadplacement
+} // namespace mixxx
