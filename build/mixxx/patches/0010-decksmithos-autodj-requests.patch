index d49f180c..9b85871e 100644
--- a/src/test/autodjprocessor_test.cpp
+++ b/src/test/autodjprocessor_test.cpp
@@ -1770,3 +1770,97 @@ TEST_F(AutoDJProcessorTest, SortHarmonic) {
     EXPECT_EQ(tracks[1]->getId(), pAutoDJTableModel->getTrackId(pAutoDJTableModel->index(1, 0)));
     EXPECT_EQ(tracks[0]->getId(), pAutoDJTableModel->getTrackId(pAutoDJTableModel->index(2, 0)));
 }
+
+TEST(AutoDJHarmonicOrderTest, RequestSlot) {
+    using mixxx::autodj::harmonicRequestSlot;
+    const QList<HarmonicTrack> queue = {
+            {124.0, key::A_MINOR},       // 0
+            {128.0, key::F_SHARP_MAJOR}, // 1: far key
+            {124.0, key::G_MAJOR},       // 2
+            {126.0, key::E_MINOR},       // 3
+    };
+    const HarmonicTrack previous{120.0, key::C_MAJOR};
+    // F# major at 128 BPM fits best next to the other F# major track
+    EXPECT_EQ(1, harmonicRequestSlot(queue, {128.0, key::F_SHARP_MAJOR}, previous, 0, 4));
+    // E minor at 126 after G major at 124 (or after the E minor track: the
+    // same fit, the earlier slot wins)...
+    const QList<HarmonicTrack> smooth = {
+            {124.0, key::A_MINOR},
+            {124.0, key::G_MAJOR},
+            {126.0, key::E_MINOR},
+    };
+    EXPECT_EQ(2, harmonicRequestSlot(smooth, {126.0, key::E_MINOR}, previous, 0, 3));
+    // ...but not beyond the last allowed slot
+    EXPECT_EQ(1, harmonicRequestSlot(smooth, {126.0, key::E_MINOR}, previous, 0, 1));
+    // nor before the first one (keep the order of requests)
+    EXPECT_EQ(2, harmonicRequestSlot(queue, {128.0, key::F_SHARP_MAJOR}, previous, 2, 4));
+    // Equal fit everywhere (nothing known): the earliest slot
+    EXPECT_EQ(0, harmonicRequestSlot(QList<HarmonicTrack>(4), {}, std::nullopt, 0, 4));
+    // Empty queue
+    EXPECT_EQ(0, harmonicRequestSlot({}, {120.0, key::C_MAJOR}, previous, 0, 4));
+}
+
+TEST_F(AutoDJProcessorTest, Request) {
+    PlaylistTableModel* pAutoDJTableModel = pProcessor->getTableModel();
+    const QList<std::pair<QString, std::pair<double, key::ChromaticKey>>> files = {
+            {"id3-test-data/cover-test-jpg.mp3", {124.0, key::A_MINOR}},
+            {"id3-test-data/cover-test-png.mp3", {128.0, key::F_SHARP_MAJOR}},
+            {"id3-test-data/cover-test-vbr.mp3", {124.0, key::G_MAJOR}},
+            {"id3-test-data/artist.mp3", {126.0, key::E_MINOR}},
+            {"id3-test-data/TOAL_TPE2.mp3", {130.0, key::D_FLAT_MAJOR}},
+            {"id3-test-data/cover-test.flac", {128.0, key::F_SHARP_MAJOR}},
+            {"id3-test-data/cover-test.ogg", {126.0, key::E_MINOR}},
+    };
+    QList<TrackPointer> tracks;
+    for (const auto& [location, bpmKey] : files) {
+        TrackPointer pTrack = getOrAddTrackByLocation(getTestDir().filePath(location));
+        ASSERT_TRUE(pTrack);
+        pTrack->trySetBpm(bpmKey.first);
+        pTrack->setKey(bpmKey.second, mixxx::track::io::key::USER);
+        tracks.append(pTrack);
+    }
+    // Queue: A minor, F# major, G major, E minor, Db major (tracks 0-4)
+    for (int i = 0; i < 5; ++i) {
+        pAutoDJTableModel->appendTrack(tracks[i]->getId());
+    }
+    const auto queue = [pAutoDJTableModel]() {
+        pAutoDJTableModel->select();
+        QList<TrackId> ids;
+        for (int row = 0; row < pAutoDJTableModel->rowCount(); ++row) {
+            ids.append(pAutoDJTableModel->getTrackId(pAutoDJTableModel->index(row, 0)));
+        }
+        return ids;
+    };
+    const auto id = [&tracks](int i) {
+        return tracks[i]->getId();
+    };
+
+    // A new F# major request goes next to the queued F# major track (before
+    // it: the same fit, sooner)
+    pProcessor->requestTracks({id(5)});
+    EXPECT_EQ(QList<TrackId>({id(0), id(5), id(1), id(2), id(3), id(4)}), queue());
+    EXPECT_TRUE(pProcessor->requestedTracks().contains(id(5)));
+
+    // A queued track moves up, at most into the first two positions here
+    config()->set(ConfigKey("[Auto DJ]", "RequestPositions"), QString("2"));
+    pProcessor->requestTracks({id(4)});
+    const QList<TrackId> moved = queue();
+    ASSERT_EQ(6, moved.size());
+    EXPECT_TRUE(moved.indexOf(id(4)) < 2);
+    // and never down
+    const int before = moved.indexOf(id(0));
+    pProcessor->requestTracks({id(0)});
+    EXPECT_TRUE(queue().indexOf(id(0)) <= before);
+
+    // Keep the order of requests: after the last request
+    config()->set(ConfigKey("[Auto DJ]", "RequestKeepOrder"), QString("1"));
+    config()->set(ConfigKey("[Auto DJ]", "RequestPositions"), QString("1"));
+    pProcessor->requestTracks({id(6)});
+    const QList<TrackId> ordered = queue();
+    int lastEarlierRequest = -1;
+    for (const TrackId& requested : {id(5), id(4), id(0)}) {
+        lastEarlierRequest = std::max(lastEarlierRequest,
+                static_cast<int>(ordered.indexOf(requested)));
+    }
+    EXPECT_EQ(lastEarlierRequest + 1, ordered.indexOf(id(6)));
+}
