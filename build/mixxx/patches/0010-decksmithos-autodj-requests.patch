+AutoDJProcessor::AutoDJError AutoDJProcessor::requestTracks(const QList<TrackId>& trackIds) {
+    const int positions = std::max(1,
+            m_pConfig->getValue(ConfigKey(kPreferenceGroup, QStringLiteral("RequestPositions")),
+                    kRequestPositionsDefault));
+    const bool keepOrder = m_pConfig->getValue(
+            ConfigKey(kPreferenceGroup, QStringLiteral("RequestKeepOrder")), false);
+    for (const TrackId& trackId : trackIds) {
+        requestTrack(trackId, positions, keepOrder);
+    }
+    return ADJ_OK;
+}
+
+void AutoDJProcessor::requestTrack(TrackId trackId, int positions, bool keepOrder) {
+    if (!trackId.isValid()) {
+        return;
+    }
+    for (const auto& pDeck : m_decks) {
+        const TrackPointer pLoaded = pDeck->getLoadedTrack();
+        if (pLoaded && pLoaded->getId() == trackId) {
+            qInfo() << "Auto DJ request: the track is loaded in" << pDeck->group
+                    << "already, not queued again";
+            return;
+        }
+    }
+    const auto harmonicTrack = [](const TrackPointer& pTrack) {
+        mixxx::autodj::HarmonicTrack track;
+        if (pTrack) {
+            track.bpm = pTrack->getBpm();
+            track.key = pTrack->getKey();
+        }
+        return track;
+    };
+
+    m_pAutoDJTableModel->select();
+    const int rowCount = m_pAutoDJTableModel->rowCount();
+    // A running Auto DJ has the first queued track cued (or loading) already:
+    // it stays first, and the request comes after it.
+    const int head = (m_eState != ADJ_DISABLED && rowCount > 0) ? 1 : 0;
+    if (head > 0 &&
+            m_pAutoDJTableModel->getTrackId(m_pAutoDJTableModel->index(0, 0)) ==
+                    trackId) {
+        return;
+    }
+
+    // The queue after the head, without the requested track
+    QList<int> rows;
+    QList<TrackId> ids;
+    QSet<TrackId> queued;
+    int existingRow = -1;
+    int existingSlot = -1;
+    for (int row = 0; row < rowCount; ++row) {
+        const TrackId id = m_pAutoDJTableModel->getTrackId(m_pAutoDJTableModel->index(row, 0));
+        queued.insert(id);
+        if (row < head) {
+            continue;
+        }
+        if (id == trackId && existingRow < 0) {
+            existingRow = row;
+            existingSlot = static_cast<int>(rows.size());
+            continue;
+        }
+        rows.append(row);
+        ids.append(id);
+    }
+    // Forget requests that left the queue (played, removed)
+    QSet<TrackId> requested = m_requestedTracks;
+    requested.intersect(queued);
+
+    int first = 0;
+    if (keepOrder) {
+        for (int i = static_cast<int>(ids.size()) - 1; i >= 0; --i) {
+            if (requested.contains(ids[i])) {
+                first = i + 1;
+                break;
+            }
+        }
+    }
+    if (existingSlot >= 0 && existingSlot < first) {
+        // Queued ahead of the earlier requests already: it stays.
+        requested.insert(trackId);
+        setRequestedTracks(requested);
+        return;
+    }
+    int last = std::min(static_cast<int>(ids.size()), positions - 1);
+    if (existingSlot >= 0) {
+        // A queued track only moves up
+        last = std::min(last, existingSlot);
+    }
+    last = std::max(last, first);
+
+    std::optional<mixxx::autodj::HarmonicTrack> previous;
+    if (head > 0) {
+        previous = harmonicTrack(m_pAutoDJTableModel->getTrack(m_pAutoDJTableModel->index(0, 0)));
+    } else {
+        for (const auto& pDeck : m_decks) {
+            if (pDeck->isPlaying()) {
+                previous = harmonicTrack(pDeck->getLoadedTrack());
+                break;
+            }
+        }
+    }
+    QList<mixxx::autodj::HarmonicTrack> queue;
+    const int queueSize = std::min(static_cast<int>(rows.size()), last + 1);
+    queue.reserve(queueSize);
+    for (int i = 0; i < queueSize; ++i) {
+        queue.append(harmonicTrack(m_pAutoDJTableModel->getTrack(
+                m_pAutoDJTableModel->index(rows[i], 0))));
+    }
+    const TrackPointer pRequest = m_pTrackCollectionManager->getTrackById(trackId);
+    const int slot = mixxx::autodj::harmonicRequestSlot(
+            queue, harmonicTrack(pRequest), previous, first, last);
+
+    if (existingRow >= 0) {
+        if (slot < existingSlot) {
+            m_pAutoDJTableModel->moveTrack(m_pAutoDJTableModel->index(existingRow, 0),
+                    m_pAutoDJTableModel->index(rows[slot], 0));
+        }
+    } else {
+        // An invalid index appends
+        const QModelIndex before = slot < rows.size()
+                ? m_pAutoDJTableModel->index(rows[slot], 0)
+                : QModelIndex();
+        if (m_pAutoDJTableModel->addTracksWithTrackIds(before, {trackId}, nullptr) < 1) {
+            return;
+        }
+    }
+    m_pAutoDJTableModel->select();
+    requested.insert(trackId);
+    setRequestedTracks(requested);
+}
+
+void AutoDJProcessor::setRequestedTracks(const QSet<TrackId>& trackIds) {
+    m_requestedTracks = trackIds;
+    m_pAutoDJTableModel->setHighlightedTracks(m_requestedTracks);
+}
