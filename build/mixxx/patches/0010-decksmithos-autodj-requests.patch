+void PlaylistTableModel::setHighlightedTracks(const QSet<TrackId>& trackIds) {
+    if (trackIds == m_highlightedTracks) {
+        return;
+    }
+    m_highlightedTracks = trackIds;
+    if (rowCount() > 0 && columnCount() > 0) {
+        emit dataChanged(index(0, 0),
+                index(rowCount() - 1, columnCount() - 1),
+                {Qt::BackgroundRole, Qt::FontRole});
+    }
+}
+
+QVariant PlaylistTableModel::highlightValue(const QModelIndex& index, int role) const {
+    if (m_highlightedTracks.isEmpty() || !m_highlightedTracks.contains(getTrackId(index))) {
+        return QVariant();
+    }
+    if (role == Qt::BackgroundRole) {
+        // amber, translucent like the track colors
+        return QBrush(QColor(240, 160, 32, 110));
+    }
+    if (role == Qt::FontRole) {
+        QFont font;
+        font.setBold(true);
+        return font;
+    }
+    return QVariant();
+}
