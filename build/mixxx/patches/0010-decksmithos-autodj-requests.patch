diff --git a/src/library/autodj/harmonicorder.h b/src/library/autodj/harmonicorder.h
index eaf9e948..40cbb3fb 100644
--- a/src/library/autodj/harmonicorder.h
+++ b/src/library/autodj/harmonicorder.h
@@ -119,5 +119,43 @@ inline QList<int> harmonicOrder(const QList<HarmonicTrack>& tracks,
     return order;
 }
 
+/// Where to put a requested track `request` in `queue` (the tracks that play
+/// after `previous`, in order): the slot in [first, last] (slot i = before
+/// queue[i], queue.size() = after the last one) that adds the least to the
+/// summed transition costs (harmonicTransitionCost), plus `slotCost` per slot
+/// so that, for a similar fit, the request plays sooner. Ties take the
+/// earlier slot. `last` is clamped to queue.size(), `first` to [0, last].
+inline int harmonicRequestSlot(const QList<HarmonicTrack>& queue,
+        const HarmonicTrack& request,
+        const std::optional<HarmonicTrack>& previous,
+        int first,
+        int last,
+        double slotCost = 1.0) {
+    last = std::clamp(last, 0, static_cast<int>(queue.size()));
+    first = std::clamp(first, 0, last);
+    int bestSlot = first;
+    double bestCost = 0.0;
+    for (int slot = first; slot <= last; ++slot) {
+        const HarmonicTrack* pBefore = slot > 0 ? &queue[slot - 1]
+                                                : (previous ? &*previous : nullptr);
+        const HarmonicTrack* pAfter = slot < queue.size() ? &queue[slot] : nullptr;
+        double cost = slotCost * (slot - first);
+        if (pBefore) {
+            cost += harmonicTransitionCost(*pBefore, request);
+        }
+        if (pAfter) {
+            cost += harmonicTransitionCost(request, *pAfter);
+        }
+        if (pBefore && pAfter) {
+            cost -= harmonicTransitionCost(*pBefore, *pAfter);
+        }
+        if (slot == first || cost < bestCost) {
+            bestCost = cost;
+            bestSlot = slot;
+        }
+    }
+    return bestSlot;
+}
+
 } // namespace autodj
 } // namespace mixxx
