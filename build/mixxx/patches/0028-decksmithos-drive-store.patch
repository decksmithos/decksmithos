+/// Reads the DECKSMITHOS/ analysis files of the tracks of a drive in a
+/// worker thread, like AnalysisJob
+struct UsbLibraryImporter::StoreJob {
+    struct Result {
+        QString key;
+        QJsonObject analysis;
+    };
+
+    std::atomic<bool> canceled{false};
+    std::atomic<bool> finished{false};
+    QMutex mutex;
+    QWaitCondition notFull;
+    std::deque<Result> results;
+
+    void run(const QString& mountPoint, const QList<QPair<QString, QString>>& tracks) {
+        QThread::currentThread()->setPriority(QThread::LowPriority);
+        for (const auto& [key, location] : tracks) {
+            if (canceled) {
+                break;
+            }
+            Result result;
+            result.key = key;
+            result.analysis = readAnalysisFile(mountPoint, location);
+            if (result.analysis.isEmpty()) {
+                continue;
+            }
+            QMutexLocker lock(&mutex);
+            while (results.size() >= kMaxQueuedResults && !canceled) {
+                notFull.wait(&mutex, 200);
+            }
+            results.push_back(std::move(result));
+        }
+        finished = true;
+    }
+
+    bool takeResult(Result* pResult) {
+        QMutexLocker lock(&mutex);
+        if (results.empty()) {
+            return false;
+        }
+        *pResult = std::move(results.front());
+        results.pop_front();
+        notFull.wakeAll();
+        return true;
+    }
+
+    bool isDone() {
+        QMutexLocker lock(&mutex);
+        return finished && results.empty();
+    }
+};
