+QString analysisFileName(const QString& mountPoint, const QString& location) {
+    const QString relative = relativeToDrive(mountPoint, location);
+    if (relative.isEmpty()) {
+        return QString();
+    }
+    return QString::fromLatin1(
+                   QCryptographicHash::hash(relative.toUtf8(), QCryptographicHash::Sha1)
+                           .toHex()) +
+            QStringLiteral(".json");
+}
+
+bool hasStore(const QString& mountPoint) {
+    return QFileInfo(storePath(mountPoint)).isDir();
+}
+
+StoreIndex readStoreIndex(const QString& mountPoint) {
+    StoreIndex index;
+    const QDir store(storePath(mountPoint));
+    if (!store.exists()) {
+        return index;
+    }
+    index.present = true;
+    index.writable = !QStorageInfo(mountPoint).isReadOnly() &&
+            QFileInfo(store.absolutePath()).isWritable();
+    const QStringList analysisFiles = QDir(store.filePath(kAnalysisDirectory))
+                                              .entryList(QStringList{QStringLiteral("*.json")},
+                                                      QDir::Files);
+    index.analysisFiles = QSet<QString>(analysisFiles.begin(), analysisFiles.end());
+
+    QSet<QString> listed;
+    QFile indexFile(store.filePath(kIndexFile));
+    if (indexFile.open(QIODevice::ReadOnly)) {
+        const QJsonArray lists = QJsonDocument::fromJson(indexFile.readAll())
+                                         .object()
+                                         .value(QStringLiteral("lists"))
+                                         .toArray();
+        for (const QJsonValue& value : lists) {
+            const QJsonObject object = value.toObject();
+            StoreList list;
+            list.crate = object.value(QStringLiteral("kind")).toString() == QStringLiteral("crate");
+            list.name = object.value(QStringLiteral("name")).toString();
+            list.file = object.value(QStringLiteral("file")).toString();
+            if (list.name.isEmpty() || list.file.isEmpty() ||
+                    !QFileInfo::exists(store.filePath(list.file))) {
+                continue;
+            }
+            list.locations = parseList(store.filePath(list.file));
+            listed.insert(list.file.toLower());
+            index.lists.append(list);
+        }
+    }
+    // List files without an index entry (put there by hand), by name
+    for (const bool crate : {false, true}) {
+        const QString directory = crate ? kCrateDirectory : kPlaylistDirectory;
+        QStringList files = QDir(store.filePath(directory))
+                                    .entryList(QStringList{QStringLiteral("*.m3u8"),
+                                                       QStringLiteral("*.m3u")},
+                                            QDir::Files,
+                                            QDir::Name | QDir::IgnoreCase);
+        for (const QString& fileName : files) {
+            const QString file = directory + QChar('/') + fileName;
+            if (listed.contains(file.toLower())) {
+                continue;
+            }
+            StoreList list;
+            list.crate = crate;
+            list.name = QFileInfo(fileName).completeBaseName();
+            list.file = file;
+            list.locations = parseList(store.filePath(file));
+            index.lists.append(list);
+        }
+    }
+    return index;
+}
+
+QJsonObject readAnalysisFile(const QString& mountPoint, const QString& location) {
+    const QString fileName = analysisFileName(mountPoint, location);
+    if (fileName.isEmpty()) {
+        return QJsonObject();
+    }
+    QFile file(QDir(storePath(mountPoint)).filePath(kAnalysisDirectory + QChar('/') + fileName));
+    if (!file.open(QIODevice::ReadOnly)) {
+        return QJsonObject();
+    }
+    const QJsonObject object = QJsonDocument::fromJson(file.readAll()).object();
+    // A file of another track whose path has the same hash is ignored
+    if (object.value(QStringLiteral("path")).toString() != relativeToDrive(mountPoint, location)) {
+        return QJsonObject();
+    }
+    return object;
+}
