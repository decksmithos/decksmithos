+DriveStore::DriveStore(QObject* parent, TrackCollectionManager* pTrackCollectionManager)
+        : QObject(parent),
+          m_pTrackCollectionManager(pTrackCollectionManager),
+          m_busy(false) {
+    m_writer.setMaxThreadCount(1);
+    m_writeTimer.setSingleShot(true);
+    connect(&m_writeTimer, &QTimer::timeout, this, &DriveStore::slotWritePending);
+
+    TrackCollection* pCollection = m_pTrackCollectionManager->internalCollection();
+    connect(pCollection, &TrackCollection::tracksChanged, this, &DriveStore::slotTracksChanged);
+    PlaylistDAO* pPlaylists = &pCollection->getPlaylistDAO();
+    connect(pPlaylists, &PlaylistDAO::added, this, &DriveStore::slotPlaylistAdded);
+    connect(pPlaylists, &PlaylistDAO::deleted, this, &DriveStore::slotPlaylistDeleted);
+    connect(pPlaylists, &PlaylistDAO::renamed, this, &DriveStore::slotPlaylistRenamed);
+    connect(pPlaylists, &PlaylistDAO::tracksAdded, this, &DriveStore::slotPlaylistChanged);
+    connect(pPlaylists, &PlaylistDAO::tracksMoved, this, &DriveStore::slotPlaylistChanged);
+    connect(pPlaylists, &PlaylistDAO::tracksRemoved, this, &DriveStore::slotPlaylistChanged);
+    connect(pCollection, &TrackCollection::crateInserted, this, &DriveStore::slotCrateInserted);
+    connect(pCollection, &TrackCollection::crateUpdated, this, &DriveStore::slotCrateChanged);
+    connect(pCollection, &TrackCollection::crateDeleted, this, &DriveStore::slotCrateDeleted);
+    connect(pCollection,
+            &TrackCollection::crateTracksChanged,
+            this,
+            [this](CrateId crateId, const QList<TrackId>&, const QList<TrackId>&) {
+                slotCrateChanged(crateId);
+            });
+
+    DEBUG_ASSERT(!s_pInstance);
+    s_pInstance = this;
+}
+
+DriveStore::~DriveStore() {
+    s_pInstance = nullptr;
+    m_writer.waitForDone();
+}
+
+void DriveStore::deleteStaleCrates() {
+    const QSqlDatabase database = m_pTrackCollectionManager->internalCollection()->database();
+    QSqlQuery query(database);
+    if (!query.exec(QStringLiteral("CREATE TABLE IF NOT EXISTS %1 ("
+                                   "crate_id INTEGER PRIMARY KEY, "
+                                   "mount_point TEXT NOT NULL)")
+                            .arg(kCrateTable))) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    QList<CrateId> crateIds;
+    if (query.exec(QStringLiteral("SELECT crate_id FROM %1").arg(kCrateTable))) {
+        while (query.next()) {
+            crateIds.append(CrateId(query.value(0)));
+        }
+    }
+    m_busy = true;
+    for (const CrateId& crateId : std::as_const(crateIds)) {
+        m_pTrackCollectionManager->internalCollection()->deleteCrate(crateId);
+    }
+    m_busy = false;
+    if (!query.exec(QStringLiteral("DELETE FROM %1").arg(kCrateTable))) {
+        LOG_FAILED_QUERY(query);
+    }
+    if (!crateIds.isEmpty()) {
+        qInfo() << "Drive store: deleted" << crateIds.size() << "crates of the last session";
+    }
+}
+
+// static
+void DriveStore::flush(const QString& mountPoint) {
+    DriveStore* pThis = s_pInstance;
+    if (!pThis) {
+        return;
+    }
+    Store* pStore = pThis->storeOf(mountPoint);
+    if (!pStore) {
+        return;
+    }
+    QElapsedTimer timer;
+    timer.start();
+    pThis->writeTracksNow(-1);
+    pThis->writeListsNow(pStore);
+    pThis->m_writer.waitForDone();
+    qInfo() << "Drive store: flushed" << mountPoint << "in" << timer.elapsed() << "ms";
+}
+
+DriveStore::Store* DriveStore::storeOf(const QString& mountPoint) const {
+    for (const auto& pStore : m_stores) {
+        if (pStore->mountPoint == mountPoint) {
+            return pStore.get();
+        }
+    }
+    return nullptr;
+}
+
+bool DriveStore::isStore(const QString& mountPoint) const {
+    return storeOf(mountPoint) != nullptr;
+}
+
+void DriveStore::storeAppeared(const QString& mountPoint, bool writable) {
+    Store* pStore = storeOf(mountPoint);
+    if (!pStore) {
+        auto pNew = std::make_shared<Store>();
+        pNew->mountPoint = mountPoint;
+        m_stores.append(pNew);
+        pStore = pNew.get();
+    }
+    pStore->writable = writable;
+    qInfo() << "Drive store:" << mountPoint << (writable ? "writable" : "read-only");
+}
+
+void DriveStore::storeRemoved(const QString& mountPoint) {
+    Store* pStore = storeOf(mountPoint);
+    if (!pStore) {
+        return;
+    }
+    // The drive's playlists are deleted by the importer (kPlaylistTable),
+    // its crates here
+    m_busy = true;
+    const QSqlDatabase database = m_pTrackCollectionManager->internalCollection()->database();
+    for (auto it = m_crates.begin(); it != m_crates.end();) {
+        if (it->mountPoint == mountPoint) {
+            m_pTrackCollectionManager->internalCollection()->deleteCrate(it.key());
+            QSqlQuery query(database);
+            query.prepare(QStringLiteral("DELETE FROM %1 WHERE crate_id = :id").arg(kCrateTable));
+            query.bindValue(QStringLiteral(":id"), it.key().toVariant());
+            query.exec();
+            it = m_crates.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    m_busy = false;
+    for (auto it = m_playlists.begin(); it != m_playlists.end();) {
+        it = it->mountPoint == mountPoint ? m_playlists.erase(it) : std::next(it);
+    }
+    for (int i = 0; i < m_stores.size(); ++i) {
+        if (m_stores[i]->mountPoint == mountPoint) {
+            m_stores.removeAt(i);
+            break;
+        }
+    }
+    qInfo() << "Drive store:" << mountPoint << "gone";
+}
+
+QSet<int> DriveStore::importLists(const QString& mountPoint,
+        const QList<StoreList>& lists,
+        int sortOrderBase) {
+    QSet<int> playlistIds;
+    Store* pStore = storeOf(mountPoint);
+    if (!pStore) {
+        return playlistIds;
+    }
+    pStore->sortOrderBase = sortOrderBase;
+    TrackCollection* pCollection = m_pTrackCollectionManager->internalCollection();
+    const QSqlDatabase database = pCollection->database();
+    PlaylistDAO& playlistDao = pCollection->getPlaylistDAO();
+
+    // Library ids of all locations of the lists
+    QHash<QString, TrackId> trackIds;
+    {
+        QSqlQuery query(database);
+        query.prepare(QStringLiteral(
+                "SELECT library.id FROM library "
+                "INNER JOIN track_locations ON library.location = track_locations.id "
+                "WHERE track_locations.location = :location AND library.mixxx_deleted = 0"));
+        for (const StoreList& list : lists) {
+            for (const QString& location : list.locations) {
+                if (trackIds.contains(location)) {
+                    continue;
+                }
+                query.bindValue(QStringLiteral(":location"), location);
+                if (query.exec() && query.next()) {
+                    trackIds.insert(location, TrackId(query.value(0)));
+                } else {
+                    trackIds.insert(location, TrackId());
+                }
+            }
+        }
+    }
+
+    m_busy = true;
+    int sortOrder = sortOrderBase;
+    for (const StoreList& list : lists) {
+        QList<TrackId> ids;
+        for (const QString& location : list.locations) {
+            const TrackId trackId = trackIds.value(location);
+            if (trackId.isValid()) {
+                ids.append(trackId);
+            }
+        }
+        if (list.crate) {
+            Crate crate;
+            QString name = list.name;
+            for (int n = 2; pCollection->crates().readCrateByName(name); ++n) {
+                name = QStringLiteral("%1 (%2)").arg(list.name).arg(n);
+            }
+            crate.setName(name);
+            CrateId crateId;
+            if (!pCollection->insertCrate(crate, &crateId)) {
+                qWarning() << "Drive store: cannot create crate" << name;
+                continue;
+            }
+            pCollection->addCrateTracks(crateId, ids);
+            QSqlQuery query(database);
+            query.prepare(QStringLiteral(
+                    "INSERT OR REPLACE INTO %1 (crate_id, mount_point) VALUES (:id, :mount_point)")
+                            .arg(kCrateTable));
+            query.bindValue(QStringLiteral(":id"), crateId.toVariant());
+            query.bindValue(QStringLiteral(":mount_point"), mountPoint);
+            query.exec();
+            m_crates.insert(crateId, ListRef{mountPoint, list.file});
+            pStore->order.append(qMakePair(true, crateInt(crateId)));
+        } else {
+            QString name = list.name;
+            for (int n = 2; playlistDao.getPlaylistIdFromName(name) != kInvalidPlaylistId; ++n) {
+                name = QStringLiteral("%1 (%2)").arg(list.name).arg(n);
+            }
+            int playlistId;
+            {
+                const QSignalBlocker blocker(&playlistDao);
+                playlistId = playlistDao.createPlaylist(name);
+                if (playlistId != kInvalidPlaylistId && !ids.isEmpty()) {
+                    playlistDao.appendTracksToPlaylist(ids, playlistId);
+                }
+            }
+            if (playlistId == kInvalidPlaylistId) {
+                qWarning() << "Drive store: cannot create playlist" << name;
+                continue;
+            }
+            QSqlQuery query(database);
+            query.prepare(QStringLiteral(
+                    "INSERT OR REPLACE INTO %1 (playlist_id, mount_point, sort_order) "
+                    "VALUES (:id, :mount_point, :sort_order)")
+                            .arg(kPlaylistTable));
+            query.bindValue(QStringLiteral(":id"), playlistId);
+            query.bindValue(QStringLiteral(":mount_point"), mountPoint);
+            query.bindValue(QStringLiteral(":sort_order"), sortOrder++);
+            query.exec();
+            m_playlists.insert(playlistId, ListRef{mountPoint, list.file});
+            pStore->order.append(qMakePair(false, playlistId));
+            playlistIds.insert(playlistId);
+        }
+        if (ids.size() != list.locations.size()) {
+            qInfo() << "Drive store: list" << list.name << "has"
+                    << list.locations.size() - ids.size() << "tracks that are not in the library";
+        }
+    }
+    m_busy = false;
+    qInfo() << "Drive store: imported" << lists.size() << "lists of" << mountPoint;
+    return playlistIds;
+}
+
+DriveStore::Store* DriveStore::storeForNewList() {
+    // The drive that appeared last
+    for (int i = m_stores.size() - 1; i >= 0; --i) {
+        if (m_stores[i]->writable) {
+            return m_stores[i].get();
+        }
+    }
+    return nullptr;
+}
