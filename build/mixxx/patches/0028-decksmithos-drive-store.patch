+QString DriveStore::uniqueFile(Store* pStore, bool crate, const QString& name) const {
+    const QString directory = crate ? kCrateDirectory : kPlaylistDirectory;
+    const QString base = safeFileName(name);
+    QSet<QString> used;
+    for (const auto& ref : m_playlists) {
+        if (ref.mountPoint == pStore->mountPoint) {
+            used.insert(ref.file.toLower());
+        }
+    }
+    for (const auto& ref : m_crates) {
+        if (ref.mountPoint == pStore->mountPoint) {
+            used.insert(ref.file.toLower());
+        }
+    }
+    QString file = directory + QChar('/') + base + kListSuffix;
+    for (int n = 2; used.contains(file.toLower()); ++n) {
+        file = QStringLiteral("%1/%2 (%3)%4").arg(directory, base).arg(n).arg(kListSuffix);
+    }
+    return file;
+}
+
+void DriveStore::slotPlaylistAdded(int playlistId) {
+    if (m_busy || m_playlists.contains(playlistId)) {
+        return;
+    }
+    PlaylistDAO& playlistDao = m_pTrackCollectionManager->internalCollection()->getPlaylistDAO();
+    if (playlistDao.getHiddenType(playlistId) != PlaylistDAO::PLHT_NOT_HIDDEN) {
+        return; // Auto DJ queue, history
+    }
+    Store* pStore = storeForNewList();
+    if (!pStore) {
+        return;
+    }
+    const QString name = playlistDao.getPlaylistName(playlistId);
+    m_playlists.insert(playlistId, ListRef{pStore->mountPoint, uniqueFile(pStore, false, name)});
+    pStore->order.append(qMakePair(false, playlistId));
+    QSqlQuery query(m_pTrackCollectionManager->internalCollection()->database());
+    query.prepare(QStringLiteral(
+            "INSERT OR REPLACE INTO %1 (playlist_id, mount_point, sort_order) "
+            "VALUES (:id, :mount_point, :sort_order)")
+                    .arg(kPlaylistTable));
+    query.bindValue(QStringLiteral(":id"), playlistId);
+    query.bindValue(QStringLiteral(":mount_point"), pStore->mountPoint);
+    query.bindValue(QStringLiteral(":sort_order"),
+            pStore->sortOrderBase + kNewListSortOffset + pStore->newLists++);
+    query.exec();
+    qInfo() << "Drive store: playlist" << name << "belongs to" << pStore->mountPoint;
+    listChanged(false, playlistId);
+}
+
+void DriveStore::slotPlaylistDeleted(int playlistId) {
+    if (m_busy) {
+        return;
+    }
+    const auto it = m_playlists.constFind(playlistId);
+    if (it == m_playlists.constEnd()) {
+        return;
+    }
+    Store* pStore = storeOf(it->mountPoint);
+    if (pStore && pStore->writable) {
+        enqueueRemove(QDir(storePath(it->mountPoint)).filePath(it->file));
+        pStore->order.removeAll(qMakePair(false, playlistId));
+        pStore->listsDirty = true;
+        scheduleWrite();
+    }
+    m_playlists.erase(it);
+}
+
+void DriveStore::slotPlaylistRenamed(int playlistId, const QString& name) {
+    if (m_busy) {
+        return;
+    }
+    auto it = m_playlists.find(playlistId);
+    if (it == m_playlists.end()) {
+        return;
+    }
+    Store* pStore = storeOf(it->mountPoint);
+    if (!pStore || !pStore->writable) {
+        return;
+    }
+    enqueueRemove(QDir(storePath(it->mountPoint)).filePath(it->file));
+    it->file = QString(); // not counted as used
+    it->file = uniqueFile(pStore, false, name);
+    listChanged(false, playlistId);
+}
+
+void DriveStore::slotPlaylistChanged(const QSet<int>& playlistIds) {
+    for (const int playlistId : playlistIds) {
+        if (m_playlists.contains(playlistId)) {
+            listChanged(false, playlistId);
+        }
+    }
+}
+
+void DriveStore::slotCrateInserted(CrateId crateId) {
+    if (m_busy || m_crates.contains(crateId)) {
+        return;
+    }
+    Store* pStore = storeForNewList();
+    if (!pStore) {
+        return;
+    }
+    const QString name = listName(true, crateInt(crateId));
+    m_crates.insert(crateId, ListRef{pStore->mountPoint, uniqueFile(pStore, true, name)});
+    pStore->order.append(qMakePair(true, crateInt(crateId)));
+    QSqlQuery query(m_pTrackCollectionManager->internalCollection()->database());
+    query.prepare(QStringLiteral(
+            "INSERT OR REPLACE INTO %1 (crate_id, mount_point) VALUES (:id, :mount_point)")
+                    .arg(kCrateTable));
+    query.bindValue(QStringLiteral(":id"), crateId.toVariant());
+    query.bindValue(QStringLiteral(":mount_point"), pStore->mountPoint);
+    query.exec();
+    qInfo() << "Drive store: crate" << name << "belongs to" << pStore->mountPoint;
+    listChanged(true, crateInt(crateId));
+}
+
+void DriveStore::slotCrateChanged(CrateId crateId) {
+    if (m_busy) {
+        return;
+    }
+    auto it = m_crates.find(crateId);
+    if (it == m_crates.end()) {
+        return;
+    }
+    Store* pStore = storeOf(it->mountPoint);
+    if (!pStore || !pStore->writable) {
+        return;
+    }
+    // Renamed?
+    const QString name = listName(true, crateInt(crateId));
+    if (QFileInfo(it->file).completeBaseName() != safeFileName(name) &&
+            !QFileInfo(it->file).completeBaseName().startsWith(safeFileName(name) + " (")) {
+        enqueueRemove(QDir(storePath(it->mountPoint)).filePath(it->file));
+        it->file = QString();
+        it->file = uniqueFile(pStore, true, name);
+    }
+    listChanged(true, crateInt(crateId));
+}
+
+void DriveStore::slotCrateDeleted(CrateId crateId) {
+    if (m_busy) {
+        return;
+    }
+    const auto it = m_crates.constFind(crateId);
+    if (it == m_crates.constEnd()) {
+        return;
+    }
+    Store* pStore = storeOf(it->mountPoint);
+    if (pStore && pStore->writable) {
+        enqueueRemove(QDir(storePath(it->mountPoint)).filePath(it->file));
+        pStore->order.removeAll(qMakePair(true, crateInt(crateId)));
+        pStore->listsDirty = true;
+        scheduleWrite();
+    }
+    QSqlQuery query(m_pTrackCollectionManager->internalCollection()->database());
+    query.prepare(QStringLiteral("DELETE FROM %1 WHERE crate_id = :id").arg(kCrateTable));
+    query.bindValue(QStringLiteral(":id"), crateId.toVariant());
+    query.exec();
+    m_crates.erase(it);
+}
+
+void DriveStore::listChanged(bool crate, int id) {
+    const ListRef ref = crate ? m_crates.value(CrateId(QVariant(id))) : m_playlists.value(id);
+    Store* pStore = storeOf(ref.mountPoint);
+    if (!pStore || !pStore->writable) {
+        return;
+    }
+    pStore->listsDirty = true;
+    scheduleWrite();
+}
+
+QString DriveStore::listName(bool crate, int id) const {
+    if (!crate) {
+        return m_pTrackCollectionManager->internalCollection()->getPlaylistDAO().getPlaylistName(id);
+    }
+    QSqlQuery query(m_pTrackCollectionManager->internalCollection()->database());
+    query.prepare(QStringLiteral("SELECT name FROM crates WHERE id = :id"));
+    query.bindValue(QStringLiteral(":id"), id);
+    if (query.exec() && query.next()) {
+        return query.value(0).toString();
+    }
+    return QString();
+}
+
+QStringList DriveStore::listLocations(bool crate, int id) const {
+    QStringList locations;
+    QSqlQuery query(m_pTrackCollectionManager->internalCollection()->database());
+    query.setForwardOnly(true);
+    if (crate) {
+        query.prepare(QStringLiteral(
+                "SELECT track_locations.location FROM crate_tracks "
+                "INNER JOIN library ON crate_tracks.track_id = library.id "
+                "INNER JOIN track_locations ON library.location = track_locations.id "
+                "WHERE crate_tracks.crate_id = :id "
+                "ORDER BY library.artist, library.title"));
+    } else {
+        query.prepare(QStringLiteral(
+                "SELECT track_locations.location FROM PlaylistTracks "
+                "INNER JOIN library ON PlaylistTracks.track_id = library.id "
+                "INNER JOIN track_locations ON library.location = track_locations.id "
+                "WHERE PlaylistTracks.playlist_id = :id "
+                "ORDER BY PlaylistTracks.position"));
+    }
+    query.bindValue(QStringLiteral(":id"), id);
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+        return locations;
+    }
+    while (query.next()) {
+        locations.append(query.value(0).toString());
+    }
+    return locations;
+}
+
+void DriveStore::writeListsNow(Store* pStore) {
+    if (!pStore->writable || !pStore->listsDirty) {
+        return;
+    }
+    pStore->listsDirty = false;
+    const QDir store(storePath(pStore->mountPoint));
+    QJsonArray lists;
+    for (const auto& entry : std::as_const(pStore->order)) {
+        const bool crate = entry.first;
+        const ListRef ref = crate ? m_crates.value(CrateId(QVariant(entry.second)))
+                                  : m_playlists.value(entry.second);
+        if (ref.file.isEmpty()) {
+            continue;
+        }
+        QJsonObject list;
+        list[QStringLiteral("kind")] = crate ? QStringLiteral("crate") : QStringLiteral("playlist");
+        list[QStringLiteral("name")] = listName(crate, entry.second);
+        list[QStringLiteral("file")] = ref.file;
+        lists.append(list);
+        const QString path = store.filePath(ref.file);
+        enqueueWrite(path, listFileContent(path, listLocations(crate, entry.second)));
+    }
+    QJsonObject index;
+    index[QStringLiteral("format")] = QStringLiteral("DecksmithOS drive library");
+    index[QStringLiteral("version")] = kFormatVersion;
+    index[QStringLiteral("lists")] = lists;
+    enqueueWrite(store.filePath(kIndexFile), QJsonDocument(index).toJson());
+}
+
+void DriveStore::slotTracksChanged(const QSet<TrackId>& trackIds) {
+    if (m_stores.isEmpty() || trackIds.isEmpty()) {
+        return;
+    }
+    bool anyWritable = false;
+    for (const auto& pStore : std::as_const(m_stores)) {
+        anyWritable = anyWritable || pStore->writable;
+    }
+    if (!anyWritable) {
+        return;
+    }
+    QStringList ids;
+    for (const TrackId& trackId : trackIds) {
+        ids.append(trackId.toString());
+    }
+    QSqlQuery query(m_pTrackCollectionManager->internalCollection()->database());
+    query.setForwardOnly(true);
+    if (!query.exec(QStringLiteral(
+                "SELECT library.id, track_locations.location FROM library "
+                "INNER JOIN track_locations ON library.location = track_locations.id "
+                "WHERE library.id IN (%1)")
+                            .arg(ids.join(QChar(','))))) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    while (query.next()) {
+        const QString location = query.value(1).toString();
+        for (const auto& pStore : std::as_const(m_stores)) {
+            if (pStore->writable && !relativeToDrive(pStore->mountPoint, location).isEmpty()) {
+                m_pendingTracks.insert(TrackId(query.value(0)));
+                break;
+            }
+        }
+    }
+    if (!m_pendingTracks.isEmpty()) {
+        scheduleWrite();
+    }
+}
+
+void DriveStore::scheduleWrite() {
+    if (!m_writeTimer.isActive()) {
+        m_writeTimer.start(kWriteDelayMillis);
+    }
+}
+
+void DriveStore::slotWritePending() {
+    writeTracksNow(kWriteBudgetMillis);
+    for (const auto& pStore : std::as_const(m_stores)) {
+        writeListsNow(pStore.get());
+    }
+    if (!m_pendingTracks.isEmpty()) {
+        m_writeTimer.start(50);
+    }
+}
+
+void DriveStore::writeTracksNow(int maxMillis) {
+    QElapsedTimer timer;
+    timer.start();
+    while (!m_pendingTracks.isEmpty() && (maxMillis < 0 || timer.elapsed() < maxMillis)) {
+        const TrackId trackId = *m_pendingTracks.begin();
+        m_pendingTracks.erase(m_pendingTracks.begin());
+        const TrackPointer pTrack = m_pTrackCollectionManager->getTrackById(trackId);
+        if (!pTrack) {
+            continue;
+        }
+        const QString location = pTrack->getLocation();
+        for (const auto& pStore : std::as_const(m_stores)) {
+            const QString fileName = analysisFileName(pStore->mountPoint, location);
+            if (!pStore->writable || fileName.isEmpty()) {
+                continue;
+            }
+            const QJsonObject object = trackToJson(pTrack, pStore->mountPoint);
+            enqueueWrite(QDir(storePath(pStore->mountPoint))
+                                 .filePath(kAnalysisDirectory + QChar('/') + fileName),
+                    QJsonDocument(object).toJson(QJsonDocument::Compact));
+            break;
+        }
+    }
+}
+
+QJsonObject DriveStore::trackToJson(const TrackPointer& pTrack, const QString& mountPoint) {
+    QJsonObject object;
+    object[QStringLiteral("format")] = QStringLiteral("DecksmithOS track analysis");
+    object[QStringLiteral("version")] = kFormatVersion;
+    object[QStringLiteral("path")] = relativeToDrive(mountPoint, pTrack->getLocation());
+    object[QStringLiteral("artist")] = pTrack->getArtist();
+    object[QStringLiteral("title")] = pTrack->getTitle();
+    object[QStringLiteral("sampleRate")] = static_cast<int>(pTrack->getSampleRate().value());
+    object[QStringLiteral("bpm")] = pTrack->getBpm();
+    object[QStringLiteral("bpmLocked")] = pTrack->isBpmLocked();
+    if (const auto pBeats = pTrack->getBeats()) {
+        QJsonObject beats;
+        beats[QStringLiteral("version")] = pBeats->getVersion();
+        beats[QStringLiteral("subVersion")] = pBeats->getSubVersion();
+        beats[QStringLiteral("data")] = base64(pBeats->toByteArray());
+        object[QStringLiteral("beats")] = beats;
+    }
+    const Keys keys = pTrack->getKeys();
+    if (keys.getGlobalKey() != mixxx::track::io::key::INVALID) {
+        QJsonObject keysObject;
+        keysObject[QStringLiteral("version")] = keys.getVersion();
+        keysObject[QStringLiteral("subVersion")] = keys.getSubVersion();
+        keysObject[QStringLiteral("data")] = base64(keys.toByteArray());
+        keysObject[QStringLiteral("text")] = pTrack->getKeyText();
+        object[QStringLiteral("keys")] = keysObject;
+    }
+    object[QStringLiteral("cues")] = cuesToJson(pTrack);
+    const mixxx::ReplayGain replayGain = pTrack->getReplayGain();
+    QJsonObject gain;
+    gain[QStringLiteral("ratio")] = replayGain.getRatio();
+    gain[QStringLiteral("peak")] = static_cast<double>(replayGain.getPeak());
+    object[QStringLiteral("replayGain")] = gain;
+    const auto color = pTrack->getColor();
+    object[QStringLiteral("color")] =
+            color ? QJsonValue(static_cast<qint64>(*color)) : QJsonValue();
+    object[QStringLiteral("rating")] = pTrack->getRating();
+    if (const auto pStructure = pTrack->getStructure()) {
+        object[QStringLiteral("structure")] = base64(pStructure->toByteArray());
+    }
+    if (pTrack->getId().isValid()) {
+        QJsonArray waveforms;
+        AnalysisDao& analysisDao =
+                m_pTrackCollectionManager->internalCollection()->getAnalysisDAO();
+        for (const auto type : {AnalysisDao::TYPE_WAVEFORM, AnalysisDao::TYPE_WAVESUMMARY}) {
+            const QList<AnalysisDao::AnalysisInfo> analyses =
+                    analysisDao.getAnalysesForTrackByType(pTrack->getId(), type);
+            for (const auto& analysis : analyses) {
+                QJsonObject waveform;
+                waveform[QStringLiteral("type")] = static_cast<int>(analysis.type);
+                waveform[QStringLiteral("version")] = analysis.version;
+                waveform[QStringLiteral("description")] = analysis.description;
+                waveform[QStringLiteral("data")] = base64(qCompress(analysis.data, 9));
+                waveforms.append(waveform);
+            }
+        }
+        object[QStringLiteral("waveforms")] = waveforms;
+    }
+    return object;
+}
+
+void DriveStore::applyAnalysis(const TrackPointer& pTrack, const QJsonObject& object) {
+    if (!pTrack || object.isEmpty()) {
+        return;
+    }
+    const auto sampleRate = mixxx::audio::SampleRate(
+            object.value(QStringLiteral("sampleRate")).toInt());
+    const QJsonObject beatsObject = object.value(QStringLiteral("beats")).toObject();
+    if (!beatsObject.isEmpty() && sampleRate.isValid()) {
+        const auto pBeats = mixxx::Beats::fromByteArray(sampleRate,
+                beatsObject.value(QStringLiteral("version")).toString(),
+                beatsObject.value(QStringLiteral("subVersion")).toString(),
+                fromBase64(beatsObject.value(QStringLiteral("data"))));
+        const auto pOldBeats = pTrack->getBeats();
+        if (pBeats && (!pOldBeats || pOldBeats->toByteArray() != pBeats->toByteArray())) {
+            pTrack->setBpmLocked(false);
+            pTrack->trySetBeats(pBeats);
+        }
+    }
+    const bool bpmLocked = object.value(QStringLiteral("bpmLocked")).toBool();
+    if (pTrack->isBpmLocked() != bpmLocked) {
+        pTrack->setBpmLocked(bpmLocked);
+    }
+
+    const QJsonObject keysObject = object.value(QStringLiteral("keys")).toObject();
+    if (!keysObject.isEmpty()) {
+        QByteArray data = fromBase64(keysObject.value(QStringLiteral("data")));
+        const Keys keys = KeyFactory::loadKeysFromByteArray(
+                keysObject.value(QStringLiteral("version")).toString(),
+                keysObject.value(QStringLiteral("subVersion")).toString(),
+                &data);
+        if (keys.getGlobalKey() != mixxx::track::io::key::INVALID &&
+                keys.toByteArray() != pTrack->getKeys().toByteArray()) {
+            pTrack->setKeys(keys);
+        }
+    }
+
+    const QJsonArray cues = object.value(QStringLiteral("cues")).toArray();
+    if (cues != cuesToJson(pTrack)) {
+        for (const auto type : {mixxx::CueType::HotCue,
+                     mixxx::CueType::Loop,
+                     mixxx::CueType::Jump,
+                     mixxx::CueType::Intro,
+                     mixxx::CueType::Outro,
+                     mixxx::CueType::N60dBSound}) {
+            pTrack->removeCuesOfType(type);
+        }
+        for (const QJsonValue& value : cues) {
+            const QJsonObject cue = value.toObject();
+            const auto type = static_cast<mixxx::CueType>(cue.value(QStringLiteral("type")).toInt());
+            const QJsonValue positionValue = cue.value(QStringLiteral("position"));
+            const auto start = positionValue.isDouble()
+                    ? mixxx::audio::FramePos(positionValue.toDouble())
+                    : mixxx::audio::FramePos();
+            if (type == mixxx::CueType::MainCue) {
+                pTrack->setMainCuePosition(start);
+                continue;
+            }
+            const double length = cue.value(QStringLiteral("length")).toDouble();
+            const auto end = start.isValid() && length != 0
+                    ? mixxx::audio::FramePos(start.value() + length)
+                    : mixxx::audio::FramePos();
+            const auto color = mixxx::RgbColor(static_cast<mixxx::RgbColor::code_t>(
+                    cue.value(QStringLiteral("color")).toInteger()));
+            CuePointer pCue = pTrack->createAndAddCue(
+                    type, cue.value(QStringLiteral("hotCue")).toInt(-1), start, end, color);
+            pCue->setLabel(cue.value(QStringLiteral("label")).toString());
+        }
+    }
+
+    const QJsonObject gain = object.value(QStringLiteral("replayGain")).toObject();
+    const mixxx::ReplayGain replayGain(gain.value(QStringLiteral("ratio")).toDouble(),
+            static_cast<CSAMPLE>(gain.value(QStringLiteral("peak")).toDouble()));
+    if (replayGain.hasRatio() && !(replayGain == pTrack->getReplayGain())) {
+        pTrack->setReplayGain(replayGain);
+    }
+    const QJsonValue colorValue = object.value(QStringLiteral("color"));
+    const auto color = colorValue.isDouble()
+            ? mixxx::RgbColor::optional(static_cast<mixxx::RgbColor::code_t>(colorValue.toInteger()))
+            : mixxx::RgbColor::nullopt();
+    if (pTrack->getColor() != color) {
+        pTrack->setColor(color);
+    }
+    const int rating = object.value(QStringLiteral("rating")).toInt();
+    if (pTrack->getRating() != rating) {
+        pTrack->setRating(rating);
+    }
+
+    TrackCollection* pCollection = m_pTrackCollectionManager->internalCollection();
+    const QByteArray structureData = fromBase64(object.value(QStringLiteral("structure")));
+    if (!structureData.isEmpty()) {
+        const auto pStructure = mixxx::TrackStructure::fromByteArray(structureData);
+        const auto pOldStructure = pTrack->getStructure();
+        if (pStructure &&
+                (!pOldStructure || pOldStructure->toByteArray() != pStructure->toByteArray())) {
+            pTrack->setStructure(pStructure);
+            if (pTrack->getId().isValid()) {
+                pCollection->getAnalysisDAO().saveTrackStructure(pTrack->getId(), pStructure);
+            }
+        }
+    }
+
+    if (pTrack->getId().isValid()) {
+        AnalysisDao& analysisDao = pCollection->getAnalysisDAO();
+        const QJsonArray waveforms = object.value(QStringLiteral("waveforms")).toArray();
+        for (const QJsonValue& value : waveforms) {
+            const QJsonObject waveform = value.toObject();
+            const auto type = static_cast<AnalysisDao::AnalysisType>(
+                    waveform.value(QStringLiteral("type")).toInt());
+            if (type != AnalysisDao::TYPE_WAVEFORM && type != AnalysisDao::TYPE_WAVESUMMARY) {
+                continue;
+            }
+            const QString version = waveform.value(QStringLiteral("version")).toString();
+            bool present = false;
+            const QList<AnalysisDao::AnalysisInfo> existing =
+                    analysisDao.getAnalysesForTrackByType(pTrack->getId(), type);
+            for (const auto& analysis : existing) {
+                present = present || analysis.version == version;
+            }
+            if (present) {
+                continue;
+            }
+            AnalysisDao::AnalysisInfo info;
+            info.trackId = pTrack->getId();
+            info.type = type;
+            info.version = version;
+            info.description = waveform.value(QStringLiteral("description")).toString();
+            info.data = qUncompress(fromBase64(waveform.value(QStringLiteral("data"))));
+            if (!info.data.isEmpty()) {
+                for (const auto& analysis : existing) {
+                    analysisDao.deleteAnalysis(analysis.analysisId);
+                }
+                analysisDao.saveAnalysis(&info);
+            }
+        }
+    }
+}
+
+void DriveStore::enqueueWrite(const QString& path, const QByteArray& data) {
+    m_writer.start([path, data]() {
+        QThread::currentThread()->setPriority(QThread::LowestPriority);
+        writeFileAtomically(path, data);
+    });
+}
+
+void DriveStore::enqueueRemove(const QString& path) {
+    m_writer.start([path]() {
+        QFile::remove(path);
+    });
+}
