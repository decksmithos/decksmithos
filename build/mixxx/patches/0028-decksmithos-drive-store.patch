+QString storePath(const QString& mountPoint) {
+    return QDir(mountPoint).filePath(kStoreDirectory);
+}
+
+QString relativeToDrive(const QString& mountPoint, const QString& location) {
+    const QString prefix = mountPoint + QChar('/');
+    if (!location.startsWith(prefix)) {
+        return QString();
+    }
+    return location.mid(prefix.size());
+}
+
+QString base64(const QByteArray& data) {
+    return QString::fromLatin1(data.toBase64());
+}
+
+QByteArray fromBase64(const QJsonValue& value) {
+    return QByteArray::fromBase64(value.toString().toLatin1());
+}
+
+/// A list name as a file name on FAT32/exFAT/NTFS
+QString safeFileName(const QString& name) {
+    static const QRegularExpression kForbidden(QStringLiteral("[\\\\/:*?\"<>|\\x00-\\x1f]"));
+    QString fileName = name;
+    fileName.replace(kForbidden, QStringLiteral("_"));
+    fileName = fileName.trimmed();
+    while (fileName.endsWith(QChar('.'))) {
+        fileName.chop(1);
+    }
+    if (fileName.isEmpty()) {
+        fileName = QStringLiteral("List");
+    }
+    return fileName.left(100);
+}
+
+/// Writes a file under a temporary name, syncs it and renames it over the
+/// old one; skipped if the file already has this content (any thread)
+bool writeFileAtomically(const QString& path, const QByteArray& data) {
+    QFile existing(path);
+    if (existing.open(QIODevice::ReadOnly)) {
+        if (existing.size() == data.size() && existing.readAll() == data) {
+            return true;
+        }
+        existing.close();
+    }
+    const QFileInfo info(path);
+    if (!QDir().mkpath(info.absolutePath())) {
+        qWarning() << "Drive store: cannot create" << info.absolutePath();
+        return false;
+    }
+    const QString temporary =
+            info.dir().filePath(QStringLiteral(".") + info.fileName() + QStringLiteral(".tmp"));
+    QFile file(temporary);
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate) ||
+            file.write(data) != data.size() || !file.flush()) {
+        qWarning() << "Drive store: cannot write" << temporary << file.errorString();
+        file.close();
+        QFile::remove(temporary);
+        return false;
+    }
+#ifdef __linux__
+    fsync(file.handle());
+#endif
+    file.close();
+    if (std::rename(QFile::encodeName(temporary).constData(),
+                QFile::encodeName(path).constData()) != 0) {
+        qWarning() << "Drive store: cannot rename" << temporary << "to" << path;
+        QFile::remove(temporary);
+        return false;
+    }
+    return true;
+}
+
+QStringList parseList(const QString& path) {
+    QStringList locations;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        qWarning() << "Drive store: cannot read" << path;
+        return locations;
+    }
+    const QDir base = QFileInfo(path).dir();
+    const QStringList lines = QString::fromUtf8(file.readAll()).split(QChar('\n'));
+    for (QString line : lines) {
+        line = line.trimmed();
+        if (line.startsWith(QChar(0xFEFF))) {
+            line.remove(0, 1);
+        }
+        if (line.isEmpty() || line.startsWith(QChar('#'))) {
+            continue;
+        }
+        line.replace(QChar('\\'), QChar('/'));
+        if (line.startsWith(QStringLiteral("file://"))) {
+            line = QUrl(line).toLocalFile();
+        }
+        locations.append(QDir::cleanPath(
+                QDir::isAbsolutePath(line) ? line : base.absoluteFilePath(line)));
+    }
+    return locations;
+}
+
+QByteArray listFileContent(const QString& filePath, const QStringList& locations) {
+    const QDir base = QFileInfo(filePath).dir();
+    QByteArray data = QByteArrayLiteral("#EXTM3U\n");
+    for (const QString& location : locations) {
+        // Relative for the tracks of the drive (any slot, any computer),
+        // absolute for the others
+        const bool onSameDrive = !base.relativeFilePath(location).startsWith(
+                QStringLiteral("../../../"));
+        data += (onSameDrive ? base.relativeFilePath(location) : location).toUtf8();
+        data += '\n';
+    }
+    return data;
+}
+
+QJsonArray cuesToJson(const TrackPointer& pTrack) {
+    QJsonArray cues;
+    const QList<CuePointer> cuePoints = pTrack->getCuePoints();
+    for (const CuePointer& pCue : cuePoints) {
+        QJsonObject cue;
+        cue[QStringLiteral("type")] = static_cast<int>(pCue->getType());
+        cue[QStringLiteral("hotCue")] = pCue->getHotCue();
+        const auto position = pCue->getPosition();
+        cue[QStringLiteral("position")] =
+                position.isValid() ? QJsonValue(position.value()) : QJsonValue();
+        cue[QStringLiteral("length")] = pCue->getLengthFrames();
+        cue[QStringLiteral("label")] = pCue->getLabel();
+        cue[QStringLiteral("color")] = static_cast<qint64>(pCue->getColor());
+        cues.append(cue);
+    }
+    return cues;
+}
