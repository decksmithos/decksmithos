+#pragma once
+
+// DecksmithOS: the DJ's own library data kept on a USB drive, in a folder
+// DECKSMITHOS/ at the root of the drive (part of the USB import,
+// DECKSMITHOS_USB_IMPORT).
+//
+// A drive with this folder is mounted read-write by the system (DecksmithOS:
+// decksmithos-usb-mount; the folder is created from the system menu or by
+// hand). It holds:
+//  - Analysis/<sha1 of the path relative to the drive>.json: the analysis and
+//    the DJ's edits of a track of the drive (beat grid, keys, cues and hot
+//    cues, intro/outro, track structure, replay gain, color, rating,
+//    waveforms). Written whenever the library saves such a track; applied
+//    when the drive appears, and it wins over the rekordbox export.
+//  - Playlists/*.m3u8 and Crates/*.m3u8: the playlists and crates created
+//    while the drive is connected (and those read from the drive), as M3U8
+//    with paths relative to the file for the tracks of the drive and
+//    absolute paths for others. Mixxx, rekordbox, Serato and most players
+//    can import them.
+//  - index.json: the lists in their order, with their kind and name.
+// The lists of a drive are in the library while the drive is connected
+// (listed first, like the rekordbox playlists) and deleted when it is
+// removed. Files are written under a temporary name, synced and renamed;
+// audio files are never touched. flush() writes everything pending (EJECT).
+
+#include <QHash>
+#include <QJsonObject>
+#include <QList>
+#include <QObject>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+#include <QThreadPool>
+#include <QTimer>
+#include <memory>
+
+#include "library/trackset/crate/crateid.h"
+
+#include "track/track_decl.h"
+#include "track/trackid.h"
+
+class TrackCollectionManager;
+
+namespace mixxx {
