# DecksmithOS Plymouth script (display profile td2: 720x1280 panel used in
# landscape, so the image is rotated here; DeviceRotation is ignored by the
# script module).
# Static centered splash on pure black background.
#
# splash.png is a 768x1024 canvas with the logo in a band across its middle.
# That band (full width, BAND_H tall) is scaled proportionally to fill the
# landscape screen width, exactly like decksmithos-x-splash does in X after
# Plymouth, so the logo keeps its size and place from boot to Mixxx.

Plymouth.SetBackgroundTopColor (0, 0, 0);
Plymouth.SetBackgroundBottomColor (0, 0, 0);

BAND_H = 420;

screen.w = Window.GetWidth ();
screen.h = Window.GetHeight ();

logo.image = Image ("splash.png");
band.w = logo.image.GetWidth ();
# After the -90 degree rotation (panel mounted with the narrow glass margin
# on the left, see 90-display-rotate.conf) the band is BAND_H wide and band.w tall.
scale = Math.Min (screen.h / band.w, screen.w / BAND_H);
logo.image = logo.image.Scale (logo.image.GetWidth () * scale, logo.image.GetHeight () * scale);
logo.image = logo.image.Rotate (-1.5708);
logo.sprite = Sprite ();

logo.w = logo.image.GetWidth ();
logo.h = logo.image.GetHeight ();

logo.x = (screen.w - logo.w) / 2;
logo.y = (screen.h - logo.h) / 2;

logo.sprite.SetImage (logo.image);
logo.sprite.SetPosition (logo.x, logo.y, 0);
