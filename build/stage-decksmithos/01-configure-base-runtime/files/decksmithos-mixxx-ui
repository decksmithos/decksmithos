#!/usr/bin/python3
"""Mixxx interface actions for the system menu (runs as the session user).

  decksmithos-mixxx-ui skins             installed skins, one per line:
                                         name<TAB>min WxH or -<TAB>current|other|too-big
  decksmithos-mixxx-ui set-skin NAME     switch skin: Mixxx is stopped (it saves its
                                         settings), decksmithos-mixxx applies the skin
                                         before the next start
  decksmithos-mixxx-ui preferences       open Mixxx's preferences (Ctrl+P)
"""

import os
import re
import signal
import subprocess
import sys
import time

SKINS = "/usr/share/mixxx/skins"
SETTINGS = os.environ.get("DECKSMITHOS_MIXXX_SETTINGS", "/storage/config/mixxx")
PENDING = os.path.join(SETTINGS, "decksmithos-pending-skin")
STOP_SECONDS = 15


def current_skin():
    try:
        for line in open(os.path.join(SETTINGS, "mixxx.cfg"), encoding="utf-8"):
            if line.startswith("ResizableSkin "):
                return line.split(" ", 1)[1].strip()
    except OSError:
        pass
    return ""


def screen_size():
    try:
        out = subprocess.run(["xrandr", "--query"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r" connected (?:primary )?(\d+)x(\d+)\+", out)
        return (int(m.group(1)), int(m.group(2))) if m else None
    except (OSError, subprocess.TimeoutExpired, AttributeError):
        return None


def skins():
    cur, size = current_skin(), screen_size()
    for name in sorted(os.listdir(SKINS), key=str.lower):
        path = os.path.join(SKINS, name, "skin.xml")
        if "(64 Samplers)" in name or not os.path.isfile(path):
            continue
        m = re.search(r"<MinimumSize>\s*(\d+)\s*,\s*(\d+)", open(path, encoding="utf-8").read())
        minimum = f"{m.group(1)}x{m.group(2)}" if m else "-"
        state = "current" if name == cur else "other"
        if m and size and (int(m.group(1)) > size[0] or int(m.group(2)) > size[1]):
            state = "too-big"
        print(f"{name}\t{minimum}\t{state}")


def stop_mixxx():
    pids = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "mixxx"],
                          capture_output=True, text=True).stdout.split()
    for pid in pids:
        os.kill(int(pid), signal.SIGTERM)
    for _ in range(STOP_SECONDS * 10):
        if subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "mixxx"],
                          capture_output=True).returncode != 0:
            return True
        time.sleep(0.1)
    return False


def set_skin(name):
    if "/" in name or not os.path.isfile(os.path.join(SKINS, name, "skin.xml")):
        sys.exit(f"decksmithos-mixxx-ui: no skin '{name}'")
    tmp = PENDING + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(name + "\n")
    os.replace(tmp, PENDING)
    # The X session ends with Mixxx and starts again (display manager);
    # decksmithos-mixxx applies the pending skin before Mixxx starts.
    if not stop_mixxx():
        sys.exit("decksmithos-mixxx-ui: Mixxx did not stop; the skin is used from its next start")


def preferences():
    from Xlib import X, XK, display
    from Xlib.ext import xtest

    d = display.Display()

    def find(win):
        try:
            name = win.get_wm_name()
            if name and "Mixxx" in str(name) and win.get_attributes().map_state == X.IsViewable:
                return win
            for child in win.query_tree().children:
                found = find(child)
                if found:
                    return found
        except Exception:
            return None
        return None

    win = None
    for _ in range(20):  # the menu window may still be closing
        win = find(d.screen().root)
        if win:
            break
        time.sleep(0.1)
    if not win:
        sys.exit("decksmithos-mixxx-ui: Mixxx window not found")
    win.set_input_focus(X.RevertToParent, X.CurrentTime)
    d.sync()
    time.sleep(0.2)
    ctrl = d.keysym_to_keycode(XK.string_to_keysym("Control_L"))
    key_p = d.keysym_to_keycode(XK.string_to_keysym("p"))
    for kind, code in ((X.KeyPress, ctrl), (X.KeyPress, key_p), (X.KeyRelease, key_p), (X.KeyRelease, ctrl)):
        xtest.fake_input(d, kind, code)
        d.sync()
        time.sleep(0.03)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "skins":
        skins()
    elif cmd == "set-skin" and len(sys.argv) == 3:
        set_skin(sys.argv[2])
    elif cmd == "preferences":
        preferences()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
