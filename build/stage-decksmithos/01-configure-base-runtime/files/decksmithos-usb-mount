#!/bin/bash
# Mount USB storage read-only into fixed slots, in order of insertion:
#   first device -> /usb, second -> /usb2; further devices are ignored.
# A freed slot is reused by the next device. One slot per physical device:
# only its first mountable partition is used. The system disk is never touched.
#
# Called by decksmithos-usb-mount@<kernel name>.service (started from udev):
#   decksmithos-usb-mount add|remove <kernel name, e.g. sda1>
# and by decksmithos-system (the EJECT buttons in Mixxx, Mixxx patch 0017):
#   decksmithos-usb-mount eject <slot, e.g. /usb>
#     unmounts the slot (fails while a file on it is open, e.g. a loaded
#     track) and removes the disk from the kernel, so it can be pulled out;
#     it is mounted again only when plugged in again.
#   decksmithos-usb-mount prepare <slot>
#     creates DECKSMITHOS/ on the drive (system menu) and leaves it
#     read-write: a drive with DECKSMITHOS/ keeps the DJ's analysis,
#     playlists and crates (Mixxx patch 0028) and is mounted read-write
#     whenever it is plugged in (FAT32, exFAT, NTFS; others stay read-only)
#   decksmithos-usb-mount write <slot> on|off
#     remounts the slot read-write (on) or back read-only (off), for the
#     copy to a drive (Mixxx patch 0025): only FAT32, exFAT and NTFS (ext*
#     are mounted with noload, which allows no writing; HFS+ is not written
#     by Linux safely). "off" flushes everything first. A drive stays
#     writable only while a copy runs.
set -Eeuo pipefail

read -r -a SLOTS <<< "${DECKSMITHOS_USB_SLOTS:-/usb /usb2}"
USB_USER="dj"
LOCK="/run/decksmithos-usb.lock"

log() { printf '[decksmithos-usb] %s\n' "$*"; }

USAGE="usage: $0 add|remove <kernel name> | eject <slot> | write <slot> on|off | prepare <slot>"
STORE_DIR="DECKSMITHOS"

writable_fs() {
  case "$1" in
    vfat|exfat|ntfs3) return 0 ;;
    *) return 1 ;;
  esac
}
ACTION="${1:?${USAGE}}"
NAME="${2:?${USAGE}}"
DEV="/dev/${NAME}"

# Parent disk of a block device (the device itself if it has no parent).
disk_of() {
  local pk
  pk="$(lsblk -n -o PKNAME "$1" 2>/dev/null | head -n1 || true)"
  echo "${pk:-$(basename "$1")}"
}

system_disks() {
  local m src
  for m in / /boot/firmware /storage; do
    src="$(findmnt -n -o SOURCE "${m}" 2>/dev/null || true)"
    [[ "${src}" == /dev/* ]] && disk_of "${src}"
  done
  return 0
}

slot_source() {
  findmnt -n -o SOURCE --mountpoint "$1" 2>/dev/null || true
}

do_add() {
  exec 9>"${LOCK}"
  flock 9

  local disk fstype type opts uid gid slot src
  disk="$(disk_of "${DEV}")"

  if system_disks | grep -qxF "${disk}"; then
    log "${DEV}: on system disk ${disk}, ignoring"
    return 0
  fi

  for slot in "${SLOTS[@]}"; do
    src="$(slot_source "${slot}")"
    if [[ -n "${src}" && "$(disk_of "${src}")" == "${disk}" ]]; then
      log "${DEV}: ${disk} is already mounted at ${slot} (${src}), ignoring this partition"
      return 0
    fi
  done

  fstype="$(blkid -p -o value -s TYPE "${DEV}" 2>/dev/null || true)"
  uid="$(id -u "${USB_USER}")"
  gid="$(id -g "${USB_USER}")"
  local common="ro,nosuid,nodev,noexec"
  local owner="uid=${uid},gid=${gid},fmask=0133,dmask=0022"
  type="${fstype}"
  case "${fstype}" in
    vfat)       opts="${common},${owner},utf8,shortname=mixed,flush" ;;
    exfat)      opts="${common},${owner},iocharset=utf8" ;;
    ext3|ext4)  opts="${common},noload" ;;   # noload: never replay a journal on the stick
    ext2)       opts="${common}" ;;
    hfsplus)    opts="${common},uid=${uid},gid=${gid}" ;;
    ntfs)       type="ntfs3"; opts="${common},${owner},iocharset=utf8" ;;
    *)
      log "${DEV}: unsupported or no filesystem ('${fstype}'), ignoring"
      return 0
      ;;
  esac

  for slot in "${SLOTS[@]}"; do
    if [[ -z "$(slot_source "${slot}")" ]]; then
      mkdir -p "${slot}"
      mount -t "${type}" -o "${opts}" "${DEV}" "${slot}"
      log "${DEV} (${fstype}, $(blkid -p -o value -s LABEL "${DEV}" 2>/dev/null || true)) mounted read-only at ${slot}"
      # The DJ's own drive: DECKSMITHOS/ is written by Mixxx
      if [[ -d "${slot}/${STORE_DIR}" ]] && writable_fs "${type}"; then
        if mount -o remount,rw "${slot}"; then
          log "${slot} has ${STORE_DIR}/: read-write"
        else
          log "${slot} has ${STORE_DIR}/ but cannot be made writable"
        fi
      fi
      return 0
    fi
  done

  log "${DEV}: all slots in use (${SLOTS[*]}); at most ${#SLOTS[@]} USB storage devices are supported"
}

do_remove() {
  exec 9>"${LOCK}"
  flock 9

  local slot
  for slot in "${SLOTS[@]}"; do
    if [[ "$(slot_source "${slot}")" == "${DEV}" ]]; then
      # The device may already be gone; fall back to a lazy unmount.
      umount "${slot}" 2>/dev/null || umount -l "${slot}"
      log "${DEV} unmounted from ${slot}"
    fi
  done
}

do_eject() {
  exec 9>"${LOCK}"
  flock 9

  local slot="${NAME}" known="" s src disk
  for s in "${SLOTS[@]}"; do
    [[ "${s}" == "${slot}" ]] && known=1
  done
  [[ -n "${known}" ]] || { log "eject: ${slot} is not a USB slot (${SLOTS[*]})"; exit 2; }
  src="$(slot_source "${slot}")"
  [[ -n "${src}" ]] || { log "eject: nothing mounted at ${slot}"; return 0; }
  disk="$(disk_of "${src}")"
  sync
  if ! umount "${slot}"; then
    log "eject: ${slot} is busy (a file on it is open), not ejected"
    exit 1
  fi
  log "${src} unmounted from ${slot} (eject)"
  # Detach the disk so that it can be pulled out safely (stops/flushes it)
  if [[ -w "/sys/block/${disk}/device/delete" ]]; then
    echo 1 > "/sys/block/${disk}/device/delete" && log "${disk} detached" || true
  fi
}

do_write() {
  exec 9>"${LOCK}"
  flock 9

  local slot="${NAME}" state="${3:-}" known="" s src fstype
  for s in "${SLOTS[@]}"; do
    [[ "${s}" == "${slot}" ]] && known=1
  done
  [[ -n "${known}" ]] || { log "write: ${slot} is not a USB slot (${SLOTS[*]})"; exit 2; }
  src="$(slot_source "${slot}")"
  [[ -n "${src}" ]] || { log "write: nothing mounted at ${slot}"; exit 1; }
  fstype="$(findmnt -n -o FSTYPE --mountpoint "${slot}")"
  case "${state}" in
    on)
      case "${fstype}" in
        vfat|exfat|ntfs3) ;;
        *) log "write: ${slot} (${fstype}) is not written to"; exit 1 ;;
      esac
      mount -o remount,rw "${slot}"
      log "${src} at ${slot} writable (copy)"
      ;;
    off)
      sync -f "${slot}" 2>/dev/null || sync
      if [[ -d "${slot}/${STORE_DIR}" ]]; then
        log "${src} at ${slot} stays writable (${STORE_DIR}/)"
      else
        mount -o remount,ro "${slot}"
        log "${src} at ${slot} read-only again"
      fi
      ;;
    *) log "write: on or off, not '${state}'"; exit 2 ;;
  esac
}

do_prepare() {
  exec 9>"${LOCK}"
  flock 9

  local slot="${NAME}" known="" s src fstype
  for s in "${SLOTS[@]}"; do
    [[ "${s}" == "${slot}" ]] && known=1
  done
  [[ -n "${known}" ]] || { log "prepare: ${slot} is not a USB slot (${SLOTS[*]})"; exit 2; }
  src="$(slot_source "${slot}")"
  [[ -n "${src}" ]] || { log "prepare: nothing mounted at ${slot}"; exit 1; }
  fstype="$(findmnt -n -o FSTYPE --mountpoint "${slot}")"
  writable_fs "${fstype}" || { log "prepare: ${slot} (${fstype}) is not written to"; exit 1; }
  mount -o remount,rw "${slot}"
  mkdir -p "${slot}/${STORE_DIR}"
  sync -f "${slot}" 2>/dev/null || sync
  log "${src} at ${slot} prepared: ${STORE_DIR}/ created, read-write"
}

case "${ACTION}" in
  add)    do_add ;;
  prepare) do_prepare ;;
  remove) do_remove ;;
  eject)  do_eject ;;
  write)  do_write "$@" ;;
  *)      log "unknown action '${ACTION}'"; exit 2 ;;
esac
