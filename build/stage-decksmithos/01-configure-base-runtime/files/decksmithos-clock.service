[Unit]
Description=Restore the clock saved on /storage (saved again at shutdown)
DefaultDependencies=no
After=storage.mount
Before=time-set.target sysinit.target shutdown.target
Wants=time-set.target
Conflicts=shutdown.target
ConditionPathIsMountPoint=/storage

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/decksmithos-clock restore
ExecStop=/usr/local/sbin/decksmithos-clock save

[Install]
WantedBy=sysinit.target
