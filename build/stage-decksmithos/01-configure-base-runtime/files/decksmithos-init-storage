#!/bin/bash
# Create the DecksmithOS /storage partition on first boot.
#
# Expected GPT layout on the boot disk (see docs/disk-layout.md):
#   p1 autoboot, p2 boot_A, p3 boot_B, p4 rootfs_A, p5 rootfs_B, p6 swap
#                                                (written by the image)
#   p7 storage                                   (created here)
#
# Safety rules:
#   - only runs on a GPT disk whose partitions 1-6 carry the expected PARTLABELs;
#   - never formats a partition that already contains a filesystem, except
#     stale signatures on a partition it created itself in the same run
#     (left-over contents of a previously used disk; bmaptool does not write
#     the unused areas of the image);
#   - idempotent: re-running after success or after an interruption is safe.
set -Eeuo pipefail

STORAGE_USER="${DECKSMITHOS_STORAGE_USER:-dj}"
DEMO_LIBRARY="${DECKSMITHOS_DEMO_LIBRARY:-/usr/share/decksmithos/demo-library}"
STORAGE_LABEL="storage"
# Filesystem label until the directory structure is complete. The final label is
# set last, so an interrupted run is resumed (the service only runs while no
# filesystem is labelled "storage").
STORAGE_LABEL_PENDING="storage-new"
# Leave ~15% of the disk unallocated (project overprovisioning policy).
STORAGE_DISK_PERCENT=85
MIN_STORAGE_MIB=1024
EXPECTED_LABELS=(autoboot boot_A boot_B rootfs_A rootfs_B swap)
STORAGE_PARTN=$(( ${#EXPECTED_LABELS[@]} + 1 ))

log() {
  printf '[decksmithos-storage-init] %s\n' "$*"
}

die() {
  log "ERROR: $*"
  exit 1
}

ROOT_DISK=""

# Block device of the running root filesystem. With the read-only overlay, / is an
# overlay, so take the root= PARTUUID from the kernel command line.
root_device() {
  local partuuid
  partuuid="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^root=PARTUUID=//p' | tail -n1)"
  if [[ -n "${partuuid}" && -e "/dev/disk/by-partuuid/${partuuid}" ]]; then
    readlink -f "/dev/disk/by-partuuid/${partuuid}"
  else
    findmnt -n -o SOURCE /
  fi
}

detect_root_disk() {
  local root_dev parent
  root_dev="$(root_device)"
  parent="$(lsblk -n -o PKNAME "${root_dev}" | head -n1)"
  [[ -n "${parent}" ]] || die "Cannot determine parent disk of ${root_dev}"
  ROOT_DISK="/dev/${parent}"
  log "Root device ${root_dev} on disk ${ROOT_DISK}"
}

partition_path() {
  # Partition device path for partition number $1 on ROOT_DISK.
  lsblk -l -n -p -o NAME,PARTN "${ROOT_DISK}" | awk -v n="$1" '$2==n {print $1}'
}

partlabel() {
  # Read the GPT partition name straight from disk (does not depend on the udev db).
  blkid -p -o value -s PART_ENTRY_NAME "$1" 2>/dev/null || true
}

validate_layout() {
  local pttype i dev label
  pttype="$(blkid -p -o value -s PTTYPE "${ROOT_DISK}" 2>/dev/null || true)"
  [[ "${pttype}" == "gpt" ]] || die "Partition table on ${ROOT_DISK} is '${pttype}', expected 'gpt'"

  for i in "${!EXPECTED_LABELS[@]}"; do
    dev="$(partition_path $((i + 1)))"
    [[ -n "${dev}" ]] || die "Partition $((i + 1)) missing on ${ROOT_DISK}"
    label="$(partlabel "${dev}")"
    [[ "${label}" == "${EXPECTED_LABELS[$i]}" ]] \
      || die "Partition ${dev} has PARTLABEL '${label}', expected '${EXPECTED_LABELS[$i]}'"
  done

  # Anything beyond the storage partition, or one with a foreign label, means this
  # is not our disk layout.
  local count
  count="$(lsblk -l -n -o PARTN "${ROOT_DISK}" | awk 'NF' | wc -l)"
  (( count <= STORAGE_PARTN )) || die "Unexpected partitions on ${ROOT_DISK} (${count} found); refusing to touch it"
}

create_storage_partition() {
  local disk_mib swap_end_mib start_mib end_mib swap_partn=$(( STORAGE_PARTN - 1 ))

  # The image is smaller than the disk: move the backup GPT to the real end of the disk.
  log "Relocating backup GPT to end of ${ROOT_DISK}"
  sfdisk --relocate gpt-bak-std "${ROOT_DISK}"

  disk_mib=$(( $(blockdev --getsize64 "${ROOT_DISK}") / 1024 / 1024 ))
  swap_end_mib="$(parted -sm "${ROOT_DISK}" unit MiB print | awk -F: -v n="${swap_partn}" '$1==n {gsub("MiB","",$3); print int($3)}')"
  [[ -n "${swap_end_mib}" ]] || die "Could not determine end of partition ${swap_partn} (swap)"

  start_mib=$(( swap_end_mib + 1 ))
  end_mib=$(( disk_mib * STORAGE_DISK_PERCENT / 100 ))
  (( end_mib - start_mib >= MIN_STORAGE_MIB )) \
    || die "Not enough space for storage: ${start_mib}-${end_mib} MiB on ${disk_mib} MiB disk"

  log "Creating partition ${STORAGE_PARTN} '${STORAGE_LABEL}': ${start_mib}MiB -> ${end_mib}MiB (disk ${disk_mib}MiB)"
  parted -s "${ROOT_DISK}" unit MiB mkpart "${STORAGE_LABEL}" ext4 "${start_mib}" "${end_mib}"
  partprobe "${ROOT_DISK}" || true
  udevadm settle
}

format_storage_partition() {
  local dev="$1" fstype
  fstype="$(blkid -p -o value -s TYPE "${dev}" || true)"
  if [[ -n "${fstype}" ]]; then
    die "${dev} already contains a '${fstype}' filesystem; refusing to format it"
  fi
  log "Formatting ${dev} as ext4"
  mkfs.ext4 -F -L "${STORAGE_LABEL_PENDING}" -m 0 "${dev}"
}

POPULATE_MNT=""
cleanup() {
  if [[ -n "${POPULATE_MNT}" ]]; then
    umount "${POPULATE_MNT}" 2>/dev/null || true
    rmdir "${POPULATE_MNT}" 2>/dev/null || true
  fi
}
trap cleanup EXIT

populate_storage() {
  local dev="$1" mnt
  mnt="$(mktemp -d)"
  POPULATE_MNT="${mnt}"
  mount "${dev}" "${mnt}"
  mkdir -p "${mnt}"/{library,recordings,logs,config,exports,cache,crates}
  chown "${STORAGE_USER}:${STORAGE_USER}" "${mnt}"/{library,recordings,config,exports,cache,crates}
  chmod 0755 "${mnt}"/{library,recordings,config,exports,cache,crates}
  # /var/log is bind-mounted from here; keep it root-owned, with a user-writable
  # subdirectory for the Mixxx session log.
  chown root:root "${mnt}/logs"
  chmod 0755 "${mnt}/logs"
  mkdir -p "${mnt}/logs/mixxx" "${mnt}/config/mixxx"
  chown "${STORAGE_USER}:${STORAGE_USER}" "${mnt}/logs/mixxx" "${mnt}/config/mixxx"
  # Demo tracks: present only in a freshly flashed full image (update files
  # leave them out), copied once, here, when /storage is created. The marker
  # asks decksmithos-mixxx to put them into one crate per genre.
  if [[ -d "${DEMO_LIBRARY}" ]] && [[ ! -e "${mnt}/library/Demo" ]]; then
    log "Copying demo tracks to ${mnt}/library/Demo"
    rm -rf "${mnt}/library/Demo.partial"
    cp -r "${DEMO_LIBRARY}" "${mnt}/library/Demo.partial"
    chown -R "${STORAGE_USER}:${STORAGE_USER}" "${mnt}/library/Demo.partial"
    mv "${mnt}/library/Demo.partial" "${mnt}/library/Demo"
    touch "${mnt}/config/mixxx/demo-crates.pending"
    chown "${STORAGE_USER}:${STORAGE_USER}" "${mnt}/config/mixxx/demo-crates.pending"
  fi
  umount "${mnt}"
  rmdir "${mnt}"
  POPULATE_MNT=""
  log "Setting filesystem label ${STORAGE_LABEL}"
  e2label "${dev}" "${STORAGE_LABEL}"
}

main() {
  detect_root_disk
  validate_layout

  local dev created=0
  dev="$(partition_path "${STORAGE_PARTN}")"

  if [[ -z "${dev}" ]]; then
    create_storage_partition
    created=1
    dev="$(partition_path "${STORAGE_PARTN}")"
    [[ -n "${dev}" ]] || die "Partition ${STORAGE_PARTN} not detected after creation"
  else
    local label
    label="$(partlabel "${dev}")"
    [[ "${label}" == "${STORAGE_LABEL}" ]] || die "Partition ${STORAGE_PARTN} (${dev}) has PARTLABEL '${label}'; refusing to touch it"
    log "Partition ${STORAGE_PARTN} already exists: ${dev}"
  fi

  local fstype fslabel
  fstype="$(blkid -p -o value -s TYPE "${dev}" || true)"
  fslabel="$(blkid -p -o value -s LABEL "${dev}" || true)"
  if [[ -n "${fstype}" && "${created}" == 1 ]]; then
    # The partition did not exist a moment ago: what blkid finds is left over
    # from the disk's previous use, not DecksmithOS data.
    log "Stale '${fstype}' signature ('${fslabel}') on the new ${dev} (old disk contents); wiping it"
    wipefs -a "${dev}"
    fstype="" fslabel=""
  fi
  if [[ -z "${fstype}" ]]; then
    # Empty partition: first run, or a run interrupted before mkfs.
    format_storage_partition "${dev}"
    populate_storage "${dev}"
  elif [[ "${fstype}" == "ext4" && "${fslabel}" == "${STORAGE_LABEL_PENDING}" ]]; then
    log "Resuming an interrupted initialization of ${dev}"
    populate_storage "${dev}"
  else
    # A completed run, or data that is not ours: never touch it.
    log "${dev} already has a '${fstype}' filesystem labelled '${fslabel}'; nothing to do"
    exit 0
  fi

  log "Storage initialization completed; rebooting so fstab mounts /storage and /var/log"
  sync
  systemctl --no-block reboot
}

main "$@"
