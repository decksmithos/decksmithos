#!/bin/bash
#set -Eeuo pipefail

log() {
  printf '[decksmithos-storage-init] %s\n' "$*"
}

die() {
  log "ERROR: $*"
  exit 1
}

ROOT_DEV="$(findmnt -n -o SOURCE /)"
ROOT_DISK=""
ROOT_PART=""
PART_STORAGE=""
DISK_SIZE_BYTES=0
DISK_SIZE_MIB=0
TARGET_END_MIB=0
SWAP_END_MIB=0
STORAGE_START_MIB=0
STORAGE_END_MIB=0

detect_root_disk() {
  case "${ROOT_DEV}" in
    /dev/mmcblk*p[0-9]|/dev/nvme*n*p[0-9])
      ROOT_DISK="${ROOT_DEV%p[0-9]}"
      ROOT_PART="${ROOT_DEV##*p}"
      PART_STORAGE="${ROOT_DISK}p6"
      ;;
    /dev/sd[a-z][0-9])
      ROOT_DISK="${ROOT_DEV%[0-9]}"
      ROOT_PART="${ROOT_DEV##*[!0-9]}"
      PART_STORAGE="${ROOT_DISK}6"
      ;;
    *)
      die "ERROR: Unsupported root device format: ${ROOT_DEV}"
      ;;
  esac
}

partition_storage_exists() {
  [[ -b "${PART_STORAGE}" ]]
}

create_partition_storage() {
  DISK_SIZE_BYTES="$(blockdev --getsize64 "${ROOT_DISK}")"
  DISK_SIZE_MIB=$((DISK_SIZE_BYTES / 1024 / 1024))

  TARGET_END_MIB=$(( DISK_SIZE_MIB * 85 / 100 ))

  # Read end of swap / partition 5 in MiB
  SWAP_END_MIB="$(
    parted -sm "${ROOT_DISK}" unit MiB print \
      | awk -F: '$1=="5" {gsub("MiB","",$3); print int($3)}'
  )"

  [[ -n "${SWAP_END_MIB}" ]] || die "ERROR: Could not determine end of swap / partition 5"

  STORAGE_START_MIB="$((SWAP_END_MIB + 1))"
  STORAGE_END_MIB="${TARGET_END_MIB}"

  if (( STORAGE_END_MIB <= STORAGE_START_MIB + 32 )); then
    die "ERROR: Not enough free space to create storage partition! You need an larger disk!"
  fi

  swapoff -a

  log "Growing the 'extended' / partition 4 on ${ROOT_DISK}..."
  parted -f -s "${ROOT_DISK}" unit MiB resizepart 4 "${STORAGE_END_MIB}"

  log "Creating 'storage' partition on ${ROOT_DISK}: ${STORAGE_START_MIB}MiB -> ${STORAGE_END_MIB}MiB"
  parted -f -s "${ROOT_DISK}" unit MiB mkpart logical ext4 "${STORAGE_START_MIB}" "${STORAGE_END_MIB}"

  partprobe "${ROOT_DISK}" || true
  udevadm settle
  sleep 2

  [[ -b "${PART_STORAGE}" ]] || die "ERROR: Partition 'storage' was not detected after creation!"
}

format_and_mount_storage() {
  log "Formatting ${PART_STORAGE} as ext4"
  mkfs.ext4 -F -L storage "${PART_STORAGE}"
  tune2fs -m 0 "${PART_STORAGE}" || true

  mkdir -p /storage
  mount LABEL=storage /storage || die "ERROR: Partition 'storage' was not detected for mount!"

  mkdir -p \
    /storage/library \
    /storage/recordings \
    /storage/logs \
    /storage/config \
    /storage/exports \
    /storage/cache \
    /storage/crates

  chmod 777 /storage
  chmod 777 /storage/library
  chmod 777 /storage/recordings
  chmod 777 /storage/exports
  chmod 777 /storage/crates
  chmod 777 /storage/cache

  chmod 777 /storage/config
  chmod 777 /storage/logs
}

main() {
  detect_root_disk

  if partition_storage_exists; then
    log "Partition 'storage' already exists: ${PART_STORAGE}"
    exit 0
  fi

  create_partition_storage
  format_and_mount_storage

  log "Storage initialization completed. Rebooting..."
  sync
  reboot -f
}

main "$@"
