#!/bin/bash
# Start Mixxx so that it goes straight to its main interface on first boot,
# with settings, database and analysis on /storage.
#
#   settings: /storage/config/mixxx   (seeded from /usr/share/decksmithos/mixxx-defaults)
#   log:      /storage/logs/mixxx/mixxx.log  (= /var/log/mixxx/ through the bind mount)
#
# First-run dialogs avoided here (Mixxx 2.5):
#   - "Choose music library directory": a database with the library root
#     directories is created before the first start.
#   - "No output devices" / "Sound device busy": soundconfig.xml is generated for
#     the ALSA PCM "decksmithos" (/etc/asound.conf), which points at the first USB
#     playback device. Main = channels 1-2; Headphones = 3-4 if available.
#
# If /storage is not mounted, Mixxx still starts (playing has priority) with
# settings in RAM; nothing is saved in that case and a warning is logged.

STORAGE="/storage"
DEFAULTS="/usr/share/decksmithos/mixxx-defaults"
SETTINGS="${STORAGE}/config/mixxx"
LOG_DIR="${STORAGE}/logs/mixxx"
FALLBACK="/tmp/decksmithos-mixxx"
LIBRARY_DIRS=(/usb /usb2 /storage/library)
AUDIO_WAIT_SECONDS="${DECKSMITHOS_AUDIO_WAIT:-1}"

warn=""
if ! mountpoint -q "${STORAGE}" || ! mkdir -p "${SETTINGS}" 2>/dev/null || [[ ! -w "${SETTINGS}" ]]; then
  warn="WARNING: ${SETTINGS} not usable; running with volatile settings in ${FALLBACK}"
  SETTINGS="${FALLBACK}/settings"
  LOG_DIR="${FALLBACK}"
  mkdir -p "${SETTINGS}"
fi

mkdir -p "${LOG_DIR}" 2>/dev/null || true
if [[ -w "${LOG_DIR}" ]]; then
  exec >>"${LOG_DIR}/mixxx.log" 2>&1
fi
log() { echo "[$(date '+%F %T')] decksmithos-mixxx: $*"; }
log "settings=${SETTINGS}"
[[ -n "${warn}" ]] && log "${warn}"

# --- Default settings: copy only what does not exist yet ---------------------------
if [[ -d "${DEFAULTS}" ]]; then
  for f in "${DEFAULTS}"/*; do
    [[ -e "${SETTINGS}/$(basename "${f}")" ]] || cp "${f}" "${SETTINGS}/"
  done
fi

# --- Fit to the screen: finger-sized library rows, preferences dialog on screen ----
# Only values DecksmithOS set itself are changed (see the script).
/usr/local/bin/decksmithos-mixxx-autoconf "${SETTINGS}" 2>&1 | while read -r line; do log "${line}"; done

# --- Library root directories (avoids the first-run directory dialog) --------------
# Mixxx creates all tables with CREATE TABLE IF NOT EXISTS, so a database holding
# only the "directories" table is completed by Mixxx's own schema migration.
DB="${SETTINGS}/mixxxdb.sqlite"
if [[ ! -e "${DB}" ]]; then
  sql="CREATE TABLE IF NOT EXISTS directories (directory TEXT UNIQUE);"
  for d in "${LIBRARY_DIRS[@]}"; do
    sql+="INSERT OR IGNORE INTO directories (directory) VALUES ('${d}');"
  done
  if sqlite3 "${DB}" "${sql}"; then
    log "created ${DB} with library directories: ${LIBRARY_DIRS[*]}"
  else
    log "WARNING: could not create ${DB}; Mixxx will ask for a music directory"
    rm -f "${DB}"
  fi
fi

# --- Demo crates --------------------------------------------------------------------
# A freshly flashed image copies demo tracks to /storage/library/Demo/<Genre>/
# (decksmithos-init-storage) and leaves demo-crates.pending. Mixxx finds the
# tracks with its startup rescan; from the next start on, they are in the
# database, and one crate per genre folder is created here, while Mixxx is not
# running. Done once: the marker is removed.
DEMO_DIR="${STORAGE}/library/Demo"
DEMO_MARKER="${SETTINGS}/demo-crates.pending"
sql_quote() { printf "'%s'" "${1//\'/\'\'}"; }
if [[ -e "${DEMO_MARKER}" && -e "${DB}" && -d "${DEMO_DIR}" ]]; then
  found="$(sqlite3 "${DB}" "SELECT count(*) FROM track_locations WHERE directory LIKE $(sql_quote "${DEMO_DIR}/%");" 2>/dev/null || echo 0)"
  if [[ "${found}" =~ ^[0-9]+$ ]] && (( found > 0 )); then
    sql="BEGIN;"
    for genre_dir in "${DEMO_DIR}"/*/; do
      genre="$(basename "${genre_dir}")"
      sql+="INSERT OR IGNORE INTO crates (name) VALUES ($(sql_quote "${genre}"));"
      sql+="INSERT OR IGNORE INTO crate_tracks (crate_id, track_id)
              SELECT c.id, l.id FROM library l
              JOIN track_locations t ON l.location = t.id
              JOIN crates c ON c.name = $(sql_quote "${genre}")
              WHERE t.directory = $(sql_quote "${DEMO_DIR}/${genre}") AND l.mixxx_deleted = 0;"
    done
    sql+="COMMIT;"
    if sqlite3 "${DB}" "${sql}"; then
      rm -f "${DEMO_MARKER}"
      log "created demo crates for ${found} tracks in ${DEMO_DIR}"
    else
      log "WARNING: could not create the demo crates; trying again at the next start"
    fi
  fi
fi

# --- Controller audio ----------------------------------------------------------------
# soundconfig.xml for the controller's USB audio (decksmithos-soundconfig). Wait a
# few seconds for it to enumerate at boot; a controller plugged in later is picked
# up by Mixxx itself (DECKSMITHOS_SOUND_HOTPLUG_HOOK, Mixxx patch 0003).
card_found=0
for ((i = 0; i < AUDIO_WAIT_SECONDS; i++)); do
  if env_lines="$(/usr/local/bin/decksmithos-soundconfig "${SETTINGS}" 2>> "${LOG_DIR}/mixxx.log")"; then
    card_found=1
    break
  fi
  sleep 1
done
if (( card_found )); then
  # DECKSMITHOS_ALSA_CARD=<id>: the card behind the ALSA PCM "decksmithos".
  while IFS= read -r line; do
    [[ "${line}" == DECKSMITHOS_*=* ]] && export "${line?}"
  done <<< "${env_lines}"
else
  log "no USB playback device after ${AUDIO_WAIT_SECONDS}s; Mixxx starts without audio and sets it up when the controller is plugged in"
fi
export DECKSMITHOS_SOUND_HOTPLUG_HOOK="/usr/local/bin/decksmithos-soundconfig"

# --- Start Mixxx ----------------------------------------------------------------------
CORES="${DECKSMITHOS_CORES:-2,3}"
ARGS=(--settings-path "${SETTINGS}/")

renice -n -5 $$ >/dev/null 2>&1 || true
# No blocking dialogs about busy or failing sound devices: Mixxx starts silent
# instead of waiting for a click (build/mixxx/patches/0004; ignored by an
# unpatched Mixxx). The "No Output Devices" warning (no controller plugged in)
# is turned off by [Soundcard] HideNoOutputWarning (decksmithos-mixxx-autoconf,
# patch 0003).
export DECKSMITHOS_NO_SOUND_DIALOGS=1
exec taskset -c "${CORES}" mixxx "${ARGS[@]}"
