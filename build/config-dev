IMG_NAME='DecksmithOS'
RELEASE='trixie'
TARGET_HOSTNAME='decksmithos-dev'
FIRST_USER_NAME='dj'
DISABLE_FIRST_BOOT_USER_RENAME=1

ENABLE_SSH=1
STAGE_LIST='stage0 stage1 stage2 stage-decksmithos stage-decksmithos-dev'

# Build as Raspberry Pi OS Lite 64-bit
DEPLOY_ZIP=0
#DEPLOY_COMPRESSION='xz'
DEPLOY_COMPRESSION='none'

# Keep image generation deterministic enough for now
LOCALE_DEFAULT='en_US.UTF-8'
KEYBOARD_KEYMAP='us'
TIMEZONE_DEFAULT='UTC'
DEBIAN_FRONTEND=noninteractive
APT_LISTCHANGES_FRONTEND=none
DEBCONF_NONINTERACTIVE_SEEN=true

# We do not want interactive first-boot setup
SKIP_FIRST_BOOT_CONFIG=1

export DECKSMITHOS_PROFILE="${DECKSMITHOS_PROFILE:-dev}"
