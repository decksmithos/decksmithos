<Template>
  <WidgetGroup>
    <SizePolicy>me,me</SizePolicy>
    <Layout>vertical</Layout>
    <Children>
      <WidgetGroup>
        <ObjectName>LibraryWrapper</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>SidebarContainer</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,48f</Size>
            <Children>
            <!-- The library page closes from the top bar (second tap on
                 the lit button, or BROWSE) -->

            <PushButton>
                <ObjectName>SidebarButton</ObjectName>
                <Size>120f,44f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>LISTS</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>TRACKS</Text>
                </State>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                </Connection>
              </PushButton>

               <WidgetGroup><Size>20f,30f</Size></WidgetGroup>

              <SearchBox>
                <ObjectName>SearchBox</ObjectName>
                <Size>0me,44f</Size>
              </SearchBox>
              <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>LibLoadBtn</ObjectName>
                <Size>120f,44f</Size>
                <NumberStates>2</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <State><Number>0</Number><Text>LOAD 1</Text></State>
                <State><Number>1</Number><Text>LOAD 1</Text></State>
                <Connection>
                  <ConfigKey>[Channel1],LoadSelectedTrack</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>LibLoadBtn</ObjectName>
                <Size>120f,44f</Size>
                <NumberStates>2</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <State><Number>0</Number><Text>LOAD 2</Text></State>
                <State><Number>1</Number><Text>LOAD 2</Text></State>
                <Connection>
                  <ConfigKey>[Channel2],LoadSelectedTrack</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
              <!-- Auto DJ request: the selected track goes where it fits best
                   among the next tracks of the queue (or moves up there);
                   build/mixxx/patches/0010 -->
              <PushButton>
                <ObjectName>LibRequestBtn</ObjectName>
                <Size>120f,44f</Size>
                <NumberStates>2</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <State><Number>0</Number><Text>REQUEST</Text></State>
                <State><Number>1</Number><Text>REQUEST</Text></State>
                <Connection>
                  <ConfigKey>[Library],AutoDjAddRequest</ConfigKey>
                </Connection>
              </PushButton>
              <!-- EJECT USB: while a drive is mounted there; red after a
                   refused eject (a track from it is playing) -->
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>128f,44f</Size>
                <Children>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibEjectBtn</ObjectName>
                    <Size>120f,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>&#9167; USB</Text></State>
                    <State><Number>1</Number><Text>&#9167; USB</Text></State>
                    <Connection>
                      <ConfigKey>[Drives],eject_1</ConfigKey>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                    <Connection>
                      <ConfigKey>[Drives],eject_error_1</ConfigKey>
                      <ConnectValueFromWidget>false</ConnectValueFromWidget>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Drives],mounted_1</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <!-- EJECT USB2: while a drive is mounted there; red after a
                   refused eject (a track from it is playing) -->
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>128f,44f</Size>
                <Children>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibEjectBtn</ObjectName>
                    <Size>120f,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>&#9167; USB2</Text></State>
                    <State><Number>1</Number><Text>&#9167; USB2</Text></State>
                    <Connection>
                      <ConfigKey>[Drives],eject_2</ConfigKey>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                    <Connection>
                      <ConfigKey>[Drives],eject_error_2</ConfigKey>
                      <ConnectValueFromWidget>false</ConnectValueFromWidget>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Drives],mounted_2</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup><Size>4f,44f</Size></WidgetGroup>
              
            </Children>
          </WidgetGroup>
          <!-- Auto DJ row. In the Auto DJ section: Auto DJ on/off, fade to
               the next track now, the planned transition, skip the next track, order the queue by key
               (patch 0006), add a random track, keep the queue filled with
               random tracks from the source crates (or the whole library;
               patch 0022). Elsewhere: the selected track to the end of the
               queue or next, the whole list shown to the end (patch 0022),
               and for a crate: use it as an Auto DJ source (patch 0022). -->
          <WidgetGroup>
            <ObjectName>LibActionRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,48f</Size>
            <Children>
              <WidgetGroup><Size>4f,44f</Size></WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,48f</Size>
                <Children>
                  <PushButton>
                    <ObjectName>LibAdjToggleBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>AUTO DJ</Text></State>
                    <State><Number>1</Number><Text>AUTO DJ</Text></State>
                    <Connection>
                      <ConfigKey>[AutoDJ],enabled</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>FADE NOW</Text></State>
                    <State><Number>1</Number><Text>FADE NOW</Text></State>
                    <Connection>
                      <ConfigKey>[AutoDJ],fade_now</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <!-- The planned transition (DecksmithOS-AutoDJ.js); a tap
                       picks the next one that suits the two tracks -->
                  <PushButton>
                    <ObjectName>LibAdjNextBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>9</NumberStates>
                    <State><Number>0</Number><Text>NEXT: -</Text></State>
                    <State><Number>1</Number><Text>NEXT: BLEND</Text></State>
                    <State><Number>2</Number><Text>NEXT: FILTER</Text></State>
                    <State><Number>3</Number><Text>NEXT: ECHO</Text></State>
                    <State><Number>4</Number><Text>NEXT: REVERB</Text></State>
                    <State><Number>5</Number><Text>NEXT: FADE</Text></State>
                    <State><Number>6</Number><Text>NEXT: LOOP</Text></State>
                    <State><Number>7</Number><Text>NEXT: RISER</Text></State>
                    <State><Number>8</Number><Text>NEXT: BRAKE</Text></State>
                    <Connection>
                      <ConfigKey>[Skin],dsm_adj_next</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>SKIP</Text></State>
                    <State><Number>1</Number><Text>SKIP</Text></State>
                    <Connection>
                      <ConfigKey>[AutoDJ],skip_next</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>HARMONIC</Text></State>
                    <State><Number>1</Number><Text>HARMONIC</Text></State>
                    <Connection>
                      <ConfigKey>[AutoDJ],sort_harmonic</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>+ RANDOM</Text></State>
                    <State><Number>1</Number><Text>+ RANDOM</Text></State>
                    <Connection>
                      <ConfigKey>[AutoDJ],add_random_track</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibAdjToggleBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>AUTO FILL</Text></State>
                    <State><Number>1</Number><Text>AUTO FILL</Text></State>
                    <Connection>
                      <ConfigKey>[AutoDJ],random_fill</ConfigKey>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Library],active_autodj</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,48f</Size>
                <Children>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>+ QUEUE</Text></State>
                    <State><Number>1</Number><Text>+ QUEUE</Text></State>
                    <Connection>
                      <ConfigKey>[Library],AutoDjAddBottom</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>+ NEXT</Text></State>
                    <State><Number>1</Number><Text>+ NEXT</Text></State>
                    <Connection>
                      <ConfigKey>[Library],AutoDjAddTop</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>LibActionBtn</ObjectName>
                    <Size>0me,44f</Size>
                    <NumberStates>2</NumberStates>
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Text>+ ALL</Text></State>
                    <State><Number>1</Number><Text>+ ALL</Text></State>
                    <Connection>
                      <ConfigKey>[Library],AutoDjAddAllBottom</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <Size>0me,48f</Size>
                    <Children>
                      <WidgetGroup>
                        <Layout>horizontal</Layout>
                        <Size>0me,48f</Size>
                        <Children>
                          <WidgetGroup><Size>8f,44f</Size></WidgetGroup>
                          <PushButton>
                            <ObjectName>LibAdjToggleBtn</ObjectName>
                            <Size>0me,44f</Size>
                            <NumberStates>2</NumberStates>
                            <State><Number>0</Number><Text>SOURCE</Text></State>
                            <State><Number>1</Number><Text>SOURCE</Text></State>
                            <Connection>
                              <ConfigKey>[Library],crate_autodj_source</ConfigKey>
                            </Connection>
                          </PushButton>
                        </Children>
                        <Connection>
                          <ConfigKey>[Library],crate_selected</ConfigKey>
                          <BindProperty>visible</BindProperty>
                        </Connection>
                      </WidgetGroup>
                    </Children>
                    <Connection>
                      <ConfigKey>[Library],active_crates</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </WidgetGroup>
                </Children>
                <Connection>
                  <ConfigKey>[Library],active_autodj</ConfigKey>
                  <Transform><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup><Size>4f,44f</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <SizePolicy>me,me</SizePolicy>
            <Layout>horizontal</Layout>
            <Size>0me,0me</Size>
            <Children>
            <!--SIDEBAR LATERAL (PLAYLISTS)-->
            <WidgetGroup>
                <ObjectName>SidebarWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Children>
                  <LibrarySidebar>
                    <ObjectName>LibrarySidebar</ObjectName>
                    <Size>200f,0me</Size>
                  </LibrarySidebar>
                </Children>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              
              <!--LLIBRERIA-->
              <WidgetGroup>
                <ObjectName>LibraryWrapper</ObjectName>
                <Layout>horizontal</Layout>
                <Children>
                  <Library>
                    <ObjectName>Library</ObjectName>
                    <Size>0me,0me</Size>
                    <BgColor>#000</BgColor>
                    <FgColor>#75001a</FgColor>
                    <TrackTableBackgroundColorOpacity>0.4</TrackTableBackgroundColorOpacity>
                  </Library>
                </Children>
                <Connection>
                  <ConfigKey>[Sidebar],sidebar_visible</ConfigKey>
                  <Transform><Not/></Transform>
                </Connection>
              </WidgetGroup>
              
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <Template src="skin:libdecks.xml"/>
    </Children>
  </WidgetGroup>
  
</Template>
