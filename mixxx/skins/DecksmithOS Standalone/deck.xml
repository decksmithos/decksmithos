<!-- Per-deck info panel at the bottom of the main page (152 px tall):
       row 1  DECK n | title
       row 2  QUANTIZE | MT / SYNC | REMAIN or TIME (big) | TEMPO | BPM
       row 3  track overview with cue, hot cue and loop marks
     Variable: channel. Tap the time to switch remaining / elapsed. -->
<Template>
  <WidgetGroup>
    <ObjectName>Deck</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,152f</Size>
    <Children>

      <!-- Row 1 -->
      <WidgetGroup>
        <ObjectName>DeckHeader</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,36f</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>DeckNumberBox</ObjectName>
            <Layout>vertical</Layout>
            <Size>80f,36f</Size>
            <Children>
              <Label>
                <ObjectName>DeckNumberLabel</ObjectName>
                <Size>80f,13f</Size>
                <Text>DECK</Text>
                <Alignment>center</Alignment>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>80f,23f</Size>
                <Children>
                  <WidgetGroup><Size>0me,23f</Size></WidgetGroup>
                  <Label>
                    <ObjectName>DeckPlayingMark</ObjectName>
                    <Size>18f,23f</Size>
                    <Text>((</Text>
                    <Alignment>right</Alignment>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],play_indicator</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Label>
                  <Label>
                    <ObjectName>DeckNumber</ObjectName>
                    <Size>22f,23f</Size>
                    <Text><Variable name="channel"/></Text>
                    <Alignment>center</Alignment>
                  </Label>
                  <Label>
                    <ObjectName>DeckPlayingMark</ObjectName>
                    <Size>18f,23f</Size>
                    <Text>))</Text>
                    <Alignment>left</Alignment>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],play_indicator</ConfigKey>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Label>
                  <WidgetGroup><Size>0me,23f</Size></WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>10f,36f</Size></WidgetGroup>
          <Label>
            <ObjectName>DeckNote</ObjectName>
            <Size>22f,36f</Size>
            <Text>&#9834;</Text>
          </Label>
          <TrackProperty>
            <ObjectName>DeckTitleText</ObjectName>
            <Size>0me,36f</Size>
            <TooltipId>track_title</TooltipId>
            <Property>titleInfo</Property>
            <Alignment>left</Alignment>
            <Elide>right</Elide>
            <Channel><Variable name="channel"/></Channel>
          </TrackProperty>
        </Children>
      </WidgetGroup>

      <!-- Row 2 -->
      <WidgetGroup>
        <ObjectName>DeckInfoRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,66f</Size>
        <Children>

          <!-- QUANTIZE -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>80f,66f</Size>
            <Children>
              <WidgetGroup><Size>80f,0me</Size></WidgetGroup>
              <Label>
                <ObjectName>DeckSmallLabelQ</ObjectName>
                <Size>80f,16f</Size>
                <Text>QUANTIZE</Text>
                <Alignment>center</Alignment>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],quantize</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>80f,32f</Size>
                <Children>
                  <WidgetGroup><Size>0me,32f</Size></WidgetGroup>
                  <PushButton>
                    <ObjectName>DeckQuantize</ObjectName>
                    <Size>56f,32f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Text>OFF</Text></State>
                    <State><Number>1</Number><Text>ON</Text></State>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],quantize</ConfigKey>
                    </Connection>
                  </PushButton>
                  <WidgetGroup><Size>0me,32f</Size></WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup><Size>80f,0me</Size></WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- MT (keylock) and SYNC -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>86f,66f</Size>
            <Children>
              <WidgetGroup><Size>86f,0me</Size></WidgetGroup>
              <PushButton>
                <ObjectName>DeckTagMT</ObjectName>
                <Size>80f,26f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>MT</Text></State>
                <State><Number>1</Number><Text>MT</Text></State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],keylock</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>86f,6f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>DeckTagSync</ObjectName>
                <Size>80f,26f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>SYNC</Text></State>
                <State><Number>1</Number><Text>SYNC</Text></State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],sync_enabled</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>86f,0me</Size></WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- REMAIN / TIME -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>0me,66f</Size>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,16f</Size>
                <Children>
                  <Label>
                    <ObjectName>DeckTimeModeRemain</ObjectName>
                    <Size>78f,16f</Size>
                    <Text>&#8226; REMAIN</Text>
                    <Connection>
                      <ConfigKey>[Controls],ShowDurationRemaining</ConfigKey>
                      <Transform><IsEqual>1</IsEqual></Transform>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Label>
                  <Label>
                    <ObjectName>DeckSmallLabel</ObjectName>
                    <Size>8f,16f</Size>
                    <Text>/</Text>
                  </Label>
                  <Label>
                    <ObjectName>DeckTimeModeTime</ObjectName>
                    <Size>50f,16f</Size>
                    <Text>TIME</Text>
                    <Connection>
                      <ConfigKey>[Controls],ShowDurationRemaining</ConfigKey>
                      <Transform><IsEqual>0</IsEqual></Transform>
                      <BindProperty>highlight</BindProperty>
                    </Connection>
                  </Label>
                  <WidgetGroup><Size>0me,16f</Size></WidgetGroup>
                </Children>
              </WidgetGroup>
              <NumberPos>
                <ObjectName>DeckTrackTime</ObjectName>
                <Size>0me,50f</Size>
                <TooltipId>track_time</TooltipId>
                <NumberOfDigits>8</NumberOfDigits>
                <Channel><Variable name="channel"/></Channel>
                <Alignment>left</Alignment>
              </NumberPos>
            </Children>
          </WidgetGroup>

          <!-- TEMPO -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>112f,66f</Size>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>112f,20f</Size>
                <Children>
                  <Label>
                    <ObjectName>DeckSmallLabel</ObjectName>
                    <Size>56f,20f</Size>
                    <Text>TEMPO</Text>
                  </Label>
                  <WidgetGroup>
                    <ObjectName>DeckRangeBox</ObjectName>
                    <Layout>horizontal</Layout>
                    <Size>52f,20f</Size>
                    <Children>
                      <WidgetGroup><Size>0me,20f</Size></WidgetGroup>
                      <Label>
                        <ObjectName>DeckRangeText</ObjectName>
                        <Text>&#177;</Text>
                      </Label>
                      <RateRange>
                        <TooltipId>rate_range_display</TooltipId>
                        <ObjectName>DeckRangeText</ObjectName>
                        <Channel><Variable name="channel"/></Channel>
                        <Display>range</Display>
                      </RateRange>
                      <Label>
                        <ObjectName>DeckRangeText</ObjectName>
                        <Text>%</Text>
                      </Label>
                      <WidgetGroup><Size>0me,20f</Size></WidgetGroup>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>112f,46f</Size>
                <Children>
                  <NumberRate>
                    <TooltipId>rate_display</TooltipId>
                    <ObjectName>DeckTempo</ObjectName>
                    <Channel><Variable name="channel"/></Channel>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Size>90f,46f</Size>
                    <Alignment>right</Alignment>
                  </NumberRate>
                  <Label>
                    <ObjectName>DeckTempoPercent</ObjectName>
                    <Size>22f,46f</Size>
                    <Text>%</Text>
                  </Label>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>8f,66f</Size></WidgetGroup>

          <!-- BPM box: orange with MASTER on the sync leader -->
          <WidgetGroup>
            <ObjectName>DeckBPMWrapper</ObjectName>
            <Layout>vertical</Layout>
            <Size>112f,62f</Size>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],sync_leader</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>112f,18f</Size>
                <Children>
                  <Label>
                    <ObjectName>DeckBPMTitle</ObjectName>
                    <Size>40f,18f</Size>
                    <Text>BPM</Text>
                  </Label>
                  <WidgetGroup><Size>0me,18f</Size></WidgetGroup>
                  <Label>
                    <ObjectName>DeckBPMTitleMaster</ObjectName>
                    <Size>62f,18f</Size>
                    <Text>MASTER</Text>
                    <Alignment>center</Alignment>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],sync_leader</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>stacked</Layout>
                <Size>112f,44f</Size>
                <Children>
                  <NumberBpm>
                    <ObjectName>DeckBPM</ObjectName>
                    <TooltipId>visual_bpm</TooltipId>
                    <Channel><Variable name="channel"/></Channel>
                    <NumberOfDigits>1</NumberOfDigits>
                    <Alignment>right</Alignment>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],visual_bpm</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],sync_leader</ConfigKey>
                      <BindProperty>visible</BindProperty>
                      <Transform><Not/></Transform>
                    </Connection>
                  </NumberBpm>
                  <NumberBpm>
                    <ObjectName>DeckBPMMaster</ObjectName>
                    <TooltipId>visual_bpm</TooltipId>
                    <Channel><Variable name="channel"/></Channel>
                    <NumberOfDigits>1</NumberOfDigits>
                    <Alignment>right</Alignment>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],visual_bpm</ConfigKey>
                    </Connection>
                    <Connection>
                      <ConfigKey>[Channel<Variable name="channel"/>],sync_leader</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </NumberBpm>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>6f,66f</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <!-- Row 3: overview -->
      <WidgetGroup>
        <ObjectName>DeckOverviewRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,44f</Size>
        <Children>
          <WidgetGroup><Size>6f,44f</Size></WidgetGroup>
          <Overview>
            <ObjectName>DeckOverview</ObjectName>
            <Size>0me,40f</Size>
            <Channel><Variable name="channel"/></Channel>
            <BgColor>#000</BgColor>
            <SignalColor>#222</SignalColor>
            <SignalLowColor>#2a6cf0</SignalLowColor>
            <SignalMidColor>#f0a020</SignalMidColor>
            <SignalHighColor>#f3ead2</SignalHighColor>
            <PlayedOverlayColor>#66000000</PlayedOverlayColor>
            <PlayPosColor>#ff3030</PlayPosColor>
            <!-- rekordbox phrases (Mixxx patch 0007; ignored without it) -->
            <PhraseBandHeight>8</PhraseBandHeight>
            <Mark>
              <Control>cue_point</Control>
              <Text>&#9660;</Text>
              <Color>#ff3030</Color>
              <TextColor>#ff3030</TextColor>
              <Align>top</Align>
            </Mark>
            <Mark>
              <Control>hotcue_1_position</Control>
              <Text>A</Text>
              <Color>#f44040</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_2_position</Control>
              <Text>B</Text>
              <Color>#0ddcf2</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_3_position</Control>
              <Text>C</Text>
              <Color>#a5df13</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_4_position</Control>
              <Text>D</Text>
              <Color>#9d4cfd</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_5_position</Control>
              <Text>E</Text>
              <Color>#3fec2b</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_6_position</Control>
              <Text>F</Text>
              <Color>#e6681c</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_7_position</Control>
              <Text>G</Text>
              <Color>#2749c8</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>hotcue_8_position</Control>
              <Text>H</Text>
              <Color>#c7b205</Color>
              <TextColor>#000000</TextColor>
              <Align>bottom</Align>
            </Mark>
            <Mark>
              <Control>loop_start_position</Control>
              <Color>#f09c40</Color>
            </Mark>
            <Mark>
              <Control>loop_end_position</Control>
              <Color>#f09c40</Color>
            </Mark>
            <MarkRange>
              <StartControl>loop_start_position</StartControl>
              <EndControl>loop_end_position</EndControl>
              <EnabledControl>loop_enabled</EnabledControl>
              <Color>#f09c40</Color>
              <Opacity>0.5</Opacity>
              <DisabledColor>#acacac</DisabledColor>
              <DisabledOpacity>0.2</DisabledOpacity>
            </MarkRange>
            <MarkRange>
              <StartControl>intro_start_position</StartControl>
              <EndControl>intro_end_position</EndControl>
              <Color>#2e7d32</Color>
              <Opacity>0.35</Opacity>
            </MarkRange>
            <MarkRange>
              <StartControl>outro_start_position</StartControl>
              <EndControl>outro_end_position</EndControl>
              <Color>#2e7d32</Color>
              <Opacity>0.35</Opacity>
            </MarkRange>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel"/>],playposition</ConfigKey>
            </Connection>
          </Overview>
          <WidgetGroup><Size>6f,44f</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
