<Template>
    <WidgetGroup>
        <ObjectName>ShortcutPanel</ObjectName>
        <Size>0me,0me</Size>
        <Layout>vertical</Layout>
        <Children>

        <WidgetGroup>
          <ObjectName>ShortcutControls</ObjectName>
          <Layout>vertical</Layout>
          <Size>0me,0me</Size>
          <Children>

            <!-- DECKS and RECORDING side by side -->
            <WidgetGroup>
              <Layout>horizontal</Layout>
              <Size>0me,110f</Size>
              <Children>
                <WidgetGroup>
                  <ObjectName>ShortcutSectionDecks</ObjectName>
                  <Layout>vertical</Layout>
                  <Size>0me,110f</Size>
                  <Children>
                    <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                    <Label>
                      <ObjectName>ShortcutSectionTitle</ObjectName>
                      <Text>DECKS</Text>
                      <Size>me,22f</Size>
                    </Label>
                    <WidgetGroup>
                      <ObjectName>DecksModeButtons</ObjectName>
                      <Layout>horizontal</Layout>
                      <Size>me,65f</Size>
                      <Children>
                        <PushButton>
                          <ObjectName>DecksModeBtn</ObjectName>
                          <NumberStates>2</NumberStates>
                          <Size>me,55f</Size>
                          <State><Number>0</Number><Text>2 DECKS</Text></State>
                          <State><Number>1</Number><Text>2 DECKS</Text></State>
                          <Connection>
                            <ConfigKey>[Skin],show_4decks</ConfigKey>
                            <Transform><Not/></Transform>
                          </Connection>
                        </PushButton>
                        <WidgetGroup><Size>8f,55f</Size></WidgetGroup>
                        <PushButton>
                          <ObjectName>DecksModeBtn</ObjectName>
                          <NumberStates>2</NumberStates>
                          <Size>me,55f</Size>
                          <State><Number>0</Number><Text>4 DECKS</Text></State>
                          <State><Number>1</Number><Text>4 DECKS</Text></State>
                          <Connection>
                            <ConfigKey>[Skin],show_4decks</ConfigKey>
                          </Connection>
                        </PushButton>
                      </Children>
                    </WidgetGroup>
                    <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                  </Children>
                </WidgetGroup>

                <WidgetGroup><Size>16f,0me</Size></WidgetGroup>
                <WidgetGroup>
                  <ObjectName>ShortcutSectionRec</ObjectName>
                  <Layout>vertical</Layout>
                  <Size>0me,110f</Size>
                  <Children>
                    <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                    <Label>
                      <ObjectName>ShortcutSectionTitle</ObjectName>
                      <Text>RECORDING</Text>
                      <Size>me,22f</Size>
                    </Label>
                    <WidgetGroup>
                      <ObjectName>RecordingButtons</ObjectName>
                      <Layout>horizontal</Layout>
                      <Size>me,65f</Size>
                      <Children>
                        <PushButton>
                          <ObjectName>RecordingToggleBtn</ObjectName>
                          <NumberStates>4</NumberStates>
                          <Size>me,55f</Size>
                          <State><Number>0</Number><Text>START REC</Text></State>
                          <State><Number>1</Number><Text>STOP REC</Text></State>
                          <State><Number>2</Number><Text>STOP REC</Text></State>
                          <State><Number>3</Number><Text>STOP REC</Text></State>
                          <Connection>
                            <ConfigKey>[Recording],toggle_recording</ConfigKey>
                          </Connection>
                          <Connection>
                            <ConfigKey>[Recording],status</ConfigKey>
                            <ConnectValueFromWidget>false</ConnectValueFromWidget>
                          </Connection>
                        </PushButton>
                        <WidgetGroup><Size>8f,55f</Size></WidgetGroup>
                        <RecordingDuration>
                          <ObjectName>ShortcutRecDuration</ObjectName>
                          <Size>me,55f</Size>
                          <InactiveText>00:00:00</InactiveText>
                          <Alignment>center</Alignment>
                          <Connection>
                            <ConfigKey>[Recording],status</ConfigKey>
                            <BindProperty>highlight</BindProperty>
                          </Connection>
                        </RecordingDuration>
                      </Children>
                    </WidgetGroup>
                    <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                  </Children>
                </WidgetGroup>

              </Children>
            </WidgetGroup>

            <!-- Separator -->
            <WidgetGroup>
              <ObjectName>ShortcutColumnDivider</ObjectName>
              <Size>0me,1f</Size>
            </WidgetGroup>

            <!-- AUTO DJ REQUEST — learn the console button for REQUEST
                 ([Library],AutoDjAddRequest). LEARN lights up until a button
                 is pressed on a MIDI controller; that button then sends
                 requests only. Controls from build/mixxx/patches/0011. -->
            <WidgetGroup>
              <ObjectName>ShortcutSectionRequest</ObjectName>
              <Layout>vertical</Layout>
              <Size>0me,110f</Size>
              <Children>
                <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                <Label>
                  <ObjectName>ShortcutSectionTitle</ObjectName>
                  <Text>AUTO DJ REQUEST BUTTON</Text>
                  <Size>me,22f</Size>
                </Label>
                <WidgetGroup>
                  <ObjectName>RequestButtons</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>me,65f</Size>
                  <Children>
                    <PushButton>
                      <ObjectName>RequestLearnBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>LEARN</Text></State>
                      <State><Number>1</Number><Text>PRESS A CONSOLE BUTTON</Text></State>
                      <Connection>
                        <ConfigKey>[AutoDJ],request_learn</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>8f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>RequestLearnedBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>NOT SET</Text></State>
                      <State><Number>1</Number><Text>SET</Text></State>
                      <Connection>
                        <ConfigKey>[AutoDJ],request_learned</ConfigKey>
                        <ConnectValueFromWidget>false</ConnectValueFromWidget>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>8f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>RequestClearBtn</ObjectName>
                      <NumberStates>1</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>CLEAR</Text></State>
                      <Connection>
                        <ConfigKey>[AutoDJ],request_learn_clear</ConfigKey>
                        <ButtonState>LeftButton</ButtonState>
                      </Connection>
                    </PushButton>
                  </Children>
                </WidgetGroup>
                <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
              </Children>
            </WidgetGroup>

            <!-- Separator -->
            <WidgetGroup>
              <ObjectName>ShortcutColumnDivider</ObjectName>
              <Size>0me,1f</Size>
            </WidgetGroup>

            <!-- AUTO DJ TRANSITIONS (mixxx/controllers/DecksmithOS-AutoDJ.js):
                 SMART chooses among the allowed transitions those that suit
                 the two tracks (tempo, key), RANDOM any allowed one that is
                 safe; PHRASE starts transitions on phrase starts
                 ([AutoDJ],phrase_align, Mixxx patch 0021). Each transition
                 can be allowed or not ([Skin],dsm_adj_use_<name>, kept in
                 mixxx.cfg by skin.xml). -->
            <WidgetGroup>
              <ObjectName>ShortcutSectionTransitions</ObjectName>
              <Layout>vertical</Layout>
              <Size>0me,110f</Size>
              <Children>
                <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                <Label>
                  <ObjectName>ShortcutSectionTitle</ObjectName>
                  <Text>AUTO DJ TRANSITIONS</Text>
                  <Size>me,22f</Size>
                </Label>
                <WidgetGroup>
                  <Layout>horizontal</Layout>
                  <Size>me,65f</Size>
                  <Children>
                    <PushButton>
                      <ObjectName>AdjModeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>SMART</Text></State>
                      <State><Number>1</Number><Text>RANDOM</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_mode</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>PHRASE</Text></State>
                      <State><Number>1</Number><Text>PHRASE</Text></State>
                      <Connection>
                        <ConfigKey>[AutoDJ],phrase_align</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>14f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>BLEND</Text></State>
                      <State><Number>1</Number><Text>BLEND</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_blend</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>FILTER</Text></State>
                      <State><Number>1</Number><Text>FILTER</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_filter</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>ECHO</Text></State>
                      <State><Number>1</Number><Text>ECHO</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_echo</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>FADE</Text></State>
                      <State><Number>1</Number><Text>FADE</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_fade</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>LOOP</Text></State>
                      <State><Number>1</Number><Text>LOOP</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_loop</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>RISER</Text></State>
                      <State><Number>1</Number><Text>RISER</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_riser</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>REVERB</Text></State>
                      <State><Number>1</Number><Text>REVERB</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_reverb</ConfigKey>
                      </Connection>
                    </PushButton>
                    <WidgetGroup><Size>6f,55f</Size></WidgetGroup>
                    <PushButton>
                      <ObjectName>AdjTypeBtn</ObjectName>
                      <NumberStates>2</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>BRAKE</Text></State>
                      <State><Number>1</Number><Text>BRAKE</Text></State>
                      <Connection>
                        <ConfigKey>[Skin],dsm_adj_use_brake</ConfigKey>
                      </Connection>
                    </PushButton>
                  </Children>
                </WidgetGroup>
                <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
              </Children>
            </WidgetGroup>

            <!-- Separator -->
            <WidgetGroup>
              <ObjectName>ShortcutColumnDivider</ObjectName>
              <Size>0me,1f</Size>
            </WidgetGroup>

            <!-- MIXXX — the preferences dialog (sound, controllers, library,
                 skin...). [Controls],show_preferences is added by the DecksmithOS
                 Mixxx package (build/mixxx/patches/0001, ronso0's commit). -->
            <WidgetGroup>
              <ObjectName>ShortcutSectionSettings</ObjectName>
              <Layout>vertical</Layout>
              <Size>0me,110f</Size>
              <Children>
                <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
                <Label>
                  <ObjectName>ShortcutSectionTitle</ObjectName>
                  <Text>MIXXX</Text>
                  <Size>me,22f</Size>
                </Label>
                <WidgetGroup>
                  <ObjectName>SettingsButtons</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>me,65f</Size>
                  <Children>
                    <PushButton>
                      <ObjectName>MixxxSettingsBtn</ObjectName>
                      <!-- One state: a momentary button (1 while pressed). -->
                      <NumberStates>1</NumberStates>
                      <Size>me,55f</Size>
                      <State><Number>0</Number><Text>SETTINGS</Text></State>
                      <Connection>
                        <ConfigKey>[Controls],show_preferences</ConfigKey>
                        <ButtonState>LeftButton</ButtonState>
                      </Connection>
                    </PushButton>
                  </Children>
                </WidgetGroup>
                <WidgetGroup><Size>0me,0me</Size></WidgetGroup>
              </Children>
            </WidgetGroup>

          </Children>
        </WidgetGroup>

        <!-- Mini decks at the bottom -->
        <Template src="skin:libdecks.xml"/>

        </Children>
    </WidgetGroup>
</Template>
