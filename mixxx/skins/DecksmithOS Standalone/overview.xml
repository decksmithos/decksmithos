<Template>
  <!-- Main page, laid out after the standalone-player reference (1280x720,
       text at ~85 % of its physical size, see README):
         top:    deck info sidebar | big waveforms | BEAT FX panel
         middle: pad row (HOT CUE grid per deck), 2-deck mode only
         bottom: per-deck info, full width (decks 3/4 in a second row in
                 4-deck mode) -->
  <WidgetGroup>
    <ObjectName>Overview</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,0me</Size>
    <Children>

      <WidgetGroup>
        <ObjectName>OverviewTop</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,0me</Size>
        <Children>

          <!-- LEFT SIDEBAR: deck info, order 3, 1, 2, 4 like the waveforms -->
          <WidgetGroup>
            <ObjectName>Sidebar</ObjectName>
            <Layout>vertical</Layout>
            <Size>140f,0me</Size>
            <Children>
              <WidgetGroup>
                <Layout>vertical</Layout>
                <Size>140f,0me</Size>
                <Children>
                  <Template src="skin:sidebar_deck_info.xml">
                    <SetVariable name="channel">3</SetVariable>
                  </Template>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],show_4decks</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
              <Template src="skin:sidebar_deck_info.xml">
                <SetVariable name="channel">1</SetVariable>
              </Template>
              <Template src="skin:sidebar_deck_info.xml">
                <SetVariable name="channel">2</SetVariable>
              </Template>
              <WidgetGroup>
                <Layout>vertical</Layout>
                <Size>140f,0me</Size>
                <Children>
                  <Template src="skin:sidebar_deck_info.xml">
                    <SetVariable name="channel">4</SetVariable>
                  </Template>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],show_4decks</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>Waveforms_Container</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,0me</Size>
            <Children>
              <Template src="skin:waveforms.xml"></Template>
            </Children>
          </WidgetGroup>

          <Template src="skin:effects.xml"></Template>

        </Children>
      </WidgetGroup>

      <!-- PAD ROW, 2-deck mode only. Page chosen with the buttons under the
           BEAT FX panel: HOT CUE (A-H per deck), BEAT FX (effect select and
           X-PAD), RELEASE FX (per deck). -->
      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,80f</Size>
        <Children>
          <WidgetStack currentpage="[Skin],dsm_padmode" persist="true">
            <Children>
              <WidgetGroup trigger="[Skin],dsm_pad_hotcue">
                <Layout>horizontal</Layout>
                <Size>0me,80f</Size>
                <Children>
                  <Template src="skin:pads_hotcue.xml">
                    <SetVariable name="channel">1</SetVariable>
                  </Template>
                  <WidgetGroup><Size>12f,80f</Size></WidgetGroup>
                  <Template src="skin:pads_hotcue.xml">
                    <SetVariable name="channel">2</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup trigger="[Skin],dsm_pad_beatfx">
                <Layout>horizontal</Layout>
                <Size>0me,80f</Size>
                <Children>
                  <Template src="skin:pads_beatfx.xml"/>
                </Children>
              </WidgetGroup>
              <WidgetGroup trigger="[Skin],dsm_pad_release">
                <Layout>horizontal</Layout>
                <Size>0me,80f</Size>
                <Children>
                  <Template src="skin:pads_release.xml">
                    <SetVariable name="channel">1</SetVariable>
                  </Template>
                  <WidgetGroup><Size>12f,80f</Size></WidgetGroup>
                  <Template src="skin:pads_release.xml">
                    <SetVariable name="channel">2</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetStack>
        </Children>
        <Connection>
          <ConfigKey>[Skin],show_4decks</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform><Not/></Transform>
        </Connection>
      </WidgetGroup>

      <!-- DECK INFO, full width -->
      <WidgetGroup>
        <ObjectName>DecksGrid</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,0max</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>Decks</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,152f</Size>
            <Children>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">1</SetVariable>
              </Template>
              <WidgetGroup><Size>12f,152f</Size></WidgetGroup>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">2</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>Decks34</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,152f</Size>
            <Children>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">3</SetVariable>
              </Template>
              <WidgetGroup><Size>12f,152f</Size></WidgetGroup>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">4</SetVariable>
              </Template>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_4decks</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
