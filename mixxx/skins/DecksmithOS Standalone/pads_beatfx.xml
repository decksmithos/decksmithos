<!-- BEAT FX pads (80 px tall, full width): the 3 effects of the BEAT FX
     unit ([EffectRack1_EffectUnit1], tap = on/off; the label shows the
     effect, choose it in the BEAT FX panel) and the X-PAD: hold a beat value
     to play the BEAT FX at that length (skin bridge). -->
<Template>
  <WidgetGroup>
    <ObjectName>PadGroup</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,80f</Size>
    <Children>
      <WidgetGroup>
        <Layout>vertical</Layout>
        <Size>0me,80f</Size>
        <Children>
          <Label>
            <ObjectName>PadGroupTitle</ObjectName>
            <Size>0me,16f</Size>
            <Text>BEAT FX SELECT</Text>
            <Alignment>center</Alignment>
          </Label>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>0me,64f</Size>
        <Children>
          <WidgetGroup>
            <Layout>stacked</Layout>
            <Size>0me,64f</Size>
            <Children>
              <EffectName>
                <ObjectName>PadFxSlotName</ObjectName>
                <Size>0me,64f</Size>
                <EffectRack>1</EffectRack>
                <EffectUnit>1</EffectUnit>
                <Effect>1</Effect>
                <Alignment>center</Alignment>
                <Elide>right</Elide>
              </EffectName>
              <PushButton>
                <ObjectName>PadFxSlot</ObjectName>
                <Size>0me,64f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text></Text></State>
                <State><Number>1</Number><Text></Text></State>
                <Connection><ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey></Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>4f,64f</Size></WidgetGroup>
