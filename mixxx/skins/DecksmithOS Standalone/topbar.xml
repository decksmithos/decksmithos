<!-- Top bar: the touch navigation row (standalone players have these as
     hardware buttons above the screen) on the left, recording status, clock
     and master level on the right. 48 px tall.

     Navigation:
       BROWSE    library page ([Skin],show_maximized_library); BACK there
       SEARCH    library page, focus on the search box     } skin bridge
       SOURCE / PLAYLIST / TAG LIST  library page, sidebar } (mixxx/controllers/
                                                           DecksmithOS-SkinBridge.js)
       MENU      skin settings page ([Tab],shortcut) -->
<Template>
  <WidgetGroup>
    <ObjectName>Topbar</ObjectName>
    <Layout>horizontal</Layout>
    <Size>100me,48f</Size>
    <Children>

      <WidgetGroup><Size>6f,48f</Size></WidgetGroup>

      <Template src="skin:topnav_button.xml">
        <SetVariable name="label">SOURCE</SetVariable>
        <SetVariable name="key">[Skin],dsm_nav_source</SetVariable>
        <SetVariable name="objname">TopNavBtnPlain</SetVariable>
        <SetVariable name="push">true</SetVariable>
      </Template>

      <!-- BROWSE on the main page, BACK on the library page -->
      <WidgetGroup>
        <Layout>stacked</Layout>
        <Size>116f,48f</Size>
        <Children>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>116f,48f</Size>
            <Children>
              <PushButton>
                <ObjectName>TopNavBtn</ObjectName>
                <Size>110f,38f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>BROWSE</Text></State>
                <State><Number>1</Number><Text>BROWSE</Text></State>
                <Connection>
                  <ConfigKey>[Skin],show_maximized_library</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_maximized_library</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform><Not/></Transform>
            </Connection>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>116f,48f</Size>
            <Children>
              <PushButton>
                <ObjectName>TopNavBtnBack</ObjectName>
                <Size>110f,38f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>BACK</Text></State>
                <State><Number>1</Number><Text>BACK</Text></State>
                <Connection>
                  <ConfigKey>[Tab],overview</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_maximized_library</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <Template src="skin:topnav_button.xml">
        <SetVariable name="label">TAG LIST</SetVariable>
        <SetVariable name="key">[Skin],dsm_nav_taglist</SetVariable>
        <SetVariable name="objname">TopNavBtnPlain</SetVariable>
        <SetVariable name="push">true</SetVariable>
      </Template>
      <Template src="skin:topnav_button.xml">
        <SetVariable name="label">PLAYLIST</SetVariable>
        <SetVariable name="key">[Skin],dsm_nav_playlist</SetVariable>
        <SetVariable name="objname">TopNavBtnPlain</SetVariable>
        <SetVariable name="push">true</SetVariable>
      </Template>
      <Template src="skin:topnav_button.xml">
        <SetVariable name="label">SEARCH</SetVariable>
        <SetVariable name="key">[Skin],dsm_nav_search</SetVariable>
        <SetVariable name="objname">TopNavBtnPlain</SetVariable>
        <SetVariable name="push">true</SetVariable>
      </Template>
      <Template src="skin:topnav_button.xml">
        <SetVariable name="label">MENU</SetVariable>
        <SetVariable name="key">[Tab],shortcut</SetVariable>
        <SetVariable name="objname">TopNavBtn</SetVariable>
        <SetVariable name="push">false</SetVariable>
      </Template>

      <WidgetGroup><Size>0me,48f</Size></WidgetGroup>

      <!-- Master output level, L and R -->
      <WidgetGroup>
        <ObjectName>TopbarMasterVuWrapper</ObjectName>
        <Layout>vertical</Layout>
        <Size>90f,48f</Size>
        <Children>
          <WidgetGroup><Size>90f,0me</Size></WidgetGroup>
          <VuMeter>
            <ObjectName>TopbarMasterVuL</ObjectName>
            <Size>90f,6f</Size>
            <PathBack scalemode="STRETCH">icons/effect_meter_bg.png</PathBack>
            <PathVu scalemode="STRETCH">icons/master_vu_fg.png</PathVu>
            <Horizontal>true</Horizontal>
            <PeakHoldSize>5</PeakHoldSize>
            <PeakHoldTime>300</PeakHoldTime>
            <PeakFallTime>20</PeakFallTime>
            <PeakFallStep>1</PeakFallStep>
            <Connection><ConfigKey>[Main],vu_meter_left</ConfigKey></Connection>
          </VuMeter>
          <WidgetGroup><Size>90f,2f</Size></WidgetGroup>
          <VuMeter>
            <ObjectName>TopbarMasterVuR</ObjectName>
            <Size>90f,6f</Size>
            <PathBack scalemode="STRETCH">icons/effect_meter_bg.png</PathBack>
            <PathVu scalemode="STRETCH">icons/master_vu_fg.png</PathVu>
            <Horizontal>true</Horizontal>
            <PeakHoldSize>5</PeakHoldSize>
            <PeakHoldTime>300</PeakHoldTime>
            <PeakFallTime>20</PeakFallTime>
            <PeakFallStep>1</PeakFallStep>
            <Connection><ConfigKey>[Main],vu_meter_right</ConfigKey></Connection>
          </VuMeter>
          <WidgetGroup><Size>90f,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>18f,48f</Size></WidgetGroup>

      <!-- Recording: dot (grey idle, red recording) and duration -->
      <Label>
        <ObjectName>TopbarRecCircle</ObjectName>
        <Size>16f,48f</Size>
        <Text>&#9679;</Text>
        <Connection>
          <ConfigKey>[Recording],status</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </Label>
      <RecordingDuration>
        <ObjectName>TopbarRecDuration</ObjectName>
        <Size>92f,48f</Size>
        <InactiveText>00:00:00</InactiveText>
        <Alignment>left</Alignment>
        <Connection>
          <ConfigKey>[Recording],status</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </RecordingDuration>

      <WidgetGroup><Size>10f,48f</Size></WidgetGroup>

      <Time>
        <ObjectName>TopbarClock</ObjectName>
        <TooltipId>time</TooltipId>
        <Size>70f,48f</Size>
        <Alignment>center</Alignment>
      </Time>

      <WidgetGroup><Size>8f,48f</Size></WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
