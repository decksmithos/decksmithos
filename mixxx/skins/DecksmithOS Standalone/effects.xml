<!-- BEAT FX panel (right of the waveforms, 176 px wide): one effect slot,
     [EffectRack1_EffectUnit1_Effect1], laid out after the standalone-player
     reference: effect name, CH SELECT, tempo / beat readout, on/off, and the
     waveform zoom. -->
<Template>
  <WidgetGroup>
    <ObjectName>BeatFX_Container</ObjectName>
    <Layout>vertical</Layout>
    <Size>176f,0me</Size>
    <Children>
      <WidgetGroup><Size>176f,4f</Size></WidgetGroup>
      <WidgetGroup>
        <ObjectName>BeatFX_Box</ObjectName>
        <Layout>vertical</Layout>
        <Size>168f,0me</Size>
        <Children>
          <Label>
            <ObjectName>BeatFX_Title</ObjectName>
            <Size>0me,24f</Size>
            <Text>BEAT FX</Text>
            <Alignment>center</Alignment>
          </Label>

          <EffectSelector>
            <ObjectName>BeatFX_Name</ObjectName>
            <EffectRack>1</EffectRack>
            <EffectUnit>1</EffectUnit>
            <Effect>1</Effect>
            <Elide>right</Elide>
            <Size>156f,42f</Size>
          </EffectSelector>

          <Label>
            <ObjectName>BeatFX_SmallLabel</ObjectName>
            <Size>0me,20f</Size>
            <Text>CH SELECT</Text>
            <Alignment>center</Alignment>
          </Label>
          <WidgetGroup>
            <ObjectName>BeatFX_ChRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,36f</Size>
            <Children>
              <PushButton>
                <ObjectName>BeatFX_Ch</ObjectName>
                <Size>40f,34f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>1</Text></State>
                <State><Number>1</Number><Text>1</Text></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>4f,34f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>BeatFX_Ch</ObjectName>
                <Size>40f,34f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>2</Text></State>
                <State><Number>1</Number><Text>2</Text></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>4f,34f</Size></WidgetGroup>
              <!-- MASTER: the main mix ([EffectRack1_EffectUnit1] on the main output) -->
              <PushButton>
                <ObjectName>BeatFX_ChMaster</ObjectName>
                <Size>60f,34f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>MASTER</Text></State>
                <State><Number>1</Number><Text>MASTER</Text></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Master]_enable</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>BeatFX_ChRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,36f</Size>
            <Children>
              <PushButton>
                <ObjectName>BeatFX_Ch</ObjectName>
                <Size>40f,34f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>3</Text></State>
                <State><Number>1</Number><Text>3</Text></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel3]_enable</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>4f,34f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>BeatFX_Ch</ObjectName>
                <Size>40f,34f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>4</Text></State>
                <State><Number>1</Number><Text>4</Text></State>
                <Connection>
                  <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel4]_enable</ConfigKey>
                </Connection>
              </PushButton>
              <WidgetGroup><Size>64f,34f</Size></WidgetGroup>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_4decks</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

          <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

          <!-- Tempo / beat readout -->
          <WidgetGroup>
            <ObjectName>BeatFX_Readout</ObjectName>
            <Layout>vertical</Layout>
            <Size>0me,100f</Size>
            <Children>
              <Number>
                <ObjectName>BeatFX_Bpm</ObjectName>
                <Size>0me,40f</Size>
                <Text>%1</Text>
                <NumberOfDigits>1</NumberOfDigits>
                <Alignment>right</Alignment>
                <Connection><ConfigKey>[InternalClock],bpm</ConfigKey></Connection>
              </Number>
              <Label>
                <ObjectName>BeatFX_Unit</ObjectName>
                <Size>0me,14f</Size>
                <Text>BPM</Text>
                <Alignment>right</Alignment>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,40f</Size>
                <Children>
                  <EffectParameterName>
                    <ObjectName>BeatFX_ParamName</ObjectName>
                    <Size>0me,40f</Size>
                    <EffectRack>1</EffectRack>
                    <EffectUnit>1</EffectUnit>
                    <Effect>1</Effect>
                    <EffectParameter>1</EffectParameter>
                    <Alignment>left</Alignment>
                    <Elide>right</Elide>
                  </EffectParameterName>
                  <BeatSpinBox>
                    <ObjectName>BeatFX_Beat</ObjectName>
                    <Size>78f,40f</Size>
                    <Value>[EffectRack1_EffectUnit1_Effect1],parameter1</Value>
                  </BeatSpinBox>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

          <PushButton>
            <ObjectName>BeatFX_OnOff</ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>FX OFF</Text></State>
            <State><Number>1</Number><Text>FX ON</Text></State>
            <Connection>
              <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>0me,0me</Size></WidgetGroup>

          <!-- Pad row page (2-deck mode) -->
          <WidgetGroup>
            <ObjectName>PadModeBox</ObjectName>
            <Layout>vertical</Layout>
            <Size>0me,118f</Size>
            <Children>
              <PushButton>
                <ObjectName>PadModeBtn</ObjectName>
                <Size>0me,36f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>HOT CUE</Text></State>
                <State><Number>1</Number><Text>HOT CUE</Text></State>
                <Connection><ConfigKey>[Skin],dsm_pad_hotcue</ConfigKey></Connection>
              </PushButton>
              <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>PadModeBtn</ObjectName>
                <Size>0me,36f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>BEAT FX</Text></State>
                <State><Number>1</Number><Text>BEAT FX</Text></State>
                <Connection><ConfigKey>[Skin],dsm_pad_beatfx</ConfigKey></Connection>
              </PushButton>
              <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
              <PushButton>
                <ObjectName>PadModeBtn</ObjectName>
                <Size>0me,36f</Size>
                <NumberStates>2</NumberStates>
                <State><Number>0</Number><Text>RELEASE FX</Text></State>
                <State><Number>1</Number><Text>RELEASE FX</Text></State>
                <Connection><ConfigKey>[Skin],dsm_pad_release</ConfigKey></Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_4decks</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform><Not/></Transform>
            </Connection>
          </WidgetGroup>
          <WidgetGroup><Size>0me,6f</Size></WidgetGroup>

          <!-- Waveform zoom, both decks -->
          <WidgetGroup>
            <ObjectName>ZoomRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,40f</Size>
            <Children>
              <PushButton>
                <ObjectName>ZoomBtn</ObjectName>
                <Size>48f,38f</Size>
                <NumberStates>2</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <State><Number>0</Number><Text>&#8722;</Text></State>
                <State><Number>1</Number><Text>&#8722;</Text></State>
                <Connection>
                  <ConfigKey>[Channel1],waveform_zoom_up</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[Channel2],waveform_zoom_up</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
              <Label>
                <ObjectName>ZoomLabel</ObjectName>
                <Size>0me,38f</Size>
                <Text>ZOOM</Text>
                <Alignment>center</Alignment>
              </Label>
              <PushButton>
                <ObjectName>ZoomBtn</ObjectName>
                <Size>48f,38f</Size>
                <NumberStates>2</NumberStates>
                <LeftClickIsPushButton>true</LeftClickIsPushButton>
                <State><Number>0</Number><Text>+</Text></State>
                <State><Number>1</Number><Text>+</Text></State>
                <Connection>
                  <ConfigKey>[Channel1],waveform_zoom_down</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
                <Connection>
                  <ConfigKey>[Channel2],waveform_zoom_down</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>0me,4f</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
