<!-- One top-bar navigation button (110 x 38 in a 116 x 48 cell).
     Variables: label, key (the control the button pushes or toggles), push
     (true: momentary, for the skin bridge's [Skin],dsm_* controls), objname
     (TopNavBtn: lights up while `lit` is on), lit (the control that lights
     it; the skin bridge sets [Skin],dsm_lit_<name> for the active section;
     for a plain toggle use the same control as key). -->
<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <Size>116f,48f</Size>
    <Children>
      <PushButton>
        <ObjectName><Variable name="objname"/></ObjectName>
        <Size>110f,38f</Size>
        <NumberStates>2</NumberStates>
        <LeftClickIsPushButton><Variable name="push"/></LeftClickIsPushButton>
        <State><Number>0</Number><Text><Variable name="label"/></Text></State>
        <State><Number>1</Number><Text><Variable name="label"/></Text></State>
        <Connection>
          <ConfigKey><Variable name="key"/></ConfigKey>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="lit"/></ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>
    </Children>
  </WidgetGroup>
</Template>
