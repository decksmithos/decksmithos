# systemd user service: the Claude Code session that works on DecksmithOS,
# in a tmux session of the user claude on its own tmux server (socket
# "decksmithos"), started at boot (loginctl enable-linger claude). Attach with:
#   tmux -L decksmithos attach -t decksmithos     (as claude; Ctrl-b d to leave)
# or through Remote Control (session "decksmithos" on claude.ai/code).
# Claude resumes the conversation named "decksmithos" (name it once with
# /rename decksmithos); without one it starts a new conversation with that
# name. Restarted when it fails.
[Unit]
Description=Claude Code session for DecksmithOS

[Service]
Type=forking
WorkingDirectory=/shared/decksmithos
ExecStart=/usr/bin/tmux -L decksmithos new-session -d -s decksmithos -c /shared/decksmithos -- bash -lc 'claude --resume decksmithos --remote-control decksmithos || exec claude --name decksmithos --remote-control decksmithos'
ExecStop=/usr/bin/tmux -L decksmithos kill-session -t decksmithos
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
